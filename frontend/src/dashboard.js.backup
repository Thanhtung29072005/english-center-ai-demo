// Hàm tải trang bên cạnh loadPage cho phép chạy js khi load xong html
async function loadDashboardContent(pageName, initCallback) {
    const contentArea = document.getElementById('content-area') ||
        document.querySelector('.dashboard-wrap .main-content');

    if (!contentArea) return;

    try {
        contentArea.innerHTML = "<p style='padding: 20px;'>Đang tải dữ liệu...</p>";
        const response = await fetch(`/pages/${pageName}.html`);
        const html = await response.text();
        contentArea.innerHTML = html;
        if (typeof initCallback === 'function') initCallback();
    } catch (err) {
        console.error(`Lỗi tải trang ${pageName}:`, err);
        contentArea.innerHTML = "<p style='color: red;'>Không thể tải nội dung.</p>";
    }
}

// Hiển thị màn hình từ chối truy cập
function showAccessDenied(container) {
    if (!container) return;
    container.innerHTML = `
        <div style="
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            min-height: 400px;
            gap: 16px;
            padding: 40px;
            text-align: center;
        ">
            <div style="
                width: 80px;
                height: 80px;
                background: linear-gradient(135deg, #f3e8ff, #ede9fe);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 8px;
            ">
                <i class="fa-solid fa-lock" style="font-size: 32px; color: #7c3aed;"></i>
            </div>
            <h2 style="
                font-size: 22px;
                font-weight: 700;
                color: #1e293b;
                margin: 0;
            ">Không có quyền truy cập</h2>
            <p style="
                font-size: 14px;
                color: #64748b;
                margin: 0;
                max-width: 320px;
            ">Bạn không có quyền truy cập trang này. Vui lòng liên hệ quản trị viên nếu cần hỗ trợ.</p>
            <button onclick="history.back()" style="
                margin-top: 8px;
                padding: 10px 28px;
                background: #7c3aed;
                color: #fff;
                border: none;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                transition: background 0.2s;
            " onmouseover="this.style.background='#6d28d9'" onmouseout="this.style.background='#7c3aed'">
                Quay lại
            </button>
        </div>
    `;
}

// ngay khi load xong giao diện dashboard
document.addEventListener('DOMContentLoaded', () => {
    // --- Hiển thị thông tin user ---
    const savedUsername = localStorage.getItem('username');
    const savedRole = localStorage.getItem('userRole');
    if (savedUsername) {
        const usernameEl = document.getElementById('header-username');
        if (usernameEl) usernameEl.textContent = savedUsername;
    }
    if (savedRole) {
        const roleEl = document.getElementById('header-role');
        if (roleEl) {
            const roleMap = {
                'OWNER': 'Chủ trung tâm',
                'BRANCH_MANAGER': 'Quản lý chi nhánh',
                'TEACHER': 'Giáo viên',
                'PARENT': 'Phụ huynh',
                'ADMIN': 'Quản trị viên'
            };
            roleEl.textContent = roleMap[savedRole.toUpperCase()] || savedRole;
        }
    }

    // --- Lớp 1: Ẩn nav item bị cấm theo role ---
    const currentRole = (localStorage.getItem('userRole') || '').toUpperCase();
    if (currentRole === 'TEACHER') {
        // TEACHER không được truy cập: Người dùng, Chi nhánh, Giáo viên, Duyệt học viên, Lợi nhuận
        ['user', 'branch', 'teacher', 'enrollment-request', 'revenue'].forEach(page => {
            const navItem = document.querySelector(`.sidebar .nav-item[data-page="${page}"]`);
            if (navItem) navItem.style.display = 'none';
        });
    }

    if (currentRole === 'PARENT') {
        // PARENT không thấy toàn bộ mục "Quản lý" (dropdown + các sub-item)
        const manageBtn = document.querySelector('.sidebar .nav-item.has-dropdown');
        if (manageBtn) manageBtn.style.display = 'none';
        const manageDropdown = document.getElementById('manage-dropdown-content');
        if (manageDropdown) manageDropdown.style.display = 'none';

        // Hiện nút Khóa học đã đăng ký
        const parentEnrollBtn = document.getElementById('nav-parent-enrollment');
        if (parentEnrollBtn) parentEnrollBtn.style.display = 'flex';

        // Đánh dấu body để CSS ẩn tất cả nút thêm/sửa/xóa
        document.body.classList.add('parent-readonly');
    }

    // Chỉ OWNER và BRANCH_MANAGER mới thấy mục Lợi Nhuận
    const navRevenue = document.getElementById('nav-revenue');
    if (navRevenue) {
        const canSeeRevenue = ['OWNER', 'BRANCH_MANAGER', 'ADMIN'].includes(currentRole);
        if (!canSeeRevenue) navRevenue.style.display = 'none';
    }

    // --- Dropdown toggle ---
    const userBtn = document.getElementById('user-header-btn');
    const dropdown = document.getElementById('user-header-dropdown');
    const caret = document.getElementById('user-caret');

    if (userBtn && dropdown) {
        userBtn.addEventListener('click', (e) => {
            // Ngăn click vào item bên trong bubble lên đây
            if (e.target.closest('#user-header-dropdown')) return;
            const isOpen = dropdown.classList.toggle('show');
            if (caret) caret.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
        });

        // Đóng khi click ra ngoài
        document.addEventListener('click', (e) => {
            if (!userBtn.contains(e.target)) {
                dropdown.classList.remove('show');
                if (caret) caret.style.transform = 'rotate(0deg)';
            }
        });
    }

    // --- Đăng xuất ---
    const btnLogout = document.getElementById('btn-logout');
    if (btnLogout) {
        btnLogout.addEventListener('click', () => {
            localStorage.removeItem('accessToken');
            localStorage.removeItem('username');
            localStorage.removeItem('userRole');
            localStorage.removeItem('userId');
            window.location.href = '/index.html';
        });
    }

    // --- Thông tin cá nhân ---
    const btnProfile = document.getElementById('btn-profile');
    if (btnProfile) {
        btnProfile.addEventListener('click', () => {
            dropdown.classList.remove('show');
            if (caret) caret.style.transform = 'rotate(0deg)';
            // Điều hướng tới trang profile
            loadDashboardContent('profile', initProfilePage);
            // Bỏ active tất cả nav items
            document.querySelectorAll('.dashboard-wrap .sidebar .nav-item').forEach(i => i.classList.remove('active'));
        });
    }

    // --- Đổi mật khẩu ---
    const btnChangePwd = document.getElementById('btn-change-password');
    if (btnChangePwd) {
        btnChangePwd.addEventListener('click', () => {
            dropdown.classList.remove('show');
            if (caret) caret.style.transform = 'rotate(0deg)';
            document.querySelectorAll('.dashboard-wrap .sidebar .nav-item').forEach(i => i.classList.remove('active'));
            loadDashboardContent('change-password', initChangePasswordPage);
        });
    }

    // --- Cài đặt ---
    const btnSettings = document.getElementById('btn-settings');
    if (btnSettings) {
        btnSettings.addEventListener('click', () => {
            dropdown.classList.remove('show');
            if (caret) caret.style.transform = 'rotate(0deg)';
            alert('Tính năng cài đặt đang được phát triển.');
        });
    }
})
document.addEventListener("DOMContentLoaded", () => {
    const navItems = document.querySelectorAll(".dashboard-wrap .sidebar .nav-item");
    const contentArea = document.querySelector(".dashboard-wrap .main-content");
    // Định nghĩa quyền truy cập: page nào chỉ cho phép role nào
    const PAGE_PERMISSIONS = {
        'user':    ['ADMIN', 'OWNER', 'BRANCH_MANAGER'],
        'branch':  ['ADMIN', 'OWNER', 'BRANCH_MANAGER'],
        'teacher': ['ADMIN', 'OWNER', 'BRANCH_MANAGER'],
        'enrollment-request': ['ADMIN', 'OWNER', 'BRANCH_MANAGER'],
        'parent-enrollment': ['PARENT'],
        'revenue': ['ADMIN', 'OWNER', 'BRANCH_MANAGER']
        // Các page khác không giới hạn role
    };

    async function loadPage(pageName) {
        // --- Lớp 2: Guard kiểm tra quyền trước khi load trang ---
        const role = (localStorage.getItem('userRole') || '').toUpperCase();
        const allowedRoles = PAGE_PERMISSIONS[pageName];
        if (allowedRoles && !allowedRoles.includes(role)) {
            showAccessDenied(contentArea);
            return;
        }

        try {
            // Tạm thời hiển thị chữ Đang tải
            contentArea.innerHTML = "<p style='padding: 20px;'>Đang tải dữ liệu...</p>";

            // Gọi tới thư mục pages để lấy file html tương ứng
            const response = await fetch(`/pages/${pageName}.html`);

            // Nếu lấy thành công, bóc tách ra thành chữ viết (HTML)
            const html = await response.text();

            // Nhồi đống HTML đó vào trong khu vực trống
            contentArea.innerHTML = html;

            if (pageName === 'dashboard-home') {
                fetchDashboardStats();
            } else if (pageName === 'class') {
                initClassPage();
            } else if (pageName === 'class-detail') {
                initClassDetailPage();
            } else if (pageName === 'lesson') {
                initLessonPage();
            } else if (pageName === 'review') {
                initReviewPage();
            } else if (pageName === 'exam') {
                initExamPage();
            } else if (pageName === 'user') {
                initUserPage();
            } else if (pageName === 'parent') {
                initParentPage();
            } else if (pageName === 'student') {
                initStudentPage();
            } else if (pageName === 'branch') {
                initBranchPage();
            } else if (pageName === 'teacher') {
                initTeacherPage();
            } else if (pageName === 'profile') {
                initProfilePage();
            } else if (pageName === 'change-password') {
                initChangePasswordPage();
            } else if (pageName === 'enrollment-request') {
                initEnrollmentRequestPage();
            } else if (pageName === 'parent-enrollment') {
                initParentEnrollmentPage();
            } else if (pageName === 'revenue') {
                initRevenuePage();
            }
        } catch (error) {
            console.error("Lỗi khi nạp trang:", error);
            contentArea.innerHTML = "<p style='color: red;'>Không thể tải nội dung.</p>";
        }
    }
    navItems.forEach(item => {
        item.addEventListener('click', function (e) {
            const isDropdownTrigger = this.classList.contains('has-dropdown');
            const isSubItem = this.closest('.dropdown-container') !== null;

            if (isDropdownTrigger) {
                // Trường hợp 1: Click vào "Quản lý" (Nút có thả xuống)
                navItems.forEach(nav => nav.classList.remove('active'));
                this.classList.add('active'); // Giữ active ở nút Quản lý

                this.classList.toggle('dropdown-open');
                const dropdownContent = this.nextElementSibling;
                if (dropdownContent && dropdownContent.classList.contains('dropdown-container')) {
                    dropdownContent.classList.toggle('show');
                }

                // Nếu bạn có set data-page cho nút Quản lý thì nó vẫn chạy
                const targetPage = this.getAttribute('data-page');
                if (targetPage) loadPage(targetPage);

            } else if (isSubItem) {
                // Trường hợp 2: Click vào 1 nút bên trong menu thả xuống (Người dùng, Học sinh, ...)
                const targetPage = this.getAttribute('data-page');
                if (targetPage) loadPage(targetPage);

                // Thu dropdown vào
                const dropdownContent = this.closest('.dropdown-container');
                if (dropdownContent) {
                    dropdownContent.classList.remove('show');
                    const trigger = dropdownContent.previousElementSibling;
                    if (trigger && trigger.classList.contains('has-dropdown')) {
                        trigger.classList.remove('dropdown-open');
                        // Đảm bảo active vẫn ở nút Quản lý
                        navItems.forEach(nav => nav.classList.remove('active'));
                        trigger.classList.add('active');
                    }
                }

                // (Tuỳ chọn) Nếu bạn muốn nút con cũng đổi màu một chút thì add class:
                // this.classList.add('active-sub'); // (Bạn có thể bỏ qua dòng này)

            } else {
                // Trường hợp 3: Click vào các trang bình thường (Dashboard, Lớp học, ...)
                navItems.forEach(nav => nav.classList.remove('active'));
                this.classList.add('active');

                // Tự động đóng dropdown nếu nó đang mở
                const openDropdowns = document.querySelectorAll('.dropdown-container.show');
                openDropdowns.forEach(dropdown => {
                    dropdown.classList.remove('show');
                    const trigger = dropdown.previousElementSibling;
                    if (trigger && trigger.classList.contains('has-dropdown')) {
                        trigger.classList.remove('dropdown-open');
                    }
                });

                const targetPage = this.getAttribute('data-page');
                if (targetPage) loadPage(targetPage);
            }
        });
    });
    // Gọi hàm nạp trang ở lần tải giao diện đầu tiên
    loadPage('dashboard-home');

})

// Dashboard Home
let dashboardStudentChart = null;
let dashboardClassBranchChart = null;

async function fetchDashboardStats() {
    const token = localStorage.getItem('accessToken');
    if (!token) return;

    const headers = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
    };

    try {
        // 1. Lấy độ dài mảng các lớp học
        const resClass = await fetch('/api/classes', { headers });
        if (resClass.ok) {
            const data = await resClass.json();
            const classes = normalizeApiList(data);
            document.getElementById('stat-class').textContent = classes.length;
            renderClassByBranchChart(classes);
        }

        // 2. Chi nhánh
        const resBranch = await fetch('/api/branches', { headers });
        if (resBranch.ok) {
            const data = await resBranch.json();
            const branchCount = Array.isArray(data) ? data.length : (data.result ? data.result.length : 0);
            document.getElementById('stat-branch').textContent = branchCount;
        }

        // 3. Học sinh
        const resStudent = await fetch('/api/students', { headers });
        if (resStudent.ok) {
            const data = await resStudent.json();
            const students = normalizeApiList(data);
            document.getElementById('stat-student').textContent = students.length;
            renderStudentMonthlyChart(students);
        }

        // 4. Giáo viên
        const resTeacher = await fetch('/api/teachers', { headers });
        if (resTeacher.ok) {
            const data = await resTeacher.json();
            const teacherCount = Array.isArray(data) ? data.length : (data.result ? data.result.length : 0);
            document.getElementById('stat-teacher').textContent = teacherCount;
        }

        // 5. Buổi học
        const resLesson = await fetch('/api/lessons', { headers });
        if (resLesson.ok) {
            const data = await resLesson.json();
            const lessons = Array.isArray(data) ? data : (data.result ? data.result : []);
            // Tổng buổi học
            document.getElementById('stat-lesson').textContent = lessons.length;
            // Buổi học tháng này
            const now = new Date();
            const lessonThisMonth = lessons.filter(l => {
                if (!l.lessonDate) return false;
                const d = new Date(l.lessonDate);
                return d.getFullYear() === now.getFullYear() && d.getMonth() === now.getMonth();
            }).length;
            document.getElementById('stat-lesson-month').textContent = lessonThisMonth;
        }

        // 6. Tổng bài kiểm tra
        const resExam = await fetch('/api/exams', { headers });
        if (resExam.ok) {
            const data = await resExam.json();
            const examCount = Array.isArray(data) ? data.length : (data.result ? data.result.length : 0);
            document.getElementById('stat-exam-total').textContent = examCount;
        }


        // --- Nút "Lớp học" ở dashboard-home: chuyển sang trang class và mở modal tạo lớp ---
        const btnQuickCreateClass = document.getElementById('btn-quick-create-class');
        if (btnQuickCreateClass) {
            btnQuickCreateClass.addEventListener('click', () => {
                // 1. Kích hoạt nav item "Lớp học" trên sidebar
                const navItems = document.querySelectorAll('.dashboard-wrap .sidebar .nav-item');
                navItems.forEach(nav => nav.classList.remove('active'));
                const classNavItem = [...navItems].find(nav => nav.getAttribute('data-page') === 'class');
                if (classNavItem) classNavItem.classList.add('active');

                // 2. Tải trang class, sau đó mở modal tạo lớp
                const contentArea = document.querySelector('.dashboard-wrap .main-content');
                contentArea.innerHTML = "<p style='padding: 20px;'>Đang tải dữ liệu...</p>";
                fetch('/pages/class.html')
                    .then(res => res.text())
                    .then(html => {
                        contentArea.innerHTML = html;
                        initClassPage();
                        // 3. Mở modal tạo lớp học sau khi trang đã render
                        const modalEl = document.getElementById('createClassModal');
                        if (modalEl) {
                            const modal = new bootstrap.Modal(modalEl);
                            modal.show();
                        }
                    })
                    .catch(err => console.error('Lỗi tải trang class:', err));
            });
        }

        // --- Nút "Học sinh": chuyển sang trang student và mở modal tạo mới ---
        const btnQuickCreateStudent = document.getElementById('btn-quick-create-student');
        if (btnQuickCreateStudent) {
            btnQuickCreateStudent.addEventListener('click', () => {
                // Kích hoạt nút cha "Quản lý" trên sidebar (student nằm trong dropdown)
                const navItems = document.querySelectorAll('.dashboard-wrap .sidebar .nav-item');
                navItems.forEach(nav => nav.classList.remove('active'));
                const manageBtn = document.querySelector('.dashboard-wrap .sidebar .nav-item.has-dropdown');
                if (manageBtn) manageBtn.classList.add('active');

                const contentArea = document.querySelector('.dashboard-wrap .main-content');
                contentArea.innerHTML = "<p style='padding: 20px;'>Đang tải dữ liệu...</p>";
                fetch('/pages/student.html')
                    .then(res => res.text())
                    .then(html => {
                        contentArea.innerHTML = html;
                        initStudentPage();
                        const modalEl = document.getElementById('createStudentModal');
                        if (modalEl) new bootstrap.Modal(modalEl).show();
                    })
                    .catch(err => console.error('Lỗi tải trang student:', err));
            });
        }

        // --- Nút "Buổi học": chuyển sang trang lesson và mở modal tạo mới ---
        const btnQuickCreateLesson = document.getElementById('btn-quick-create-lesson');
        if (btnQuickCreateLesson) {
            btnQuickCreateLesson.addEventListener('click', () => {
                const navItems = document.querySelectorAll('.dashboard-wrap .sidebar .nav-item');
                navItems.forEach(nav => nav.classList.remove('active'));
                const lessonNavItem = [...navItems].find(nav => nav.getAttribute('data-page') === 'lesson');
                if (lessonNavItem) lessonNavItem.classList.add('active');

                const contentArea = document.querySelector('.dashboard-wrap .main-content');
                contentArea.innerHTML = "<p style='padding: 20px;'>Đang tải dữ liệu...</p>";
                fetch('/pages/lesson.html')
                    .then(res => res.text())
                    .then(html => {
                        contentArea.innerHTML = html;
                        initLessonPage();
                        const modalEl = document.getElementById('createLessonModal');
                        if (modalEl) new bootstrap.Modal(modalEl).show();
                    })
                    .catch(err => console.error('Lỗi tải trang lesson:', err));
            });
        }

        // --- Nút "Bài kiểm tra": chuyển sang trang exam và mở modal tạo mới ---
        const btnQuickCreateExam = document.getElementById('btn-quick-create-exam');
        if (btnQuickCreateExam) {
            btnQuickCreateExam.addEventListener('click', () => {
                const navItems = document.querySelectorAll('.dashboard-wrap .sidebar .nav-item');
                navItems.forEach(nav => nav.classList.remove('active'));
                const examNavItem = [...navItems].find(nav => nav.getAttribute('data-page') === 'exam');
                if (examNavItem) examNavItem.classList.add('active');

                const contentArea = document.querySelector('.dashboard-wrap .main-content');
                contentArea.innerHTML = "<p style='padding: 20px;'>Đang tải dữ liệu...</p>";
                fetch('/pages/exam.html')
                    .then(res => res.text())
                    .then(html => {
                        contentArea.innerHTML = html;
                        initExamPage();
                        const modalEl = document.getElementById('createExamModal');
                        if (modalEl) new bootstrap.Modal(modalEl).show();
                    })
                    .catch(err => console.error('Lỗi tải trang exam:', err));
            });
        }
    } catch (err) {
        console.error("Lỗi fetch dashboard:", err);
    }
}
// End Dashboard Home

function normalizeApiList(data) {
    if (Array.isArray(data)) return data;
    if (Array.isArray(data?.result)) return data.result;
    if (Array.isArray(data?.data)) return data.data;
    return [];
}

function getLastTwelveMonths() {
    const months = [];
    const now = new Date();
    for (let i = 5; i >= 0; i--) {
        const date = new Date(now.getFullYear(), now.getMonth() - i, 1);
        months.push({
            key: `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`,
            label: `${String(date.getMonth() + 1).padStart(2, '0')}/${date.getFullYear()}`
        });
    }
    return months;
}

function renderStudentMonthlyChart(students) {
    const canvas = document.getElementById('studentMonthlyChart');
    if (!canvas) return;

    if (typeof Chart === 'undefined') {
        canvas.parentElement.innerHTML = '<div class="text-muted h-100 d-flex align-items-center justify-content-center">Không tải được Chart.js</div>';
        return;
    }

    const months = getLastTwelveMonths();
    const studentCreatedDates = students.map(student => {
        const rawDate = student.createdAt || student.createdDate || student.createAt;
        if (!rawDate) return null;

        const createdDate = new Date(rawDate);
        if (Number.isNaN(createdDate.getTime())) return null;
        return createdDate;
    }).filter(Boolean);

    if (dashboardStudentChart) {
        dashboardStudentChart.destroy();
    }

    const chartValues = months.map(month => {
        const [year, monthNumber] = month.key.split('-').map(Number);
        const endOfMonth = new Date(year, monthNumber, 0, 23, 59, 59, 999);
        return studentCreatedDates.filter(createdDate => createdDate <= endOfMonth).length;
    });
    const maxValue = Math.max(...chartValues);
    const yMax = maxValue <= 1 ? 1 : Math.ceil(maxValue * 1.15);

    dashboardStudentChart = new Chart(canvas, {
        type: 'bar',
        data: {
            labels: months.map(month => month.label),
            datasets: [{
                label: 'Số học sinh',
                data: chartValues,
                backgroundColor: '#3b82f6',
                borderColor: '#3b82f6',
                borderWidth: 0,
                borderRadius: 0,
                categoryPercentage: 0.8,
                barPercentage: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: 'bottom',
                    labels: {
                        color: '#3b82f6',
                        boxWidth: 16,
                        boxHeight: 12,
                        padding: 14,
                        font: { size: 14 }
                    }
                },
                tooltip: {
                    callbacks: {
                        label: context => `${context.parsed.y} học sinh`
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    border: { color: '#94a3b8' },
                    ticks: { color: '#64748b', font: { size: 14 } }
                },
                y: {
                    beginAtZero: true,
                    max: yMax,
                    ticks: {
                        color: '#64748b',
                        font: { size: 13 },
                        callback: value => Number(value).toString()
                    },
                    border: { color: '#94a3b8' },
                    grid: {
                        color: '#e2e8f0',
                        borderDash: [4, 4]
                    }
                }
            }
        }
    });
}

function renderClassByBranchChart(classes) {
    const canvas = document.getElementById('classByBranchChart');
    if (!canvas) return;

    if (typeof Chart === 'undefined') {
        canvas.parentElement.innerHTML = '<div class="text-muted h-100 d-flex align-items-center justify-content-center">Không tải được Chart.js</div>';
        return;
    }

    const countsByBranch = {};
    classes.forEach(classItem => {
        const branchName = classItem.branchName || (classItem.branchId ? `Chi nhánh ${classItem.branchId}` : 'Chưa có chi nhánh');
        countsByBranch[branchName] = (countsByBranch[branchName] || 0) + 1;
    });

    const sortedEntries = Object.entries(countsByBranch).sort((a, b) => b[1] - a[1]);
    const labels = sortedEntries.map(([branchName]) => branchName);
    const values = sortedEntries.map(([, count]) => count);
    const maxValue = Math.max(...values, 0);
    const yMax = maxValue <= 1 ? 1 : Math.ceil(maxValue * 1.15);

    if (dashboardClassBranchChart) {
        dashboardClassBranchChart.destroy();
    }

    dashboardClassBranchChart = new Chart(canvas, {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                label: 'Số lớp học',
                data: values,
                backgroundColor: '#3b82f6',
                borderColor: '#3b82f6',
                borderWidth: 0,
                borderRadius: 0,
                categoryPercentage: 0.75,
                barPercentage: 0.9
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: 'bottom',
                    labels: {
                        color: '#3b82f6',
                        boxWidth: 16,
                        boxHeight: 12,
                        padding: 14,
                        font: { size: 14 }
                    }
                },
                tooltip: {
                    callbacks: {
                        label: context => `${context.parsed.y} lớp học`
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    border: { color: '#94a3b8' },
                    ticks: {
                        color: '#64748b',
                        font: { size: 12 },
                        maxRotation: 0,
                        callback: function (value) {
                            const label = this.getLabelForValue(value);
                            return label.length > 12 ? `${label.slice(0, 12)}...` : label;
                        }
                    }
                },
                y: {
                    beginAtZero: true,
                    max: yMax,
                    ticks: {
                        precision: 0,
                        color: '#64748b',
                        font: { size: 13 },
                        callback: value => Number(value).toString()
                    },
                    border: { color: '#94a3b8' },
                    grid: {
                        color: '#e2e8f0',
                        borderDash: [4, 4]
                    }
                }
            }
        }
    });
}

// CLASS PAGE LOGIC
async function initClassPage() {
    const token = localStorage.getItem('accessToken');
    if (!token) return;

    const headers = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
    };

    // 1. Load danh sách chi nhánh vào Modal tạo mới
    try {
        const resBranch = await fetch('/api/branches', { headers });
        if (resBranch.ok) {
            const data = await resBranch.json();
            const branches = Array.isArray(data) ? data : (data.result ? data.result : []);
            const selectBranch = document.getElementById('newClassBranch');
            if (selectBranch) {
                selectBranch.innerHTML = '<option value="" disabled selected>Chọn chi nhánh</option>';
                branches.forEach(branch => {
                    const option = document.createElement('option');
                    option.value = branch.id;
                    option.textContent = branch.name;
                    selectBranch.appendChild(option);
                });
            }
        }
    } catch (err) {
        console.error("Lỗi load danh sách chi nhánh:", err);
    }

    // 2. Mở Modal tạo mới thủ công (tránh lỗi khi load DOM động)
    const btnOpenModal = document.querySelector('.btn-create-class');
    if (btnOpenModal) {
        btnOpenModal.addEventListener('click', () => {
            if (window.bootstrap) {
                const modalEl = document.getElementById('createClassModal');
                const modalObj = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modalObj.show();
            }
        });
    }

    // 3. Nút submit tạo mới
    const btnSubmit = document.getElementById('btnSubmitCreateClass');
    if (btnSubmit) {
        const newBtn = btnSubmit.cloneNode(true);
        btnSubmit.parentNode.replaceChild(newBtn, btnSubmit);
        newBtn.addEventListener('click', async () => {
            const branchId = document.getElementById('newClassBranch').value;
            const className = document.getElementById('newClassName').value.trim();
            const level = document.getElementById('newClassLevel').value.trim();
            const price = document.getElementById('newClassPrice').value;
            if (!branchId || !className) {
                alert("Vui lòng nhập tên lớp và chọn chi nhánh!");
                return;
            }
            const payload = { 
                name: className, 
                level: level, 
                branchId: parseInt(branchId),
                price: price ? parseFloat(price) : null
            };
            try {
                newBtn.textContent = 'Đang xử lý...';
                newBtn.disabled = true;
                const res = await fetch('/api/classes', {
                    method: 'POST',
                    headers: headers,
                    body: JSON.stringify(payload)
                });
                if (res.ok || res.status === 201) {
                    alert("Tạo lớp học mới thành công!");
                    if (window.bootstrap) {
                        const modalEl = document.getElementById('createClassModal');
                        const modalObj = bootstrap.Modal.getInstance(modalEl);
                        if (modalObj) modalObj.hide();
                    }
                    document.getElementById('createClassForm').reset();
                    fetchAndRenderClasses(headers);
                } else {
                    alert("Có lỗi xảy ra, không thể tạo được lớp học!");
                }
            } catch (err) {
                console.error("Lỗi khi tạo lớp:", err);
                alert("Lỗi kết nối tới Server!");
            } finally {
                newBtn.textContent = 'Tạo mới';
                newBtn.disabled = false;
            }
        });
    }

    // 4. Fetch và render danh sách lớp học
    fetchAndRenderClasses(headers);
}

// Biến toàn cục lưu danh sách lớp học và trạng thái filter
let allClasses = [];
let _classHeaders = null;
let currentPage = 1;

async function fetchAndRenderClasses(headers) {
    _classHeaders = headers;
    const container = document.getElementById('class-list-container');
    const countText = document.getElementById('class-count-text');
    if (!container) return;

    container.innerHTML = `<div class="col-12 text-center py-4 text-muted">Đang tải dữ liệu...</div>`;

    try {
        const res = await fetch('/api/classes', { headers });
        if (!res.ok) throw new Error('Không thể lấy danh sách lớp học');
        const data = await res.json();
        allClasses = Array.isArray(data) ? data : (data.result ? data.result : []);

        // Đổ options chi nhánh động (lấy unique từ dữ liệu)
        const branchSelect = document.getElementById('filter-branch');
        if (branchSelect) {
            const uniqueBranches = [...new Map(
                allClasses
                    .filter(c => c.branchName || c.branch?.name)
                    .map(c => {
                        const id = c.branchId || c.branch?.id || '';
                        const name = c.branchName || c.branch?.name || '';
                        return [id, { id, name }];
                    })
            ).values()];
            branchSelect.innerHTML = '<option value="">Tất cả</option>';
            uniqueBranches.forEach(b => {
                const opt = document.createElement('option');
                opt.value = b.id;
                opt.textContent = b.name;
                branchSelect.appendChild(opt);
            });
        }

        // Đổ options Level động (unique levels)
        const levelSelect = document.getElementById('filter-level');
        if (levelSelect) {
            const uniqueLevels = [...new Set(allClasses.map(c => c.level).filter(Boolean))].sort();
            levelSelect.innerHTML = '<option value="">Tất cả</option>';
            uniqueLevels.forEach(lv => {
                const opt = document.createElement('option');
                opt.value = lv;
                opt.textContent = lv;
                levelSelect.appendChild(opt);
            });
        }

        // Gắn event lọc (chỉ gắn 1 lần, dùng flag để tránh duplicate)
        if (!document.getElementById('filter-search')?._filterBound) {
            const inputs = ['filter-search', 'filter-branch', 'filter-level', 'filter-sort', 'filter-page-size'];
            inputs.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el._filterBound = true;
                    el.addEventListener('input', () => { currentPage = 1; applyFilters(); });
                    el.addEventListener('change', () => { currentPage = 1; applyFilters(); });
                }
            });

            // Nút đặt lại lọc
            const btnReset = document.getElementById('btn-reset-filter');
            if (btnReset) {
                btnReset._filterBound = true;
                btnReset.addEventListener('click', () => {
                    document.getElementById('filter-search').value = '';
                    document.getElementById('filter-branch').value = '';
                    document.getElementById('filter-level').value = '';
                    document.getElementById('filter-sort').value = 'az';
                    document.getElementById('filter-page-size').value = '12';
                    currentPage = 1;
                    applyFilters();
                });
            }
        }

        // Áp dụng filter lần đầu (hiển thị tất cả)
        currentPage = 1;
        applyFilters();

    } catch (err) {
        console.error("Lỗi fetch danh sách lớp:", err);
        if (container) {
            container.innerHTML = `<div class="col-12 text-center py-4 text-danger">Không thể tải danh sách lớp học.</div>`;
        }
    }
}

function applyFilters() {
    const search = (document.getElementById('filter-search')?.value || '').toLowerCase().trim();
    const branchId = document.getElementById('filter-branch')?.value || '';
    const level = document.getElementById('filter-level')?.value || '';
    const sort = document.getElementById('filter-sort')?.value || 'az';
    const pageSize = parseInt(document.getElementById('filter-page-size')?.value || '12');

    // 1. Lọc
    let filtered = allClasses.filter(cls => {
        const branchName = cls.branchName || cls.branch?.name || '';
        const clsLevel = cls.level || '';
        const clsBranchId = String(cls.branchId || cls.branch?.id || '');

        const matchSearch = !search ||
            (cls.name || '').toLowerCase().includes(search) ||
            branchName.toLowerCase().includes(search) ||
            clsLevel.toLowerCase().includes(search);

        const matchBranch = !branchId || clsBranchId === String(branchId);
        const matchLevel = !level || clsLevel === level;

        return matchSearch && matchBranch && matchLevel;
    });

    // 2. Sắp xếp
    filtered.sort((a, b) => {
        const nameA = (a.name || '').toLowerCase();
        const nameB = (b.name || '').toLowerCase();
        return sort === 'az' ? nameA.localeCompare(nameB) : nameB.localeCompare(nameA);
    });

    // 3. Phân trang
    const totalItems = filtered.length;
    const totalPages = pageSize >= 9999 ? 1 : Math.ceil(totalItems / pageSize);
    if (currentPage > totalPages) currentPage = Math.max(1, totalPages);

    const startIndex = (currentPage - 1) * pageSize;
    const pageItems = pageSize >= 9999 ? filtered : filtered.slice(startIndex, startIndex + pageSize);

    // 4. Cập nhật text đếm
    const countText = document.getElementById('class-count-text');
    if (countText) {
        countText.textContent = `Hiển thị ${pageItems.length} / ${totalItems} lớp học`;
    }

    // 5. Render cards
    const container = document.getElementById('class-list-container');
    if (!container) return;

    if (pageItems.length === 0) {
        container.innerHTML = `
            <div class="col-12 text-center py-5">
                <div class="d-flex flex-column align-items-center text-muted">
                    <i class="fa-solid fa-folder-open fs-2 mb-3 text-light"></i>
                    <p class="mb-0 fs-5">Không tìm thấy lớp học nào phù hợp.</p>
                </div>
            </div>`;
    } else {
        container.innerHTML = pageItems.map(cls => `
            <div class="col-md-4 mb-4">
                <div class="card lesson-card-modern class-card-clickable h-100 d-flex flex-column" data-id="${cls.id}" tabindex="0" role="button" title="Xem chi tiết lớp học">
                    <div class="lesson-card-header">
                        <div class="lesson-icon-modern" style="background: linear-gradient(135deg, #10b981, #34d399);">
                            <i class="fa-solid fa-book-open"></i>
                        </div>
                        <div class="lesson-header-text">
                            <h5 class="fw-bold mb-1 class-card-title text-truncate" title="${cls.name || 'Không tên'}">${cls.name || 'Không tên'}</h5>
                            ${cls.level ? `<span class="badge lesson-badge-modern" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">Level ${cls.level}</span>` : '<span class="badge lesson-badge-modern" style="background: #f1f5f9; color: #64748b;">Chưa có Level</span>'}
                        </div>
                    </div>
                    <div class="lesson-card-body flex-grow-1">
                        <div class="lesson-info-row">
                            <div class="icon-bg-light icon-blue">
                                <i class="fa-solid fa-building"></i>
                            </div>
                            <div class="lesson-info-text">
                                <span class="info-label">Chi nhánh</span>
                                <span class="info-value fw-semibold text-dark text-truncate" title="${cls.branchName || cls.branch?.name || 'Chưa phân bổ'}">${cls.branchName || cls.branch?.name || 'Chưa phân bổ'}</span>
                            </div>
                        </div>
                        <div class="lesson-info-row mt-2">
                            <div class="icon-bg-light icon-blue" style="background: rgba(244,63,94,0.1); color: #f43f5e;">
                                <i class="fa-solid fa-money-bill-wave"></i>
                            </div>
                            <div class="lesson-info-text">
                                <span class="info-label">Học phí</span>
                                <span class="info-value fw-bold text-danger text-truncate">${cls.price ? new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(cls.price) : 'Chưa có giá'}</span>
                            </div>
                        </div>
                    </div>
                    <div class="lesson-card-footer d-flex justify-content-between gap-2">
                        <button class="btn flex-grow-1 btn-edit-modern btn-edit-class" data-id="${cls.id}">
                            <i class="fa-regular fa-pen-to-square me-1"></i> Sửa
                        </button>
                        <button class="btn flex-grow-1 btn-delete-modern btn-delete-class" data-id="${cls.id}" data-name="${cls.name}">
                            <i class="fa-regular fa-trash-can me-1"></i> Xóa
                        </button>
                    </div>
                </div>
            </div>
        `).join('');

        container.querySelectorAll('.class-card-clickable').forEach(card => {
            const openDetail = () => {
                const cls = allClasses.find(c => String(c.id) === String(card.getAttribute('data-id')));
                if (cls) openClassDetailPage(cls);
            };

            card.addEventListener('click', (event) => {
                if (event.target.closest('button')) return;
                openDetail();
            });

            card.addEventListener('keydown', (event) => {
                if (event.key !== 'Enter' && event.key !== ' ') return;
                event.preventDefault();
                openDetail();
            });
        });

        // Gắn sự kiện nút Xóa
        container.querySelectorAll('.btn-delete-class').forEach(btn => {
            btn.addEventListener('click', () => {
                const classId = btn.getAttribute('data-id');
                const className = btn.getAttribute('data-name');
                const msgEl = document.getElementById('deleteClassMessage');
                if (msgEl) {
                    msgEl.innerHTML = `Bạn có chắc chắn muốn xóa lớp học <strong>"${className}"</strong>?<br>Hành động này không thể hoàn tác.`;
                }
                const deleteModalEl = document.getElementById('deleteClassModal');
                const deleteModal = bootstrap.Modal.getInstance(deleteModalEl) || new bootstrap.Modal(deleteModalEl);
                deleteModal.show();

                const btnConfirm = document.getElementById('btnConfirmDelete');
                const newBtnConfirm = btnConfirm.cloneNode(true);
                btnConfirm.parentNode.replaceChild(newBtnConfirm, btnConfirm);

                newBtnConfirm.addEventListener('click', async () => {
                    try {
                        newBtnConfirm.textContent = 'Đang xóa...';
                        newBtnConfirm.disabled = true;
                        const delRes = await fetch(`/api/classes/${classId}`, { method: 'DELETE', headers: _classHeaders });
                        if (delRes.ok || delRes.status === 204) {
                            deleteModal.hide();
                            fetchAndRenderClasses(_classHeaders);
                        } else {
                            alert("Không thể xóa lớp học. Vui lòng thử lại!");
                        }
                    } catch (err) {
                        console.error("Lỗi khi xóa lớp:", err);
                        alert("Lỗi kết nối tới Server!");
                    } finally {
                        newBtnConfirm.textContent = 'Xóa';
                        newBtnConfirm.disabled = false;
                    }
                });
            });
        });

        // Gắn sự kiện nút Sửa
        container.querySelectorAll('.btn-edit-class').forEach(btn => {
            btn.addEventListener('click', () => {
                const cls = allClasses.find(c => String(c.id) === btn.getAttribute('data-id'));
                if (cls) openEditModal(cls, _classHeaders);
            });
        });
    }

    // 6. Render pagination buttons
    renderPagination(totalPages);
}

function openClassDetailPage(cls) {
    sessionStorage.setItem('selectedClassDetail', JSON.stringify(cls));
    sessionStorage.setItem('selectedClassId', cls.id);
    document.querySelectorAll('.dashboard-wrap .sidebar .nav-item').forEach(nav => nav.classList.remove('active'));
    document.querySelector('.dashboard-wrap .sidebar .nav-item[data-page="class"]')?.classList.add('active');
    loadDashboardContent('class-detail', initClassDetailPage);
}

function renderPagination(totalPages) {
    const paginationEl = document.getElementById('pagination-controls');
    if (!paginationEl) return;

    if (totalPages <= 1) {
        paginationEl.innerHTML = '';
        return;
    }

    const btnStyle = (isActive) => `
        style="min-width:34px; height:34px; border-radius:8px; border:1.5px solid ${isActive ? 'var(--primary-color)' : '#E0E5F2'};
        background:${isActive ? 'var(--primary-color)' : 'white'}; color:${isActive ? 'white' : '#4a5568'};
        font-weight:500; font-size:14px; cursor:pointer; transition: all 0.2s ease;"
    `;

    let html = `<button onclick="changePage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''}
        style="min-width:34px; height:34px; border-radius:8px; border:1.5px solid #E0E5F2; background:white;
        color:#4a5568; font-weight:500; font-size:14px; cursor:pointer; transition: all 0.2s ease;">‹</button>`;

    for (let i = 1; i <= totalPages; i++) {
        html += `<button onclick="changePage(${i})" ${btnStyle(i === currentPage)}>${i}</button>`;
    }

    html += `<button onclick="changePage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''}
        style="min-width:34px; height:34px; border-radius:8px; border:1.5px solid #E0E5F2; background:white;
        color:#4a5568; font-weight:500; font-size:14px; cursor:pointer; transition: all 0.2s ease;">›</button>`;

    paginationEl.innerHTML = html;
}

function changePage(page) {
    const pageSize = parseInt(document.getElementById('filter-page-size')?.value || '12');
    const search = (document.getElementById('filter-search')?.value || '').toLowerCase().trim();
    const branchId = document.getElementById('filter-branch')?.value || '';
    const level = document.getElementById('filter-level')?.value || '';
    let filtered = allClasses.filter(cls => {
        const branchName = cls.branchName || cls.branch?.name || '';
        const clsLevel = cls.level || '';
        const clsBranchId = String(cls.branchId || cls.branch?.id || '');
        const matchSearch = !search ||
            (cls.name || '').toLowerCase().includes(search) ||
            branchName.toLowerCase().includes(search) ||
            clsLevel.toLowerCase().includes(search);
        const matchBranch = !branchId || clsBranchId === String(branchId);
        const matchLevel = !level || clsLevel === level;
        return matchSearch && matchBranch && matchLevel;
    });
    const totalPages = Math.ceil(filtered.length / pageSize);
    if (page < 1 || page > totalPages) return;
    currentPage = page;
    applyFilters();
}


async function openEditModal(cls, headers) {
    // 1. Điền ID ẩn
    document.getElementById('editClassId').value = cls.id;

    // 2. Điền tên lớp & level & price
    document.getElementById('editClassName').value = cls.name || '';
    document.getElementById('editClassLevel').value = cls.level || '';
    document.getElementById('editClassPrice').value = cls.price || '';

    // 3. Load branches vào select và chọn sẵn chi nhánh hiện tại
    const selectBranch = document.getElementById('editClassBranch');
    selectBranch.innerHTML = '<option value="" disabled>Đang tải...</option>';
    try {
        const resBranch = await fetch('/api/branches', { headers });
        if (resBranch.ok) {
            const data = await resBranch.json();
            const branches = Array.isArray(data) ? data : (data.result ? data.result : []);
            selectBranch.innerHTML = '<option value="" disabled>Chọn chi nhánh</option>';
            branches.forEach(branch => {
                const option = document.createElement('option');
                option.value = branch.id;
                option.textContent = branch.name;
                // Chọn sẵn chi nhánh của lớp đang sửa
                const currentBranchId = cls.branchId || cls.branch?.id;
                if (String(branch.id) === String(currentBranchId)) {
                    option.selected = true;
                }
                selectBranch.appendChild(option);
            });
        }
    } catch (err) {
        console.error("Lỗi load branches cho form sửa:", err);
    }

    // 4. Mở modal
    const editModalEl = document.getElementById('editClassModal');
    const editModal = bootstrap.Modal.getInstance(editModalEl) || new bootstrap.Modal(editModalEl);
    editModal.show();

    // 5. Gắn sự kiện nút Lưu thay đổi (cloneNode để tránh duplicate listener)
    const btnSubmit = document.getElementById('btnSubmitEditClass');
    const newBtnSubmit = btnSubmit.cloneNode(true);
    btnSubmit.parentNode.replaceChild(newBtnSubmit, btnSubmit);

    newBtnSubmit.addEventListener('click', async () => {
        const branchId = document.getElementById('editClassBranch').value;
        const className = document.getElementById('editClassName').value.trim();
        const level = document.getElementById('editClassLevel').value.trim();
        const classId = document.getElementById('editClassId').value;
        const price = document.getElementById('editClassPrice').value;

        if (!branchId || !className) {
            alert("Vui lòng nhập tên lớp và chọn chi nhánh!");
            return;
        }

        const payload = { 
            name: className, 
            level: level, 
            branchId: parseInt(branchId),
            price: price ? parseFloat(price) : null 
        };

        try {
            newBtnSubmit.textContent = 'Đang lưu...';
            newBtnSubmit.disabled = true;

            const res = await fetch(`/api/classes/${classId}`, {
                method: 'PUT',
                headers,
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                editModal.hide();
                if (document.querySelector('.class-detail-page')) {
                    sessionStorage.setItem('selectedClassDetail', JSON.stringify({
                        ...cls,
                        name: className,
                        level: level,
                        branchId: parseInt(branchId)
                    }));
                    sessionStorage.setItem('selectedClassId', cls.id);
                    loadDashboardContent('class-detail', initClassDetailPage);
                } else {
                    fetchAndRenderClasses(headers);
                }
            } else {
                alert("Có lỗi xảy ra, không thể cập nhật lớp học!");
            }
        } catch (err) {
            console.error("Lỗi khi sửa lớp:", err);
            alert("Lỗi kết nối tới Server!");
        } finally {
            newBtnSubmit.textContent = 'Lưu thay đổi';
            newBtnSubmit.disabled = false;
        }
    });
}

async function initClassDetailPage() {
    const token = localStorage.getItem('accessToken');
    const classId = sessionStorage.getItem('selectedClassId');
    if (!token || !classId) {
        loadDashboardContent('class', initClassPage);
        return;
    }

    const headers = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
    };
    const storedClass = safeJsonParse(sessionStorage.getItem('selectedClassDetail')) || {};
    const setText = (id, value) => {
        const el = document.getElementById(id);
        if (el) el.textContent = value ?? '-';
    };

    document.getElementById('class-detail-btn-back')?.addEventListener('click', () => {
        loadDashboardContent('class', initClassPage);
    });

    document.getElementById('class-detail-btn-share')?.addEventListener('click', async () => {
        const shareText = `${storedClass.name || 'Lớp học'} - Mã lớp: ${classId}`;
        try {
            await navigator.clipboard?.writeText(shareText);
            alert('Đã sao chép thông tin lớp học!');
        } catch {
            alert(shareText);
        }
    });

    const goToPage = (pageName, initCallback) => {
        const navItem = document.querySelector(`.dashboard-wrap .sidebar .nav-item[data-page="${pageName}"]`);
        if (navItem) navItem.click();
        else loadDashboardContent(pageName, initCallback);
    };

    document.getElementById('class-detail-btn-assign-teacher')?.addEventListener('click', () => goToPage('teacher', initTeacherPage));
    document.getElementById('class-detail-btn-view-students')?.addEventListener('click', () => goToPage('student', initStudentPage));
    document.getElementById('class-detail-btn-view-lessons')?.addEventListener('click', () => goToPage('lesson', initLessonPage));
    document.getElementById('class-detail-btn-view-exams')?.addEventListener('click', () => goToPage('exam', initExamPage));

    try {
        const [classes, students, allStudents, lessons, exams, teachers] = await Promise.all([
            fetchApiList('/api/classes', headers),
            fetchStudentsForClass(classId, headers),
            fetchApiList('/api/students', headers),
            fetchApiList('/api/lessons', headers),
            fetchExamsForClass(classId, headers),
            fetchApiList('/api/teachers', headers)
        ]);

        const classInfo = classes.find(c => String(c.id) === String(classId)) || storedClass;
        const classLessons = lessons.filter(ls => String(ls.classId) === String(classId));
        const classExams = exams.filter(ex => !ex.classId || String(ex.classId) === String(classId));
        const classTeachers = getClassDetailTeachers(classId, classInfo, classLessons, classExams, teachers);

        document.getElementById('class-detail-btn-edit')?.addEventListener('click', () => {
            openEditModal(classInfo, headers);
        });

        document.getElementById('class-detail-btn-add-student')?.addEventListener('click', () => {
            openAssignStudentsModal(classInfo, allStudents, classes, headers);
        });

        document.getElementById('class-detail-btn-add-lesson')?.addEventListener('click', () => {
            openClassCreateModalFromDetail('lesson', initLessonPage, 'createLessonModal', 'newLessonClassId', classInfo);
        });

        document.getElementById('class-detail-btn-add-exam')?.addEventListener('click', () => {
            openClassCreateModalFromDetail('exam', initExamPage, 'createExamModal', 'newExamClassId', classInfo);
        });

        document.getElementById('class-detail-btn-delete')?.addEventListener('click', () => {
            const deleteModalEl = document.getElementById('deleteClassModal');
            const deleteModal = bootstrap.Modal.getInstance(deleteModalEl) || new bootstrap.Modal(deleteModalEl);
            const msgEl = document.getElementById('deleteClassMessage');
            if (msgEl) {
                msgEl.innerHTML = `Bạn có chắc chắn muốn xóa lớp học <strong>"${classInfo.name || 'Lớp học'}"</strong>?<br>Hành động này không thể hoàn tác.`;
            }
            deleteModal.show();

            const btnConfirm = document.getElementById('btnConfirmDelete');
            const newBtnConfirm = btnConfirm.cloneNode(true);
            btnConfirm.parentNode.replaceChild(newBtnConfirm, btnConfirm);

            newBtnConfirm.addEventListener('click', async () => {
                try {
                    newBtnConfirm.textContent = 'Đang xóa...';
                    newBtnConfirm.disabled = true;
                    const res = await fetch(`/api/classes/${classId}`, {
                        method: 'DELETE',
                        headers
                    });
                    if (res.ok || res.status === 204) {
                        deleteModal.hide();
                        sessionStorage.removeItem('selectedClassDetail');
                        sessionStorage.removeItem('selectedClassId');
                        loadDashboardContent('class', initClassPage);
                    } else {
                        alert('Không thể xóa lớp học. Vui lòng thử lại!');
                    }
                } catch (err) {
                    console.error('Lỗi khi xóa lớp từ trang chi tiết:', err);
                    alert('Lỗi kết nối tới Server!');
                } finally {
                    newBtnConfirm.textContent = 'Xác nhận Xóa';
                    newBtnConfirm.disabled = false;
                }
            });
        });

        setText('class-detail-name', classInfo.name || 'Lớp học');
        setText('class-detail-branch', classInfo.branchName || classInfo.branch?.name || 'Chi nhánh chính');
        setText('class-detail-created-date', formatClassDetailDate(classInfo.createdAt || classInfo.createdDate || classInfo.createDate));
        setText('class-detail-lesson-count', classLessons.length);
        setText('class-detail-exam-count', classExams.length);
        setText('class-detail-student-count', students.length);
        setText('class-detail-teacher-count', classTeachers.length);
        setText('class-detail-teacher-title-count', classTeachers.length);
        setText('class-detail-student-title-count', students.length);
        setText('class-detail-lesson-title-count', classLessons.length);
        setText('class-detail-exam-title-count', classExams.length);

        renderClassDetailTeachers(classTeachers);
        renderClassDetailStudents(students);
        renderClassDetailLessons(classLessons);
        renderClassDetailExams(classExams);
    } catch (err) {
        console.error('Lỗi tải chi tiết lớp:', err);
        setText('class-detail-name', storedClass.name || 'Không thể tải lớp học');
    }
}

function safeJsonParse(value) {
    try { return value ? JSON.parse(value) : null; } catch { return null; }
}

function openAssignStudentsModal(classInfo, students, classes, headers) {
    const modalEl = document.getElementById('assignStudentModal');
    if (!modalEl) return;

    const classId = String(classInfo.id);
    const classMap = new Map((classes || []).map(c => [String(c.id), c]));
    const candidates = (students || []).filter(student => String(student.classId || '') !== classId);

    const searchInput = document.getElementById('assign-student-search');
    const clearBtn = document.getElementById('assign-student-clear');
    const listEl = document.getElementById('assign-student-list');
    const emptyEl = document.getElementById('assign-student-empty');
    const countEl = document.getElementById('assign-student-count');
    const submitBtn = document.getElementById('btnSubmitAssignStudents');

    if (!searchInput || !clearBtn || !listEl || !emptyEl || !countEl || !submitBtn) return;

    const state = {
        selected: new Set(),
        items: candidates
    };

    const render = () => {
        const keyword = searchInput.value.trim().toLowerCase();
        const filtered = state.items.filter(student => {
            const className = classMap.get(String(student.classId))?.name || student.className || '';
            return !keyword ||
                (student.name || student.fullName || '').toLowerCase().includes(keyword) ||
                (student.parentName || '').toLowerCase().includes(keyword) ||
                className.toLowerCase().includes(keyword);
        });

        emptyEl.style.display = filtered.length ? 'none' : 'block';
        countEl.textContent = String(state.selected.size);
        listEl.innerHTML = filtered.map(student => {
            const studentClass = classMap.get(String(student.classId));
            const studentClassName = studentClass?.name || student.className || 'Chưa có lớp';
            const checked = state.selected.has(String(student.id)) ? 'checked' : '';
            return `
                <label class="d-flex align-items-center p-3 mb-2 rounded-3"
                    style="cursor:pointer; border:1px solid #E0E5F2; transition:all 0.15s ease; user-select:none;">
                    <input type="checkbox" class="assign-student-checkbox me-3" value="${student.id}" ${checked}
                        style="width:18px; height:18px; accent-color:#7B4BEF;">
                    <div class="flex-grow-1">
                        <div class="fw-semibold" style="font-size:14px; color:#1a202c;">
                            ${escapeClassDetailHtml(student.name || student.fullName || '—')}
                        </div>
                        <div class="text-muted" style="font-size:12px;">
                            ${escapeClassDetailHtml(studentClassName)}
                            ${student.parentName ? ` - ${escapeClassDetailHtml(student.parentName)}` : ''}
                        </div>
                    </div>
                </label>
            `;
        }).join('');

        listEl.querySelectorAll('.assign-student-checkbox').forEach(cb => {
            cb.addEventListener('change', () => {
                if (cb.checked) state.selected.add(String(cb.value));
                else state.selected.delete(String(cb.value));
                countEl.textContent = String(state.selected.size);
            });
        });
    };

    searchInput.oninput = render;
    clearBtn.onclick = () => {
        searchInput.value = '';
        render();
    };

    const freshSubmit = submitBtn.cloneNode(true);
    submitBtn.parentNode.replaceChild(freshSubmit, submitBtn);
    freshSubmit.addEventListener('click', async () => {
        if (state.selected.size === 0) {
            alert('Vui lòng chọn ít nhất một học sinh.');
            return;
        }

        try {
            freshSubmit.disabled = true;
            freshSubmit.textContent = 'Đang gán...';

            const selectedStudents = candidates.filter(s => state.selected.has(String(s.id)));
            for (const student of selectedStudents) {
                const payload = {
                    name: student.name || student.fullName || '',
                    dateOfBirth: student.dateOfBirth || student.dob || null,
                    classId: parseInt(classId),
                    parentName: student.parentName || null,
                    parentPhone: student.parentPhone || null,
                    parentEmail: student.parentEmail || null
                };

                const res = await fetch(`/api/students/${student.id}`, {
                    method: 'PUT',
                    headers,
                    body: JSON.stringify(payload)
                });

                if (!res.ok) {
                    const errText = await res.text();
                    throw new Error(errText || `Không thể gán học sinh ${student.name || student.id}`);
                }
            }

            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.hide();
            sessionStorage.setItem('selectedClassDetail', JSON.stringify(classInfo));
            sessionStorage.setItem('selectedClassId', classInfo.id);
            loadDashboardContent('class-detail', initClassDetailPage);
        } catch (err) {
            console.error('Lỗi gán học sinh vào lớp:', err);
            alert('Không thể gán học sinh vào lớp. Vui lòng thử lại.');
        } finally {
            freshSubmit.disabled = false;
            freshSubmit.textContent = 'Gán vào lớp';
        }
    });

    render();
    const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
    modal.show();
}

function openClassCreateModalFromDetail(pageName, initCallback, modalId, selectId, classInfo) {
    const run = async () => {
        if (typeof initCallback === 'function') {
            await initCallback();
        }
        const select = document.getElementById(selectId);
        if (select) {
            select.value = String(classInfo.id);
            select.dispatchEvent(new Event('change', { bubbles: true }));
        }
        const modalEl = document.getElementById(modalId);
        if (modalEl) {
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();
        }
    };

    loadDashboardContent(pageName, () => {
        run().catch(err => console.error(`Lỗi mở form ${pageName}:`, err));
    });
}

async function fetchApiList(url, headers) {
    const res = await fetch(url, { headers });
    if (!res.ok) return [];
    return normalizeApiList(await res.json());
}

async function fetchStudentsForClass(classId, headers) {
    const byClass = await fetchApiList(`/api/students/class/${classId}`, headers);
    if (byClass.length) return byClass;
    const all = await fetchApiList('/api/students', headers);
    return all.filter(s => String(s.classId) === String(classId));
}

async function fetchExamsForClass(classId, headers) {
    const byClass = await fetchApiList(`/api/exams/class/${classId}`, headers);
    if (byClass.length) return byClass;
    const all = await fetchApiList('/api/exams', headers);
    return all.filter(ex => String(ex.classId) === String(classId));
}

function getClassDetailTeachers(classId, classInfo, lessons, exams, teachers) {
    const map = new Map();
    const addTeacher = (id, name) => {
        const key = id ? String(id) : name;
        if (!key) return;
        map.set(key, { id, name: name || `GV-${id}` });
    };

    if (classInfo.teacherId || classInfo.teacherName) addTeacher(classInfo.teacherId, classInfo.teacherName);
    (classInfo.teachers || []).forEach(t => addTeacher(t.id, t.name || t.fullName));
    lessons.forEach(ls => addTeacher(ls.teacherId, ls.teacherName));
    exams.forEach(ex => addTeacher(ex.teacherId, ex.teacherName));
    teachers
        .filter(t => String(t.classId || '') === String(classId) ||
            (Array.isArray(t.classIds) && t.classIds.some(id => String(id) === String(classId))) ||
            (Array.isArray(t.classes) && t.classes.some(c => String(c.id) === String(classId))))
        .forEach(t => addTeacher(t.id, t.name || t.fullName));

    return [...map.values()];
}

function renderClassDetailTeachers(teachers) {
    const container = document.getElementById('class-detail-teacher-list');
    if (!container) return;
    container.innerHTML = teachers.length ? teachers.map(t => `
        <article class="class-detail-mini-card">
            <strong>${escapeClassDetailHtml(t.name || '-')}</strong>
            <i class="fa-regular fa-trash-can"></i>
        </article>
    `).join('') : renderClassDetailEmpty('Chưa có giáo viên');
}

function renderClassDetailStudents(students) {
    const container = document.getElementById('class-detail-student-list');
    if (!container) return;
    container.innerHTML = students.length ? students.slice(0, 4).map(s => `
        <article class="class-detail-mini-card">
            <div>
                <strong>${escapeClassDetailHtml(s.name || '-')}</strong>
                <span>${escapeClassDetailHtml(s.parentPhone || s.parentName || 'Chưa có thông tin phụ huynh')}</span>
            </div>
            <i class="fa-solid fa-chevron-down"></i>
        </article>
    `).join('') : renderClassDetailEmpty('Chưa có học sinh');
}

function renderClassDetailLessons(lessons) {
    const container = document.getElementById('class-detail-lesson-list');
    if (!container) return;
    const sorted = [...lessons].sort((a, b) => new Date(b.lessonDate || 0) - new Date(a.lessonDate || 0));
    container.innerHTML = sorted.length ? sorted.slice(0, 3).map(ls => `
        <article class="class-detail-lesson-card">
            <div class="class-detail-lesson-head">
                <div class="class-detail-lesson-icon">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
                <div class="class-detail-lesson-title">
                    <h4>${escapeClassDetailHtml(ls.className || `Buổi ${ls.lessonNumber ?? ''}`)}</h4>
                    <span class="class-detail-lesson-badge">Buổi ${escapeClassDetailHtml(ls.lessonNumber ?? '—')}</span>
                </div>
            </div>
            <div class="class-detail-lesson-body">
                <div class="class-detail-lesson-row">
                    <div class="class-detail-lesson-icon-sm class-detail-lesson-icon-date">
                        <i class="fa-regular fa-calendar"></i>
                    </div>
                    <div>
                        <span>Ngày học</span>
                        <strong>${formatClassDetailDate(ls.lessonDate)}</strong>
                    </div>
                </div>
                <div class="class-detail-lesson-row">
                    <div class="class-detail-lesson-icon-sm class-detail-lesson-icon-teacher">
                        <i class="fa-solid fa-chalkboard-user"></i>
                    </div>
                    <div>
                        <span>Giáo viên</span>
                        <strong>${escapeClassDetailHtml(ls.teacherName || '—')}</strong>
                    </div>
                </div>
            </div>
            <div class="class-detail-lesson-actions">
                <button class="btn class-detail-lesson-btn class-detail-lesson-btn-primary">
                    <i class="fa-regular fa-pen-to-square"></i>
                    <span>Sửa</span>
                </button>
                <button class="btn class-detail-lesson-btn class-detail-lesson-btn-danger">
                    <i class="fa-regular fa-trash-can"></i>
                    <span>Xóa</span>
                </button>
            </div>
        </article>
    `).join('') : renderClassDetailEmpty('Chưa có buổi học');
}

function renderClassDetailExams(exams) {
    const container = document.getElementById('class-detail-exam-list');
    if (!container) return;
    const sorted = [...exams].sort((a, b) => new Date(b.examDate || 0) - new Date(a.examDate || 0));
    container.innerHTML = sorted.length ? sorted.slice(0, 4).map(ex => `
        <article class="class-detail-mini-card class-detail-exam-card">
            <div>
                <strong>${escapeClassDetailHtml(ex.examType || 'Bài kiểm tra')}</strong>
                <span><i class="fa-regular fa-calendar"></i>${formatClassDetailDate(ex.examDate)}</span>
            </div>
        </article>
    `).join('') : renderClassDetailEmpty('Chưa có bài kiểm tra');
}

function renderClassDetailEmpty(text) {
    return `<div class="class-detail-empty">${text}</div>`;
}

function formatClassDetailDate(value) {
    if (!value) return '-';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '-';
    return date.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
}

function escapeClassDetailHtml(value) {
    return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
}

// ================================================
// LESSON PAGE LOGIC
// ================================================
let allLessons = [];
let _lessonHeaders = null;
let lessonCurrentPage = 1;

async function initLessonPage() {
    const token = localStorage.getItem('accessToken');
    if (!token) return;

    _lessonHeaders = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
    };

    // 1. Load danh sách lớp học vào select "Chọn lớp học" và modal Tạo mới
    try {
        const resClass = await fetch('/api/classes', { headers: _lessonHeaders });
        if (resClass.ok) {
            const data = await resClass.json();
            const classes = Array.isArray(data) ? data : (data.result ? data.result : []);

            const filterClassEl = document.getElementById('lesson-filter-class');
            const newClassEl = document.getElementById('newLessonClassId');
            const editClassEl = document.getElementById('editLessonClassId');

            [filterClassEl, newClassEl, editClassEl].forEach(sel => {
                if (!sel) return;
                const defaultOpt = sel.querySelector('option[value=""]');
                sel.innerHTML = '';
                if (defaultOpt) sel.appendChild(defaultOpt.cloneNode(true));
                classes.forEach(cls => {
                    const opt = document.createElement('option');
                    opt.value = cls.id;
                    opt.textContent = cls.name;
                    sel.appendChild(opt);
                });
            });
        }
    } catch (err) {
        console.error("Lỗi load classes cho lesson page:", err);
    }

    // 2. Load danh sách giáo viên vào modal
    try {
        const resTeacher = await fetch('/api/teachers', { headers: _lessonHeaders });
        if (resTeacher.ok) {
            const data = await resTeacher.json();
            const teachers = Array.isArray(data) ? data : (data.result ? data.result : []);

            [document.getElementById('newLessonTeacherId'), document.getElementById('editLessonTeacherId')].forEach(sel => {
                if (!sel) return;
                sel.innerHTML = '<option value="" disabled selected>Chọn giáo viên</option>';
                teachers.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.id;
                    opt.textContent = t.name || t.fullName || `GV-${t.id}`;
                    sel.appendChild(opt);
                });
            });
        }
    } catch (err) {
        console.error("Lỗi load teachers cho lesson page:", err);
    }

    // 3. Mở modal Tạo mới
    const btnOpenCreate = document.querySelector('.btn-create-lesson');
    if (btnOpenCreate) {
        btnOpenCreate.addEventListener('click', () => {
            if (window.bootstrap) {
                const modalEl = document.getElementById('createLessonModal');
                const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modal.show();
            }
        });
    }

    // 4. Submit tạo mới buổi học
    const btnSubmitCreate = document.getElementById('btnSubmitCreateLesson');
    if (btnSubmitCreate) {
        const freshBtn = btnSubmitCreate.cloneNode(true);
        btnSubmitCreate.parentNode.replaceChild(freshBtn, btnSubmitCreate);
        freshBtn.addEventListener('click', async () => {
            const classId = document.getElementById('newLessonClassId').value;
            const teacherId = document.getElementById('newLessonTeacherId').value;
            const lessonDate = document.getElementById('newLessonDate').value;
            const lessonNumber = document.getElementById('newLessonNumber').value;
            const content = document.getElementById('newLessonContent').value.trim();
            const generalComment = document.getElementById('newLessonGeneralComment').value.trim();

            if (!classId || !teacherId || !lessonDate) {
                alert("Vui lòng chọn lớp học, giáo viên và ngày học!");
                return;
            }

            const payload = {
                classId: parseInt(classId),
                teacherId: parseInt(teacherId),
                lessonDate,
                lessonNumber: lessonNumber ? parseInt(lessonNumber) : null,
                content,
                generalComment,
                vocabulary: collectLessonListItems('new-vocabulary-list', 'word', 'meaning'),
                homework: collectLessonListItems('new-homework-list', 'description', 'deadline'),
                grammar: collectLessonListItems('new-grammar-list', 'rule', 'example')
            };

            try {
                freshBtn.textContent = 'Đang xử lý...';
                freshBtn.disabled = true;
                const res = await fetch('/api/lessons', {
                    method: 'POST',
                    headers: _lessonHeaders,
                    body: JSON.stringify(payload)
                });
                if (res.ok || res.status === 201) {
                    alert("Tạo buổi học mới thành công!");
                    const modalEl = document.getElementById('createLessonModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    document.getElementById('createLessonForm').reset();
                    await fetchAndRenderLessons();
                } else {
                    alert("Có lỗi xảy ra, không thể tạo buổi học!");
                }
            } catch (err) {
                console.error("Lỗi tạo buổi học:", err);
                alert("Lỗi kết nối tới Server!");
            } finally {
                freshBtn.textContent = 'Tạo mới';
                freshBtn.disabled = false;
            }
        });
    }

    // 5. Gắn events bộ lọc
    if (!document.getElementById('lesson-filter-search')?._lessonFilterBound) {
        const filterIds = ['lesson-filter-class', 'lesson-filter-search', 'lesson-filter-sort', 'lesson-filter-page-size'];
        filterIds.forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el._lessonFilterBound = true;
                el.addEventListener('input', () => { lessonCurrentPage = 1; applyLessonFilters(); });
                el.addEventListener('change', () => { lessonCurrentPage = 1; applyLessonFilters(); });
            }
        });

        const btnReset = document.getElementById('lesson-btn-reset-filter');
        if (btnReset) {
            btnReset._lessonFilterBound = true;
            btnReset.addEventListener('click', () => {
                document.getElementById('lesson-filter-class').value = '';
                document.getElementById('lesson-filter-search').value = '';
                document.getElementById('lesson-filter-sort').value = 'newest';
                document.getElementById('lesson-filter-page-size').value = '12';
                lessonCurrentPage = 1;
                applyLessonFilters();
            });
        }
    }

    // 6. Fetch và render buổi học
    await fetchAndRenderLessons();
}

async function fetchAndRenderLessons() {
    const container = document.getElementById('lesson-list-container');
    if (!container) return;
    container.innerHTML = `<div class="col-12 text-center py-4 text-muted">Đang tải dữ liệu...</div>`;

    try {
        const res = await fetch('/api/lessons', { headers: _lessonHeaders });
        if (!res.ok) throw new Error('Không thể lấy danh sách buổi học');
        const data = await res.json();
        allLessons = Array.isArray(data) ? data : (data.result ? data.result : []);
        lessonCurrentPage = 1;
        applyLessonFilters();
    } catch (err) {
        console.error("Lỗi fetch lessons:", err);
        container.innerHTML = `<div class="col-12 text-center py-4 text-danger">Không thể tải danh sách buổi học.</div>`;
    }
}

function applyLessonFilters() {
    const classId = document.getElementById('lesson-filter-class')?.value || '';
    const search = (document.getElementById('lesson-filter-search')?.value || '').toLowerCase().trim();
    const sort = document.getElementById('lesson-filter-sort')?.value || 'newest';
    const pageSize = parseInt(document.getElementById('lesson-filter-page-size')?.value || '12');

    // 1. Lọc
    let filtered = allLessons.filter(ls => {
        const matchClass = !classId || String(ls.classId) === String(classId);
        const matchSearch = !search ||
            (ls.className || '').toLowerCase().includes(search) ||
            (ls.teacherName || '').toLowerCase().includes(search) ||
            String(ls.lessonNumber || '').includes(search);
        return matchClass && matchSearch;
    });

    // 2. Sắp xếp
    filtered.sort((a, b) => {
        if (sort === 'newest') return new Date(b.lessonDate) - new Date(a.lessonDate);
        if (sort === 'oldest') return new Date(a.lessonDate) - new Date(b.lessonDate);
        const nameA = (a.className || '').toLowerCase();
        const nameB = (b.className || '').toLowerCase();
        return sort === 'az' ? nameA.localeCompare(nameB) : nameB.localeCompare(nameA);
    });

    // 3. Phân trang
    const totalItems = filtered.length;
    const totalPages = pageSize >= 9999 ? 1 : Math.ceil(totalItems / pageSize);
    if (lessonCurrentPage > totalPages) lessonCurrentPage = Math.max(1, totalPages);
    const startIndex = (lessonCurrentPage - 1) * pageSize;
    const pageItems = pageSize >= 9999 ? filtered : filtered.slice(startIndex, startIndex + pageSize);

    // 4. Cập nhật text đếm
    const countText = document.getElementById('lesson-count-text');
    if (countText) countText.textContent = `Hiển thị ${pageItems.length} / ${totalItems} buổi học`;

    // 5. Render cards
    const container = document.getElementById('lesson-list-container');
    if (!container) return;

    if (pageItems.length === 0) {
        container.innerHTML = `<div class="col-12 text-center py-4 text-muted">Không tìm thấy buổi học nào phù hợp.</div>`;
    } else {
        container.innerHTML = pageItems.map(ls => {
            const dateStr = ls.lessonDate
                ? new Date(ls.lessonDate).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' })
                : 'N/A';
            return `
            <div class="col-md-4 mb-4">
                <div class="card lesson-card-modern h-100 d-flex flex-column">
                    <div class="lesson-card-header">
                        <div class="lesson-icon-modern">
                            <i class="fa-solid fa-layer-group"></i>
                        </div>
                        <div class="lesson-header-text">
                            <h5 class="fw-bold mb-1 class-card-title text-truncate" title="${ls.className || 'Không tên'}">${ls.className || 'Không tên'}</h5>
                            <span class="badge lesson-badge-modern">Buổi ${ls.lessonNumber ?? '—'}</span>
                        </div>
                    </div>
                    <div class="lesson-card-body flex-grow-1">
                        <div class="lesson-info-row">
                            <div class="icon-bg-light icon-blue">
                                <i class="fa-regular fa-calendar"></i>
                            </div>
                            <div class="lesson-info-text">
                                <span class="info-label">Ngày học</span>
                                <span class="info-value fw-semibold text-dark">${dateStr}</span>
                            </div>
                        </div>
                        <div class="lesson-info-row mt-3">
                            <div class="icon-bg-light icon-orange">
                                <i class="fa-solid fa-chalkboard-user"></i>
                            </div>
                            <div class="lesson-info-text">
                                <span class="info-label">Giáo viên</span>
                                <span class="info-value fw-semibold text-dark text-truncate" title="${ls.teacherName || 'N/A'}">${ls.teacherName || 'N/A'}</span>
                            </div>
                        </div>
                    </div>
                    <div class="lesson-card-footer d-flex justify-content-between gap-2">
                        <button class="btn flex-grow-1 btn-edit-modern btn-edit-lesson" data-id="${ls.id}">
                            <i class="fa-regular fa-pen-to-square me-1"></i> Sửa
                        </button>
                        <button class="btn flex-grow-1 btn-delete-modern btn-delete-lesson" data-id="${ls.id}" data-name="${ls.className} - Buổi ${ls.lessonNumber ?? ''}">
                            <i class="fa-regular fa-trash-can me-1"></i> Xóa
                        </button>
                    </div>
                </div>
            </div>`;
        }).join('');

        // Gắn sự kiện nút Xóa
        container.querySelectorAll('.btn-delete-lesson').forEach(btn => {
            btn.addEventListener('click', () => {
                const lessonId = btn.getAttribute('data-id');
                const lessonName = btn.getAttribute('data-name');
                const msgEl = document.getElementById('deleteLessonMessage');
                if (msgEl) {
                    msgEl.innerHTML = `Bạn có chắc chắn muốn xóa <strong>"${lessonName}"</strong>?<br>Hành động này không thể hoàn tác.`;
                }
                const deleteModalEl = document.getElementById('deleteLessonModal');
                const deleteModal = bootstrap.Modal.getInstance(deleteModalEl) || new bootstrap.Modal(deleteModalEl);
                deleteModal.show();

                const btnConfirm = document.getElementById('btnConfirmDeleteLesson');
                const newBtnConfirm = btnConfirm.cloneNode(true);
                btnConfirm.parentNode.replaceChild(newBtnConfirm, btnConfirm);

                newBtnConfirm.addEventListener('click', async () => {
                    try {
                        newBtnConfirm.textContent = 'Đang xóa...';
                        newBtnConfirm.disabled = true;
                        const delRes = await fetch(`/api/lessons/${lessonId}`, { method: 'DELETE', headers: _lessonHeaders });
                        if (delRes.ok || delRes.status === 204) {
                            deleteModal.hide();
                            await fetchAndRenderLessons();
                        } else {
                            alert("Không thể xóa buổi học. Vui lòng thử lại!");
                        }
                    } catch (err) {
                        console.error("Lỗi xóa buổi học:", err);
                        alert("Lỗi kết nối tới Server!");
                    } finally {
                        newBtnConfirm.textContent = 'Xóa';
                        newBtnConfirm.disabled = false;
                    }
                });
            });
        });

        // Gắn sự kiện nút Sửa
        container.querySelectorAll('.btn-edit-lesson').forEach(btn => {
            btn.addEventListener('click', () => {
                const ls = allLessons.find(l => String(l.id) === btn.getAttribute('data-id'));
                if (ls) openEditLessonModal(ls);
            });
        });
        container.querySelectorAll('.lesson-card-modern').forEach(card => {
            card.style.cursor = 'pointer';
            card.addEventListener('click', (e) => {
                if (e.target.closest('.lesson-card-footer')) return; // Nếu bấm vào nút thì không làm gì cả
                const lessonId = card.querySelector('.btn-edit-lesson').getAttribute('data-id');
                viewLessonDetail(lessonId);
            })
        })
    }

    // 6. Render pagination
    renderLessonPagination(totalPages);
}
async function viewLessonDetail(lessonId) {
    const lesson = allLessons.find(l => String(l.id) === lessonId);
    if (!lesson) {
        alert("Không tìm thấy thông tin buổi học!");
        return;
    }
    await renderLessonDetailView(lesson);
}

async function renderLessonDetailView(lesson) {
    const contentArea = document.querySelector('.dashboard-wrap .main-content');
    if (!contentArea) return;

    const token = localStorage.getItem('accessToken');
    const headers = { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' };

    const dateStr = lesson.lessonDate
        ? new Date(lesson.lessonDate).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' })
        : 'N/A';

    contentArea.innerHTML = `
    <div class="content" id="lesson-detail-page">
        <!-- Toolbar -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <button class="btn px-3 py-2 fw-medium" id="btn-back-to-lessons"
                style="border:1.5px solid var(--primary-color);color:var(--primary-color);border-radius:10px;background:#fff;font-size:14px;">
                <i class="fa-solid fa-arrow-left me-2"></i>Quay lại
            </button>
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn px-3 py-2 fw-medium" id="btn-export-lesson-csv"
                    style="border:1.5px solid #16a34a;color:#16a34a;border-radius:10px;background:#fff;font-size:14px;">
                    <i class="fa-solid fa-file-excel me-2"></i>Xuất Excel
                </button>
                <button class="btn px-3 py-2 fw-medium btn-edit-lesson-detail" data-id="${lesson.id}"
                    style="border:1.5px solid #f59e0b;color:#f59e0b;border-radius:10px;background:#fff;font-size:14px;">
                    <i class="fa-regular fa-pen-to-square me-2"></i>Sửa
                </button>
                <button class="btn px-3 py-2 fw-medium btn-delete-lesson-detail" data-id="${lesson.id}"
                    style="border:1.5px solid #e53e3e;color:#e53e3e;border-radius:10px;background:#fff;font-size:14px;">
                    <i class="fa-regular fa-trash-can me-2"></i>Xóa
                </button>
            </div>
        </div>

        <!-- Lesson Info Card -->
        <div class="card stat-card-box p-4 mb-4" style="border-radius:16px;">
            <div class="d-flex align-items-center gap-4">
                <div style="width:56px;height:56px;border-radius:14px;background:linear-gradient(135deg,#6366f1,#818cf8);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <i class="fa-solid fa-book-open text-white fs-4"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-1" style="color:#1e293b;font-size:22px;">
                        ${lesson.className || 'Không tên'} – Số buổi ${lesson.lessonNumber ?? '—'}
                    </h3>
                    <div class="d-flex flex-wrap gap-4 mt-2">
                        <div>
                            <span class="text-muted" style="font-size:12px;font-weight:600;letter-spacing:0.4px;display:block;">
                                <i class="fa-regular fa-calendar me-1"></i>Ngày học
                            </span>
                            <span class="fw-semibold" style="color:#1e293b;font-size:15px;">${dateStr}</span>
                        </div>
                        <div>
                            <span class="text-muted" style="font-size:12px;font-weight:600;letter-spacing:0.4px;display:block;">
                                <i class="fa-solid fa-chalkboard-user me-1"></i>Giáo viên
                            </span>
                            <span class="fw-semibold" style="color:#1e293b;font-size:15px;">${lesson.teacherName || 'N/A'}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Nội dung buổi học -->
        <div class="card stat-card-box p-4 mb-4" style="border-radius:16px;">
            <h5 class="fw-bold mb-2" style="color:#1e293b;">Nội dung buổi học</h5>
            <p class="mb-0" style="color:#475569;font-size:15px;white-space:pre-wrap;">${lesson.content || '<span class="text-muted fst-italic">Không có nội dung</span>'}</p>
        </div>

        <!-- Nhận xét chung -->
        <div class="card stat-card-box p-4 mb-4" style="border-radius:16px;">
            <h5 class="fw-bold mb-2" style="color:#1e293b;">Nhận xét chung</h5>
            <p class="mb-0" style="color:#475569;font-size:15px;white-space:pre-wrap;">${lesson.generalComment || '<span class="text-muted fst-italic">Không có nhận xét</span>'}</p>
        </div>

        <!-- Bảng nhận xét học sinh -->
        <div class="mb-2">
            <h5 class="fw-bold mb-1" style="color:#1e293b;">Nhận xét học sinh</h5>
            <p class="text-muted mb-3" style="font-size:14px;">Danh sách điểm danh và nhận xét từng học sinh</p>
        </div>
        <div class="card stat-card-box p-0 mb-4" style="border-radius:16px;overflow:hidden;">
            <div style="overflow-x:auto;">
                <table class="table table-hover mb-0" id="lesson-review-table">
                    <thead style="background:#f5f3ff;">
                        <tr>
                            <th class="px-4 py-3 fw-semibold text-muted" style="font-size:13px;width:50px;">#</th>
                            <th class="px-3 py-3 fw-semibold text-muted" style="font-size:13px;">
                                Tên học sinh<br>
                                <span style="font-size:11px;font-weight:400;color:#a78bfa;">(Xem nhận xét buổi trước)</span>
                            </th>
                            <th class="px-3 py-3 fw-semibold text-muted text-center" style="font-size:13px;">Điểm danh</th>
                            <th class="px-3 py-3 fw-semibold text-muted text-center" style="font-size:13px;">Vocab</th>
                            <th class="px-3 py-3 fw-semibold text-muted text-center" style="font-size:13px;">Điểm thi</th>
                            <th class="px-3 py-3 fw-semibold text-muted text-center" style="font-size:13px;">BTVN</th>
                            <th class="px-3 py-3 fw-semibold text-muted" style="font-size:13px;">Nhận xét</th>
                            <th class="px-3 py-3 fw-semibold text-muted text-center" style="font-size:13px;">Lưu</th>
                        </tr>
                    </thead>
                    <tbody id="lesson-review-tbody">
                        <tr><td colspan="8" class="text-center py-4 text-muted">Đang tải dữ liệu...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>`;

    // Nút Quay lại
    document.getElementById('btn-back-to-lessons')?.addEventListener('click', () => {
        loadDashboardContent('lesson', initLessonPage);
    });

    // Nút Sửa
    document.querySelector('.btn-edit-lesson-detail')?.addEventListener('click', () => {
        loadDashboardContent('lesson', () => {
            setTimeout(() => openEditLessonModal(lesson), 300);
        });
    });

    // Nút Xóa
    document.querySelector('.btn-delete-lesson-detail')?.addEventListener('click', async () => {
        if (!confirm(`Bạn có chắc chắn muốn xóa "${lesson.className} - Buổi ${lesson.lessonNumber ?? ''}"?`)) return;
        try {
            const res = await fetch(`/api/lessons/${lesson.id}`, { method: 'DELETE', headers });
            if (res.ok || res.status === 204) {
                loadDashboardContent('lesson', initLessonPage);
            } else {
                alert('Không thể xóa buổi học. Vui lòng thử lại!');
            }
        } catch (err) {
            console.error('Lỗi xóa buổi học:', err);
            alert('Lỗi kết nối tới Server!');
        }
    });

    // Fetch học sinh và nhận xét
    let students = [];
    let existingComments = {};
    try {
        const [resStudents, resComments] = await Promise.all([
            fetch(`/api/students/class/${lesson.classId}`, { headers }),
            fetch(`/api/Comments/lesson/${lesson.id}`, { headers })
        ]);
        if (resStudents.ok) {
            const data = await resStudents.json();
            students = Array.isArray(data) ? data : (data.result || data.data || []);
        }
        if (resComments.ok) {
            const cmts = await resComments.json();
            const arr = Array.isArray(cmts) ? cmts : (cmts.result || cmts.data || []);
            arr.forEach(c => { existingComments[c.studentId] = c; });
        }
    } catch (err) {
        console.error('Lỗi tải dữ liệu chi tiết lesson:', err);
    }

    const tbody = document.getElementById('lesson-review-tbody');
    if (!tbody) return;

    if (students.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">Không có học sinh trong lớp này.</td></tr>';
    } else {
        tbody.innerHTML = students.map((st, idx) => {
            const cmt = existingComments[st.id] || {};
            const cmtId = cmt.id || '';
            const attVal = ['C','V','M'].includes(cmt.schoolExamScore) ? cmt.schoolExamScore : 'C';
            const classScore = (cmt.schoolExamScore && !['C','V','M'].includes(cmt.schoolExamScore)) ? cmt.schoolExamScore : '';
            const colors = { C: '#16a34a', V: '#e53e3e', M: '#f59e0b' };
            const icons = { C: 'fa-solid fa-check', V: 'fa-solid fa-xmark', M: 'fa-regular fa-clock' };
            const attLabels = {
                C: '<span style="color:#16a34a;font-size:11px;font-weight:600;">Có mặt</span>',
                V: '<span style="color:#e53e3e;font-size:11px;font-weight:600;">Vắng</span>',
                M: '<span style="color:#f59e0b;font-size:11px;font-weight:600;">Muộn</span>'
            };
            const makeBtn = val => `<button type="button" class="btn-att-detail" data-val="${val}" title="${val==='C'?'Có mặt':val==='V'?'Vắng':'Muộn'}"
                style="width:30px;height:30px;border-radius:50%;border:1.5px solid ${colors[val]};
                background:${attVal===val?colors[val]:'#fff'};color:${attVal===val?'#fff':colors[val]};
                cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.2s;">
                <i class="${icons[val]}" style="font-size:11px;pointer-events:none;"></i>
            </button>`;

            return `
            <tr data-student-id="${st.id}" data-comment-id="${cmtId}" data-att-val="${attVal}">
                <td class="px-4 py-3 text-muted fw-medium">${idx + 1}</td>
                <td class="px-3 py-3 fw-semibold" style="color:#1e293b;">${st.fullName || st.name || 'N/A'}</td>
                <td class="px-3 py-3 text-center">
                    <div class="d-flex flex-column align-items-center gap-1">
                        <div class="d-flex gap-1">${makeBtn('C')}${makeBtn('V')}${makeBtn('M')}</div>
                        <span class="att-label-text">${attLabels[attVal]}</span>
                    </div>
                </td>
                <td class="px-3 py-3 text-center">
                    <input type="text" class="form-control form-control-sm text-center rv-vocab"
                        value="${cmt.vocabularyScore || ''}" placeholder="/10"
                        style="width:65px;margin:auto;border-radius:8px;border-color:rgba(99,102,241,0.3);">
                </td>
                <td class="px-3 py-3 text-center">
                    <input type="text" class="form-control form-control-sm text-center rv-school"
                        value="${classScore}" placeholder="..."
                        style="width:65px;margin:auto;border-radius:8px;border-color:rgba(99,102,241,0.3);">
                </td>
                <td class="px-3 py-3 text-center">
                    <select class="form-select form-select-sm rv-btvn"
                        style="width:110px;margin:auto;border-radius:8px;border-color:rgba(99,102,241,0.3);font-size:13px;">
                        <option value="">--</option>
                        <option value="Đủ BT" ${['Đủ BT','Đủ'].includes(cmt.homeworkStatus)?'selected':''}>Đủ BT</option>
                        <option value="Thiếu BT" ${['Thiếu BT','Thiếu'].includes(cmt.homeworkStatus)?'selected':''}>Thiếu BT</option>
                        <option value="Không BT" ${['Không BT','Không'].includes(cmt.homeworkStatus)?'selected':''}>Không BT</option>
                    </select>
                </td>
                <td class="px-3 py-3">
                    <textarea class="form-control form-control-sm rv-comment" rows="2"
                        placeholder="Nhập nhận xét..."
                        style="border-radius:8px;border-color:rgba(99,102,241,0.3);min-width:160px;font-size:13px;resize:vertical;">${cmt.comment || ''}</textarea>
                </td>
                <td class="px-3 py-3 text-center">
                    <button class="btn btn-sm fw-semibold btn-save-lesson-review"
                        style="background:linear-gradient(135deg,#6366f1,#818cf8);color:#fff;border:none;border-radius:8px;padding:6px 14px;white-space:nowrap;font-size:13px;">
                        ${cmtId ? '<i class="fa-solid fa-pen me-1"></i>Cập nhật' : '<i class="fa-solid fa-floppy-disk me-1"></i>Lưu'}
                    </button>
                </td>
            </tr>`;
        }).join('');

        // Sự kiện toggle điểm danh
        const attColors = { C: '#16a34a', V: '#e53e3e', M: '#f59e0b' };
        const attLabelHTML = {
            C: '<span style="color:#16a34a;font-size:11px;font-weight:600;">Có mặt</span>',
            V: '<span style="color:#e53e3e;font-size:11px;font-weight:600;">Vắng</span>',
            M: '<span style="color:#f59e0b;font-size:11px;font-weight:600;">Muộn</span>'
        };
        tbody.querySelectorAll('tr[data-student-id]').forEach(row => {
            row.querySelectorAll('.btn-att-detail').forEach(btn => {
                btn.addEventListener('click', () => {
                    const val = btn.getAttribute('data-val');
                    row.dataset.attVal = val;
                    row.querySelectorAll('.btn-att-detail').forEach(b => {
                        const c = attColors[b.getAttribute('data-val')];
                        b.style.background = '#fff';
                        b.style.color = c;
                    });
                    btn.style.background = attColors[val];
                    btn.style.color = '#fff';
                    row.querySelector('.att-label-text').innerHTML = attLabelHTML[val];
                });
            });
        });

        // Sự kiện nút Lưu/Cập nhật
        tbody.querySelectorAll('.btn-save-lesson-review').forEach(btn => {
            btn.addEventListener('click', async () => {
                const row = btn.closest('tr');
                const studentId = row.dataset.studentId;
                const commentId = row.dataset.commentId;
                const attVal = row.dataset.attVal || 'C';
                const schoolVal = row.querySelector('.rv-school').value.trim();
                const finalSchoolExamScore = schoolVal ? schoolVal : attVal;

                const payload = {
                    lessonId: parseInt(lesson.id),
                    lessonDate: lesson.lessonDate || new Date().toISOString().split('T')[0],
                    className: lesson.className || '',
                    studentId: parseInt(studentId),
                    studentName: row.querySelector('td:nth-child(2)').textContent.trim(),
                    vocabularyScore: row.querySelector('.rv-vocab').value.trim(),
                    schoolExamScore: finalSchoolExamScore,
                    homeworkStatus: row.querySelector('.rv-btvn').value,
                    comment: row.querySelector('.rv-comment').value.trim()
                };

                const isUpdate = !!commentId;
                const url = isUpdate ? `/api/Comments/${commentId}` : `/api/Comments`;
                const method = isUpdate ? 'PUT' : 'POST';

                try {
                    btn.disabled = true;
                    btn.innerHTML = '...';
                    const res = await fetch(url, { method, headers, body: JSON.stringify(payload) });
                    if (res.ok || res.status === 201) {
                        const savedData = await res.json();
                        if (!isUpdate && savedData?.id) row.dataset.commentId = savedData.id;
                        btn.innerHTML = '<i class="fa-solid fa-check me-1"></i>Đã lưu';
                        btn.style.background = 'linear-gradient(135deg,#16a34a,#22c55e)';
                        setTimeout(() => {
                            btn.innerHTML = '<i class="fa-solid fa-pen me-1"></i>Cập nhật';
                            btn.style.background = 'linear-gradient(135deg,#6366f1,#818cf8)';
                            btn.disabled = false;
                        }, 2000);
                    } else {
                        alert('Lỗi lưu nhận xét! Vui lòng thử lại.');
                        btn.innerHTML = isUpdate ? '<i class="fa-solid fa-pen me-1"></i>Cập nhật' : '<i class="fa-solid fa-floppy-disk me-1"></i>Lưu';
                        btn.disabled = false;
                    }
                } catch (err) {
                    console.error('Lỗi lưu nhận xét:', err);
                    alert('Lỗi kết nối tới Server!');
                    btn.innerHTML = isUpdate ? '<i class="fa-solid fa-pen me-1"></i>Cập nhật' : '<i class="fa-solid fa-floppy-disk me-1"></i>Lưu';
                    btn.disabled = false;
                }
            });
        });
    }

    // Xuất CSV
    document.getElementById('btn-export-lesson-csv')?.addEventListener('click', () => {
        const rows = [['#', 'Học sinh', 'Điểm danh', 'Vocab', 'Điểm thi', 'BTVN', 'Nhận xét']];
        const attMap = { C: 'Có mặt', V: 'Vắng', M: 'Muộn' };
        tbody.querySelectorAll('tr[data-student-id]').forEach((tr, idx) => {
            rows.push([
                idx + 1,
                tr.querySelector('td:nth-child(2)')?.textContent?.trim() || '',
                attMap[tr.dataset.attVal] || 'Có mặt',
                tr.querySelector('.rv-vocab')?.value || '',
                tr.querySelector('.rv-school')?.value || '',
                tr.querySelector('.rv-btvn')?.value || '',
                tr.querySelector('.rv-comment')?.value || ''
            ]);
        });
        const csvContent = '\uFEFF' + rows.map(r => r.map(c => `"${String(c).replace(/"/g, '""')}"`).join(',')).join('\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `NhanXet_${lesson.className}_Buoi${lesson.lessonNumber || ''}_${lesson.lessonDate || ''}.csv`;
        a.click();
        URL.revokeObjectURL(url);
    });
}
function renderLessonPagination(totalPages) {
    const paginationEl = document.getElementById('lesson-pagination-controls');
    if (!paginationEl) return;
    if (totalPages <= 1) { paginationEl.innerHTML = ''; return; }

    const btnStyle = (isActive) =>
        `style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid ${isActive ? 'var(--primary-color)' : '#E0E5F2'};background:${isActive ? 'var(--primary-color)' : 'white'};color:${isActive ? 'white' : '#4a5568'};font-weight:500;font-size:14px;cursor:pointer;transition:all 0.2s ease;"`;

    let html = `<button onclick="changeLessonPage(${lessonCurrentPage - 1})" ${lessonCurrentPage === 1 ? 'disabled' : ''}
        style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid #E0E5F2;background:white;color:#4a5568;font-weight:500;font-size:14px;cursor:pointer;">‹</button>`;
    for (let i = 1; i <= totalPages; i++) {
        html += `<button onclick="changeLessonPage(${i})" ${btnStyle(i === lessonCurrentPage)}>${i}</button>`;
    }
    html += `<button onclick="changeLessonPage(${lessonCurrentPage + 1})" ${lessonCurrentPage === totalPages ? 'disabled' : ''}
        style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid #E0E5F2;background:white;color:#4a5568;font-weight:500;font-size:14px;cursor:pointer;">›</button>`;
    paginationEl.innerHTML = html;
}

function changeLessonPage(page) {
    const pageSize = parseInt(document.getElementById('lesson-filter-page-size')?.value || '12');
    const totalPages = Math.ceil(allLessons.length / pageSize);
    if (page < 1 || page > totalPages) return;
    lessonCurrentPage = page;
    applyLessonFilters();
}

async function openEditLessonModal(ls) {
    // 1. Điền các trường cơ bản
    document.getElementById('editLessonId').value = ls.id;
    document.getElementById('editLessonDate').value = ls.lessonDate || '';
    document.getElementById('editLessonNumber').value = ls.lessonNumber ?? '';
    document.getElementById('editLessonContent').value = ls.content || '';
    document.getElementById('editLessonGeneralComment').value = ls.generalComment || '';

    // 2. Chọn sẵn lớp học
    const classSelect = document.getElementById('editLessonClassId');
    if (classSelect) {
        [...classSelect.options].forEach(opt => {
            opt.selected = String(opt.value) === String(ls.classId);
        });
    }

    // 3. Chọn sẵn giáo viên
    const teacherSelect = document.getElementById('editLessonTeacherId');
    if (teacherSelect) {
        [...teacherSelect.options].forEach(opt => {
            opt.selected = String(opt.value) === String(ls.teacherId);
        });
    }

    // 4. Render sẵn danh sách Từ vựng
    const vocabList = document.getElementById('edit-vocabulary-list');
    if (vocabList) {
        vocabList.innerHTML = '';
        const items = Array.isArray(ls.vocabulary) ? ls.vocabulary : [];
        if (items.length === 0) {
            vocabList.innerHTML = `<p class="text-muted text-center mb-0" style="font-size:13px;">Không có dữ liệu</p>`;
        } else {
            items.forEach(item => addLessonListItem('edit-vocabulary-list', 'word', 'translation', item.word, item.translation));
        }
    }

    // 5. Render sẵn danh sách Bài tập về nhà
    const hwList = document.getElementById('edit-homework-list');
    if (hwList) {
        hwList.innerHTML = '';
        const items = Array.isArray(ls.homework) ? ls.homework : [];
        if (items.length === 0) {
            hwList.innerHTML = `<p class="text-muted text-center mb-0" style="font-size:13px;">Không có dữ liệu</p>`;
        } else {
            items.forEach(item => addLessonListItem('edit-homework-list', 'page', 'description', item.page, item.description));
        }
    }

    // 6. Render sẵn danh sách Ngữ pháp
    const grList = document.getElementById('edit-grammar-list');
    if (grList) {
        grList.innerHTML = '';
        const items = Array.isArray(ls.grammar) ? ls.grammar : [];
        if (items.length === 0) {
            grList.innerHTML = `<p class="text-muted text-center mb-0" style="font-size:13px;">Không có dữ liệu</p>`;
        } else {
            items.forEach(item => addLessonListItem('edit-grammar-list', 'topic', 'description', item.topic, item.description));
        }
    }

    // 7. Mở modal
    const editModalEl = document.getElementById('editLessonModal');
    const editModal = bootstrap.Modal.getInstance(editModalEl) || new bootstrap.Modal(editModalEl);
    editModal.show();

    // 8. Nút Lưu thay đổi
    const btnSubmit = document.getElementById('btnSubmitEditLesson');
    const newBtn = btnSubmit.cloneNode(true);
    btnSubmit.parentNode.replaceChild(newBtn, btnSubmit);

    newBtn.addEventListener('click', async () => {
        const classId = document.getElementById('editLessonClassId').value;
        const teacherId = document.getElementById('editLessonTeacherId').value;
        const lessonDate = document.getElementById('editLessonDate').value;
        const lessonNumber = document.getElementById('editLessonNumber').value;
        const content = document.getElementById('editLessonContent').value.trim();
        const generalComment = document.getElementById('editLessonGeneralComment').value.trim();
        const lessonId = document.getElementById('editLessonId').value;

        if (!classId || !teacherId || !lessonDate) {
            alert("Vui lòng chọn lớp học, giáo viên và ngày học!");
            return;
        }

        const payload = {
            classId: parseInt(classId),
            teacherId: parseInt(teacherId),
            lessonDate,
            lessonNumber: lessonNumber ? parseInt(lessonNumber) : null,
            content,
            generalComment,
            vocabulary: collectLessonListItems('edit-vocabulary-list', 'word', 'translation'),
            homework: collectLessonListItems('edit-homework-list', 'page', 'description'),
            grammar: collectLessonListItems('edit-grammar-list', 'topic', 'description')
        };

        try {
            newBtn.textContent = 'Đang lưu...';
            newBtn.disabled = true;
            const res = await fetch(`/api/lessons/${lessonId}`, {
                method: 'PUT',
                headers: _lessonHeaders,
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                editModal.hide();
                await fetchAndRenderLessons();
            } else {
                alert("Có lỗi xảy ra, không thể cập nhật buổi học!");
            }
        } catch (err) {
            console.error("Lỗi sửa buổi học:", err);
            alert("Lỗi kết nối tới Server!");
        } finally {
            newBtn.textContent = 'Lưu thay đổi';
            newBtn.disabled = false;
        }
    });
}

/**
 * Thêm 1 hàng nhập liệu vào danh sách động (từ vựng / bài tập / ngữ pháp)
 * @param {string} containerId - ID của div chứa
 * @param {string} field1 - tên field cột 1 (word / description / rule)
 * @param {string} field2 - tên field cột 2 (meaning / deadline / example)
 * @param {string} val1 - giá trị mặc định cột 1
 * @param {string} val2 - giá trị mặc định cột 2
 */
function addLessonListItem(containerId, field1, field2, val1 = '', val2 = '') {
    const container = document.getElementById(containerId);
    if (!container) return;

    // Xóa dòng "Không có dữ liệu" nếu còn
    const empty = container.querySelector('p.text-muted');
    if (empty) empty.remove();

    const placeholder1 = { word: 'Từ vựng', page: 'Trang', topic: 'Chủ đề ngữ pháp' }[field1] || field1;
    const placeholder2 = { translation: 'Nghĩa', description: 'Mô tả', example: 'Ví dụ' }[field2] || field2;

    const row = document.createElement('div');
    row.className = 'd-flex gap-2 align-items-center';
    row.innerHTML = `
        <input type="text" class="form-control form-control-sm lesson-list-field1"
            data-field="${field1}" placeholder="${placeholder1}" value="${val1}"
            style="border-radius:6px; border-color:#E0E5F2; font-size:13px;">
        <input type="text" class="form-control form-control-sm lesson-list-field2"
            data-field="${field2}" placeholder="${placeholder2}" value="${val2}"
            style="border-radius:6px; border-color:#E0E5F2; font-size:13px;">
        <button type="button" class="btn btn-sm btn-delete-class px-2 py-1 flex-shrink-0"
            style="font-size:13px; border-radius:6px;" onclick="this.closest('.d-flex').remove()">✕</button>
    `;
    container.appendChild(row);
}

/**
 * Thu thập dữ liệu từ các hàng trong danh sách động
 */
function collectLessonListItems(containerId, field1, field2) {
    const container = document.getElementById(containerId);
    if (!container) return [];
    const rows = container.querySelectorAll('.d-flex.align-items-center');
    return [...rows].map(row => {
        const inputs = row.querySelectorAll('input');
    }).filter(item => item[field1]);
}

// ==========================================
// LOGIC MODULE NHẬN XÉT (REVIEW PAGE)
// ==========================================

let reviewAllStudents = [];
let reviewAllComments = [];

async function initReviewPage() {
    await fetchAndRenderReviewClasses();

    const classSelect = document.getElementById('review-select-class');
    const lessonSelect = document.getElementById('review-select-lesson');

    if (classSelect) {
        classSelect.addEventListener('change', async (e) => {
            const classId = e.target.value;
            if (classId) {
                await fetchAndRenderReviewLessons(classId);
            }
        });
    }

    if (lessonSelect) {
        lessonSelect.addEventListener('change', async (e) => {
            const lessonId = e.target.value;
            const classId = document.getElementById('review-select-class')?.value;
            if (lessonId && classId) {
                // Populate Info Card
                const lsOpt = lessonSelect.options[lessonSelect.selectedIndex];
                document.getElementById('review-info-class-name').textContent = classSelect.options[classSelect.selectedIndex].text;
                document.getElementById('review-info-level').textContent = 'Học sinh'; // Placeholder level
                const [datePart, ...rest] = (lsOpt.text || '').split(' - ');
                document.getElementById('review-info-date').textContent = datePart || '-';
                document.getElementById('review-info-number').textContent = rest.join(' ') || '-';
                // Note: teacher is not directly on lesson list text, could fetch from lsOpt dataset if injected
                if (lsOpt.dataset.teacher) document.getElementById('review-info-teacher').textContent = lsOpt.dataset.teacher;

                document.getElementById('review-lesson-info-card').style.display = 'block';

                await fetchReviewRoster(classId, lessonId);
            }
        });
    }
}

async function fetchAndRenderReviewClasses() {
    try {
        const res = await fetch('/api/classes', { headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` } });
        if (!res.ok) return;
        const classes = await res.json();
        const select = document.getElementById('review-select-class');
        if (!select) return;
        select.innerHTML = '<option value="" disabled selected>-- Chọn lớp học --</option>';
        classes.forEach(c => {
            const opt = document.createElement('option');
            opt.value = c.id;
            opt.textContent = c.name;
            select.appendChild(opt);
        });
    } catch (err) {
        console.error("Lỗi fetch classes review:", err);
    }
}

async function fetchAndRenderReviewLessons(classId) {
    try {
        const res = await fetch('/api/lessons', { headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` } });
        if (!res.ok) return;
        let lessons = await res.json();
        // Lọc theo classId
        lessons = lessons.filter(l => String(l.classId) === String(classId));
        // Sắp xếp giảm dần theo ngày
        lessons.sort((a, b) => new Date(b.lessonDate) - new Date(a.lessonDate));

        const select = document.getElementById('review-select-lesson');
        if (!select) return;
        select.innerHTML = '<option value="" disabled selected>-- Chọn buổi học --</option>';
        lessons.forEach(l => {
            const opt = document.createElement('option');
            opt.value = l.id;
            opt.dataset.teacher = l.teacherName || '';
            opt.dataset.lessonDate = l.lessonDate;
            const dateStr = l.lessonDate ? l.lessonDate.split('-').reverse().join('/') : 'N/A';
            opt.textContent = `${dateStr} - Số buổi ${l.lessonNumber || '?'}`;
            select.appendChild(opt);
        });

        // Disable table mapping until lesson is chosen
        document.getElementById('review-table-body').innerHTML = `<tr><td colspan="9" class="text-center py-5"><div class="d-flex flex-column align-items-center text-muted"><i class="fa-solid fa-inbox fs-2 mb-3 text-light"></i><p class="mb-0 fs-5">Vui lòng chọn buổi học để xem danh sách.</p></div></td></tr>`;
        document.getElementById('review-lesson-info-card').style.display = 'none';

    } catch (err) {
        console.error("Lỗi fetch lessons review:", err);
    }
}

async function fetchReviewRoster(classId, lessonId) {
    try {
        const tbody = document.getElementById('review-table-body');
        tbody.innerHTML = `<tr><td colspan="9" class="text-center py-5 text-muted">Đang tải dữ liệu...</td></tr>`;

        const authHeaders = { 'Authorization': `Bearer ${localStorage.getItem('token')}` };

        // 1. Get all students in this class
        const stuRes = await fetch(`/api/students/class/${classId}`, { headers: authHeaders });
        reviewAllStudents = stuRes.ok ? await stuRes.json() : [];

        // 2. Get all comments for this lesson
        const cmtRes = await fetch(`/api/Comments/lesson/${lessonId}`, { headers: authHeaders });
        reviewAllComments = cmtRes.ok ? await cmtRes.json() : [];

        // 3. Render joined table
        renderReviewTable();

    } catch (err) {
        console.error("Lỗi tải lớp học/nhận xét:", err);
        document.getElementById('review-table-body').innerHTML = `<tr><td colspan="9" class="text-center py-5"><div class="d-flex flex-column align-items-center text-danger"><i class="fa-solid fa-circle-exclamation fs-2 mb-3 text-danger opacity-75"></i><p class="mb-0 fs-5">Có lỗi xảy ra khi tải dữ liệu!</p></div></td></tr>`;
    }
}

function renderReviewTable() {
    const tbody = document.getElementById('review-table-body');
    if (!tbody) return;

    if (reviewAllStudents.length === 0) {
        tbody.innerHTML = `<tr><td colspan="9" class="text-center py-5"><div class="d-flex flex-column align-items-center text-muted"><i class="fa-solid fa-user-xmark fs-2 mb-3 text-light"></i><p class="mb-0 fs-5">Lớp học này chưa có học sinh nào.</p></div></td></tr>`;
        return;
    }

    let html = '';
    reviewAllStudents.forEach((st, idx) => {
        // Tìm xem học sinh này đã có nhận xét trong lesson này chưa
        const cmt = reviewAllComments.find(c => String(c.studentId) === String(st.id)) || {};
        const cmtId = cmt.id || ''; // Nếu có id thì là PUT, nếu rỗng là POST

        html += `
            <tr data-student-id="${st.id}" data-comment-id="${cmtId}">
                <td class="text-center"><input class="form-check-input shadow-sm" type="checkbox"></td>
                <td class="text-secondary fw-medium" style="font-size:13px;">${idx + 1}</td>
                <td class="fw-bold" style="font-size:14px; color:#1e293b;">${st.fullName || st.name || 'N/A'}</td>
                <td class="text-center">
                    <select class="form-select form-select-sm rv-attendance shadow-sm" style="width: 85px; font-size:13px; margin:0 auto; border-radius: 8px; border: 1px solid #cbd5e1;">
                        <option value="C" ${cmt.schoolExamScore === 'C' ? 'selected' : ''}>Có</option>
                        <option value="V" ${cmt.schoolExamScore === 'V' ? 'selected' : ''}>Vắng</option>
                    </select>
                </td>
                <td class="text-center">
                    <input type="text" class="form-control form-control-sm rv-vocab shadow-sm" value="${cmt.vocabularyScore || ''}" placeholder="/10" style="width: 75px; font-size:13px; margin:0 auto; text-align:center; border-radius: 8px; border: 1px solid #cbd5e1;">
                </td>
                <td class="text-center">
                    <input type="text" class="form-control form-control-sm rv-school shadow-sm" value="${cmt.schoolExamScore && cmt.schoolExamScore !== 'C' && cmt.schoolExamScore !== 'V' ? cmt.schoolExamScore : ''}" placeholder="..." style="width: 75px; font-size:13px; margin:0 auto; text-align:center; border-radius: 8px; border: 1px solid #cbd5e1;">
                </td>
                <td class="text-center">
                    <select class="form-select form-select-sm rv-btvn shadow-sm" style="width: 85px; font-size:13px; margin:0 auto; border-radius: 8px; border: 1px solid #cbd5e1;">
                        <option value="">--</option>
                        <option value="Đủ" ${cmt.homeworkStatus === 'Đủ' ? 'selected' : ''}>Đủ</option>
                        <option value="Thiếu" ${cmt.homeworkStatus === 'Thiếu' ? 'selected' : ''}>Thiếu</option>
                        <option value="Không" ${cmt.homeworkStatus === 'Không' ? 'selected' : ''}>Không</option>
                    </select>
                </td>
                <td>
                    <textarea class="form-control form-control-sm rv-comment shadow-sm" rows="1" placeholder="Nhập nhận xét..." style="font-size:13px; border-radius: 8px; border: 1px solid #cbd5e1; resize: none;">${cmt.comment || ''}</textarea>
                </td>
                <td class="text-center">
                    <button class="btn btn-sm text-white px-3 fw-semibold shadow-sm btn-save-rv" onclick="saveReviewRow(this)" style="background: linear-gradient(135deg, #7b4bef, #9d7cf3); border-radius: 8px; font-size: 13px; border: none; white-space: nowrap;">
                        ${cmtId ? '<i class="fa-solid fa-pen me-1"></i>Cập nhật' : '<i class="fa-solid fa-floppy-disk me-1"></i>Lưu'}
                    </button>
                </td>
            </tr>
        `;
    });
    tbody.innerHTML = html;
    document.getElementById('review-count-text').textContent = `Hiển thị ${reviewAllStudents.length} mục`;
}

async function saveReviewRow(btnElement) {
    const row = btnElement.closest('tr');
    const studentId = row.dataset.studentId;
    const commentId = row.dataset.commentId;
    const lessonId = document.getElementById('review-select-lesson').value;
    const classId = document.getElementById('review-select-class').value;
    const lsOpt = document.getElementById('review-select-lesson').selectedOptions[0];

    const attVal = row.querySelector('.rv-attendance').value;
    const schoolVal = row.querySelector('.rv-school').value;
    const finalSchoolExamScore = schoolVal ? schoolVal : attVal;

    const payload = {
        lessonId: parseInt(lessonId),
        lessonDate: lsOpt.dataset.lessonDate || new Date().toISOString().split('T')[0],
        className: document.getElementById('review-select-class').selectedOptions[0].text,
        studentId: parseInt(studentId),
        studentName: row.querySelector('td:nth-child(3)').textContent.trim(),
        vocabularyScore: row.querySelector('.rv-vocab').value.trim(),
        schoolExamScore: finalSchoolExamScore,
        homeworkStatus: row.querySelector('.rv-btvn').value,
        comment: row.querySelector('.rv-comment').value.trim()
    };

    const isUpdate = !!commentId;
    const url = isUpdate ? `/api/Comments/${commentId}` : `/api/Comments`;
    const method = isUpdate ? 'PUT' : 'POST';

    try {
        btnElement.disabled = true;
        btnElement.textContent = '...';

        const res = await fetch(url, {
            method: method,
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('token')}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        });

        if (res.ok) {
            const savedData = await res.json();
            row.dataset.commentId = savedData.id || row.dataset.commentId; // Gắn lại ID mới nếu vừa POST thành công
            btnElement.innerHTML = '<i class="fa-solid fa-check me-1"></i>Đã lưu';
            btnElement.style.background = 'linear-gradient(135deg, #10b981, #34d399)';
            setTimeout(() => {
                btnElement.innerHTML = '<i class="fa-solid fa-pen me-1"></i>Cập nhật';
                btnElement.style.background = 'linear-gradient(135deg, #7b4bef, #9d7cf3)';
            }, 2000);
        } else {
            alert('Lỗi lưu đánh giá!');
            btnElement.innerHTML = isUpdate ? '<i class="fa-solid fa-pen me-1"></i>Cập nhật' : '<i class="fa-solid fa-floppy-disk me-1"></i>Lưu';
        }
    } catch (err) {
        console.error("Lỗi lưu:", err);
        alert('Lỗi kết nối Server!');
        btnElement.innerHTML = isUpdate ? '<i class="fa-solid fa-pen me-1"></i>Cập nhật' : '<i class="fa-solid fa-floppy-disk me-1"></i>Lưu';
    } finally {
        btnElement.disabled = false;
    }
}

// ================================================
// EXAM PAGE LOGIC
// ================================================
let allExams = [];
let _examHeaders = null;
let examCurrentPage = 1;

async function initExamPage() {
    const token = localStorage.getItem('accessToken');
    if (!token) return;

    _examHeaders = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
    };

    // 1. Load danh sách lớp học vào các select
    try {
        const resClass = await fetch('/api/classes', { headers: _examHeaders });
        if (resClass.ok) {
            const data = await resClass.json();
            const classes = Array.isArray(data) ? data : (data.result ? data.result : []);
            [document.getElementById('newExamClassId'), document.getElementById('editExamClassId')].forEach(sel => {
                if (!sel) return;
                sel.innerHTML = '<option value="" disabled selected>Chọn lớp học</option>';
                classes.forEach(cls => {
                    const opt = document.createElement('option');
                    opt.value = cls.id;
                    opt.textContent = cls.name;
                    sel.appendChild(opt);
                });
            });
        }
    } catch (err) {
        console.error('Lỗi load classes cho exam page:', err);
    }

    // 1b. Load danh sách giáo viên vào các select
    try {
        const resTeacher = await fetch('/api/teachers', { headers: _examHeaders });
        if (resTeacher.ok) {
            const data = await resTeacher.json();
            const teachers = Array.isArray(data) ? data : (data.result ? data.result : []);
            [document.getElementById('newExamTeacherId'), document.getElementById('editExamTeacherId')].forEach(sel => {
                if (!sel) return;
                sel.innerHTML = '<option value="" disabled selected>Chọn giáo viên</option>';
                teachers.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.id;
                    opt.textContent = t.name || t.fullName || `GV-${t.id}`;
                    sel.appendChild(opt);
                });
            });
        }
    } catch (err) {
        console.error('Lỗi load teachers cho exam page:', err);
    }

    // 2. Mở modal Tạo mới
    const btnOpenCreate = document.querySelector('.btn-create-exam');
    if (btnOpenCreate) {
        btnOpenCreate.addEventListener('click', () => {
            if (window.bootstrap) {
                const modalEl = document.getElementById('createExamModal');
                const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modal.show();
            }
        });
    }

    // 3. Submit tạo mới
    const btnSubmitCreate = document.getElementById('btnSubmitCreateExam');
    if (btnSubmitCreate) {
        const freshBtn = btnSubmitCreate.cloneNode(true);
        btnSubmitCreate.parentNode.replaceChild(freshBtn, btnSubmitCreate);
        freshBtn.addEventListener('click', async () => {
            const classId = document.getElementById('newExamClassId').value;
            const teacherId = document.getElementById('newExamTeacherId').value;
            const examType = document.getElementById('newExamType').value;
            const examDate = document.getElementById('newExamDate').value;

            if (!classId || !teacherId || !examType || !examDate) {
                alert('Vui lòng chọn lớp học, giáo viên, loại bài kiểm tra và ngày kiểm tra!');
                return;
            }

            // Gửi đúng field name theo CreateExamRequestDTO
            const payload = {
                classId: parseInt(classId),
                teacherId: parseInt(teacherId),
                examType,
                examDate
            };
            try {
                freshBtn.textContent = 'Đang xử lý...';
                freshBtn.disabled = true;
                const res = await fetch('/api/exams', {
                    method: 'POST',
                    headers: _examHeaders,
                    body: JSON.stringify(payload)
                });
                if (res.ok || res.status === 201) {
                    alert('Tạo bài kiểm tra mới thành công!');
                    const modalEl = document.getElementById('createExamModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    document.getElementById('createExamForm').reset();
                    await fetchAndRenderExams();
                } else {
                    const errText = await res.text();
                    console.error('API error:', errText);
                    alert('Có lỗi xảy ra, không thể tạo bài kiểm tra!');
                }
            } catch (err) {
                console.error('Lỗi tạo bài kiểm tra:', err);
                alert('Lỗi kết nối tới Server!');
            } finally {
                freshBtn.textContent = 'Tạo mới';
                freshBtn.disabled = false;
            }
        });
    }

    // 4. Gắn events bộ lọc
    if (!document.getElementById('exam-filter-search')?._examFilterBound) {
        // Class filter gọi lại API server-side
        const classFilterEl = document.getElementById('exam-filter-class');
        if (classFilterEl) {
            classFilterEl._examFilterBound = true;
            classFilterEl.addEventListener('change', async () => {
                examCurrentPage = 1;
                const selectedClassId = classFilterEl.value || null;
                await fetchAndRenderExams(selectedClassId);
            });
        }

        // Các filter còn lại lọc client-side
        const clientFilterIds = ['exam-filter-search', 'exam-filter-teacher',
            'exam-filter-type', 'exam-filter-date-from', 'exam-filter-date-to',
            'exam-filter-sort', 'exam-filter-page-size'];
        clientFilterIds.forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el._examFilterBound = true;
                el.addEventListener('input', () => { examCurrentPage = 1; applyExamFilters(); });
                el.addEventListener('change', () => { examCurrentPage = 1; applyExamFilters(); });
            }
        });

        const btnReset = document.getElementById('exam-btn-reset-filter');
        if (btnReset) {
            btnReset._examFilterBound = true;
            btnReset.addEventListener('click', async () => {
                document.getElementById('exam-filter-class').value = '';
                document.getElementById('exam-filter-search').value = '';
                document.getElementById('exam-filter-teacher').value = '';
                document.getElementById('exam-filter-type').value = '';
                document.getElementById('exam-filter-date-from').value = '';
                document.getElementById('exam-filter-date-to').value = '';
                document.getElementById('exam-filter-sort').value = 'newest';
                document.getElementById('exam-filter-page-size').value = '12';
                examCurrentPage = 1;
                // Reset về tất cả bài kiểm tra
                await fetchAndRenderExams(null);
            });
        }
    }

    // 5. Fetch và render
    await fetchAndRenderExams();
}

async function fetchAndRenderExams(classId = null) {
    const container = document.getElementById('exam-list-container');
    if (!container) return;
    container.innerHTML = `<div class="col-12 text-center py-4 text-muted">Đang tải dữ liệu...</div>`;

    try {
        // Nếu có classId thì dùng endpoint GET /api/exams/class/{classId}
        const url = classId ? `/api/exams/class/${classId}` : '/api/exams';
        const res = await fetch(url, { headers: _examHeaders });
        if (!res.ok) throw new Error('Không thể lấy danh sách bài kiểm tra');
        const data = await res.json();
        allExams = Array.isArray(data) ? data : (data.result ? data.result : []);

        // Đổ options giáo viên động từ dữ liệu hiện tại
        const teacherSelect = document.getElementById('exam-filter-teacher');
        if (teacherSelect) {
            const currentTeacher = teacherSelect.value;
            const uniqueTeachers = [...new Set(allExams.map(e => e.teacherName).filter(Boolean))].sort();
            teacherSelect.innerHTML = '<option value="">Tất cả</option>';
            uniqueTeachers.forEach(t => {
                const opt = document.createElement('option');
                opt.value = t;
                opt.textContent = t;
                teacherSelect.appendChild(opt);
            });
            if (currentTeacher) teacherSelect.value = currentTeacher;
        }

        // Đổ options loại bài kiểm tra động từ dữ liệu hiện tại
        const typeSelect = document.getElementById('exam-filter-type');
        if (typeSelect) {
            const currentType = typeSelect.value;
            const uniqueTypes = [...new Set(allExams.map(e => e.examType).filter(Boolean))].sort();
            typeSelect.innerHTML = '<option value="">Tất cả</option>';
            uniqueTypes.forEach(t => {
                const opt = document.createElement('option');
                opt.value = t;
                opt.textContent = t;
                typeSelect.appendChild(opt);
            });
            if (currentType) typeSelect.value = currentType;
        }

        examCurrentPage = 1;
        applyExamFilters();
    } catch (err) {
        console.error('Lỗi fetch exams:', err);
        if (container) container.innerHTML = `<div class="col-12 text-center py-4 text-danger">Không thể tải danh sách bài kiểm tra.</div>`;
    }
}

function applyExamFilters() {
    const classId = document.getElementById('exam-filter-class')?.value || '';
    const search = (document.getElementById('exam-filter-search')?.value || '').toLowerCase().trim();
    const teacher = document.getElementById('exam-filter-teacher')?.value || '';
    const type = document.getElementById('exam-filter-type')?.value || '';
    const dateFrom = document.getElementById('exam-filter-date-from')?.value || '';
    const dateTo = document.getElementById('exam-filter-date-to')?.value || '';
    const sort = document.getElementById('exam-filter-sort')?.value || 'newest';
    const pageSize = parseInt(document.getElementById('exam-filter-page-size')?.value || '12');

    // 1. Lọc (không lọc theo classId vì đã lọc server-side)
    let filtered = allExams.filter(ex => {
        const matchSearch = !search ||
            (ex.className || '').toLowerCase().includes(search) ||
            (ex.examType || '').toLowerCase().includes(search) ||
            (ex.teacherName || '').toLowerCase().includes(search);
        const matchTeacher = !teacher || (ex.teacherName || '') === teacher;
        const matchType = !type || (ex.examType || '') === type;
        const exDate = ex.examDate ? new Date(ex.examDate) : null;
        const matchDateFrom = !dateFrom || (exDate && exDate >= new Date(dateFrom));
        const matchDateTo = !dateTo || (exDate && exDate <= new Date(dateTo + 'T23:59:59'));
        return matchSearch && matchTeacher && matchType && matchDateFrom && matchDateTo;
    });

    // 2. Sắp xếp
    filtered.sort((a, b) => {
        if (sort === 'newest') return new Date(b.examDate) - new Date(a.examDate);
        if (sort === 'oldest') return new Date(a.examDate) - new Date(b.examDate);
        const nameA = (a.className || '').toLowerCase();
        const nameB = (b.className || '').toLowerCase();
        return sort === 'az' ? nameA.localeCompare(nameB) : nameB.localeCompare(nameA);
    });

    // 3. Phân trang
    const totalItems = filtered.length;
    const totalPages = pageSize >= 9999 ? 1 : Math.ceil(totalItems / pageSize);
    if (examCurrentPage > totalPages) examCurrentPage = Math.max(1, totalPages);
    const startIndex = (examCurrentPage - 1) * pageSize;
    const pageItems = pageSize >= 9999 ? filtered : filtered.slice(startIndex, startIndex + pageSize);

    // 4. Cập nhật text đếm
    const countText = document.getElementById('exam-count-text');
    if (countText) countText.textContent = `Hiển thị ${pageItems.length} / ${totalItems} bài kiểm tra`;

    // 5. Render cards
    const container = document.getElementById('exam-list-container');
    if (!container) return;

    if (pageItems.length === 0) {
        container.innerHTML = `<div class="col-12 text-center py-4 text-muted">Không tìm thấy bài kiểm tra nào phù hợp.</div>`;
    } else {
        container.innerHTML = pageItems.map(ex => {
            const dateStr = ex.examDate
                ? new Date(ex.examDate).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' })
                : 'N/A';
            return `
            <div class="col-md-4 mb-4">
                <div class="card lesson-card-modern h-100 d-flex flex-column">
                    <div class="exam-card-clickable lesson-card-header" data-id="${ex.id}" style="cursor:pointer;" title="Xem chi tiết">
                        <div class="lesson-icon-modern" style="background: linear-gradient(135deg, #8b5cf6, #d946ef);">
                            <i class="fa-solid fa-file-signature"></i>
                        </div>
                        <div class="lesson-header-text">
                            <h5 class="fw-bold mb-1 class-card-title text-truncate" title="${ex.className || 'Không tên'}">${ex.className || 'Không tên'}</h5>
                            <span class="badge lesson-badge-modern" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">${ex.examType || 'N/A'}</span>
                        </div>
                    </div>
                    <div class="exam-card-clickable lesson-card-body flex-grow-1" data-id="${ex.id}" style="cursor:pointer;" title="Xem chi tiết">
                        <div class="lesson-info-row">
                            <div class="icon-bg-light icon-blue">
                                <i class="fa-regular fa-calendar"></i>
                            </div>
                            <div class="lesson-info-text">
                                <span class="info-label">Ngày thi</span>
                                <span class="info-value fw-semibold text-dark">${dateStr}</span>
                            </div>
                        </div>
                        ${ex.teacherName ? `
                        <div class="lesson-info-row mt-3">
                            <div class="icon-bg-light icon-orange">
                                <i class="fa-solid fa-chalkboard-user"></i>
                            </div>
                            <div class="lesson-info-text">
                                <span class="info-label">Giáo viên</span>
                                <span class="info-value fw-semibold text-dark text-truncate" title="${ex.teacherName}">${ex.teacherName}</span>
                            </div>
                        </div>` : ''}
                        ${ex.note ? `
                        <div class="lesson-info-row mt-3">
                            <div class="icon-bg-light" style="background: #f1f5f9; color: #64748b;">
                                <i class="fa-regular fa-note-sticky"></i>
                            </div>
                            <div class="lesson-info-text">
                                <span class="info-label">Ghi chú</span>
                                <span class="info-value fw-semibold text-dark text-truncate" title="${ex.note}">${ex.note}</span>
                            </div>
                        </div>` : ''}
                    </div>
                    <div class="lesson-card-footer d-flex justify-content-between gap-2">
                        <button class="btn flex-grow-1 btn-edit-modern btn-edit-exam" data-id="${ex.id}">
                            <i class="fa-regular fa-pen-to-square me-1"></i> Sửa
                        </button>
                        <button class="btn flex-grow-1 btn-delete-modern btn-delete-exam" data-id="${ex.id}" data-name="${ex.className} - ${ex.examType}">
                            <i class="fa-regular fa-trash-can me-1"></i> Xóa
                        </button>
                    </div>
                </div>
            </div>`;
        }).join('');

        // Gắn sự kiện nút Xóa
        container.querySelectorAll('.btn-delete-exam').forEach(btn => {
            btn.addEventListener('click', () => {
                const examId = btn.getAttribute('data-id');
                const examName = btn.getAttribute('data-name');
                const msgEl = document.getElementById('deleteExamMessage');
                if (msgEl) {
                    msgEl.innerHTML = `Bạn có chắc chắn muốn xóa bài kiểm tra <strong>"${examName}"</strong>?<br>Hành động này không thể hoàn tác.`;
                }
                const deleteModalEl = document.getElementById('deleteExamModal');
                const deleteModal = bootstrap.Modal.getInstance(deleteModalEl) || new bootstrap.Modal(deleteModalEl);
                deleteModal.show();

                const btnConfirm = document.getElementById('btnConfirmDeleteExam');
                const newBtnConfirm = btnConfirm.cloneNode(true);
                btnConfirm.parentNode.replaceChild(newBtnConfirm, btnConfirm);

                newBtnConfirm.addEventListener('click', async () => {
                    try {
                        newBtnConfirm.textContent = 'Đang xóa...';
                        newBtnConfirm.disabled = true;
                        const delRes = await fetch(`/api/exams/${examId}`, { method: 'DELETE', headers: _examHeaders });
                        if (delRes.ok || delRes.status === 204) {
                            deleteModal.hide();
                            await fetchAndRenderExams();
                        } else {
                            alert('Không thể xóa bài kiểm tra. Vui lòng thử lại!');
                        }
                    } catch (err) {
                        console.error('Lỗi xóa bài kiểm tra:', err);
                        alert('Lỗi kết nối tới Server!');
                    } finally {
                        newBtnConfirm.textContent = 'Xóa';
                        newBtnConfirm.disabled = false;
                    }
                });
            });
        });

        // Gắn sự kiện nút Sửa
        container.querySelectorAll('.btn-edit-exam').forEach(btn => {
            btn.addEventListener('click', () => {
                const ex = allExams.find(e => String(e.id) === btn.getAttribute('data-id'));
                if (ex) openEditExamModal(ex);
            });
        });

        // Gắn sự kiện click vào card body để xem chi tiết
        container.querySelectorAll('.exam-card-clickable').forEach(cardBody => {
            cardBody.addEventListener('click', () => {
                const examId = cardBody.getAttribute('data-id');
                const ex = allExams.find(e => String(e.id) === examId);
                if (ex) openExamDetail(ex);
            });
        });
    }

    // 6. Render pagination
    renderExamPagination(totalPages);
}

function renderExamPagination(totalPages) {
    const paginationEl = document.getElementById('exam-pagination-controls');
    if (!paginationEl) return;
    if (totalPages <= 1) { paginationEl.innerHTML = ''; return; }

    const btnStyle = (isActive) =>
        `style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid ${isActive ? 'var(--primary-color)' : '#E0E5F2'};background:${isActive ? 'var(--primary-color)' : 'white'};color:${isActive ? 'white' : '#4a5568'};font-weight:500;font-size:14px;cursor:pointer;transition:all 0.2s ease;"`;

    let html = `<button onclick="changeExamPage(${examCurrentPage - 1})" ${examCurrentPage === 1 ? 'disabled' : ''}
        style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid #E0E5F2;background:white;color:#4a5568;font-weight:500;font-size:14px;cursor:pointer;">‹</button>`;
    for (let i = 1; i <= totalPages; i++) {
        html += `<button onclick="changeExamPage(${i})" ${btnStyle(i === examCurrentPage)}>${i}</button>`;
    }
    html += `<button onclick="changeExamPage(${examCurrentPage + 1})" ${examCurrentPage === totalPages ? 'disabled' : ''}
        style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid #E0E5F2;background:white;color:#4a5568;font-weight:500;font-size:14px;cursor:pointer;">›</button>`;
    paginationEl.innerHTML = html;
}

function changeExamPage(page) {
    const pageSize = parseInt(document.getElementById('exam-filter-page-size')?.value || '12');
    const totalPages = Math.ceil(allExams.length / pageSize);
    if (page < 1 || page > totalPages) return;
    examCurrentPage = page;
    applyExamFilters();
}

async function openEditExamModal(ex) {
    document.getElementById('editExamId').value = ex.id;
    document.getElementById('editExamDate').value = ex.examDate || '';

    // Chọn sẵn loại bài kiểm tra (field: examType)
    const typeSelect = document.getElementById('editExamType');
    if (typeSelect) [...typeSelect.options].forEach(opt => { opt.selected = opt.value === (ex.examType || ''); });

    // Chọn sẵn lớp học
    const classSelect = document.getElementById('editExamClassId');
    if (classSelect) [...classSelect.options].forEach(opt => { opt.selected = String(opt.value) === String(ex.classId); });

    // Chọn sẵn giáo viên
    const teacherSelect = document.getElementById('editExamTeacherId');
    if (teacherSelect) [...teacherSelect.options].forEach(opt => { opt.selected = String(opt.value) === String(ex.teacherId); });

    // Mở modal
    const editModalEl = document.getElementById('editExamModal');
    const editModal = bootstrap.Modal.getInstance(editModalEl) || new bootstrap.Modal(editModalEl);
    editModal.show();

    // Nút Lưu thay đổi
    const btnSubmit = document.getElementById('btnSubmitEditExam');
    const newBtn = btnSubmit.cloneNode(true);
    btnSubmit.parentNode.replaceChild(newBtn, btnSubmit);

    newBtn.addEventListener('click', async () => {
        const classId = document.getElementById('editExamClassId').value;
        const teacherId = document.getElementById('editExamTeacherId').value;
        const examType = document.getElementById('editExamType').value;
        const examDate = document.getElementById('editExamDate').value;
        const examId = document.getElementById('editExamId').value;

        if (!classId || !teacherId || !examType || !examDate) {
            alert('Vui lòng chọn lớp học, giáo viên, loại bài kiểm tra và ngày kiểm tra!');
            return;
        }

        // Gửi đúng field name theo CreateExamRequestDTO
        const payload = {
            classId: parseInt(classId),
            teacherId: parseInt(teacherId),
            examType,
            examDate
        };

        try {
            newBtn.textContent = 'Đang lưu...';
            newBtn.disabled = true;
            const res = await fetch(`/api/exams/${examId}`, {
                method: 'PUT',
                headers: _examHeaders,
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                editModal.hide();
                await fetchAndRenderExams();
            } else {
                const errText = await res.text();
                console.error('API error:', errText);
                alert('Có lỗi xảy ra, không thể cập nhật bài kiểm tra!');
            }
        } catch (err) {
            console.error('Lỗi sửa bài kiểm tra:', err);
            alert('Lỗi kết nối tới Server!');
        } finally {
            newBtn.textContent = 'Lưu thay đổi';
            newBtn.disabled = false;
        }
    });
}

// ================================================
// EXAM DETAIL PAGE
// ================================================
async function openExamDetail(ex) {
    const contentArea = document.querySelector('.dashboard-wrap .main-content');
    if (!contentArea) return;

    const token = localStorage.getItem('accessToken');
    const headers = { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' };

    const dateStr = ex.examDate
        ? new Date(ex.examDate).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' })
        : 'N/A';

    // Render skeleton trang chi tiết
    contentArea.innerHTML = `
    <div class="content" id="exam-detail-page">
        <!-- Toolbar -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <button class="btn px-3 py-2 fw-medium" id="btn-back-to-exams"
                style="border:1.5px solid var(--primary-color);color:var(--primary-color);border-radius:10px;background:#fff;font-size:14px;">
                <i class="fa-solid fa-arrow-left me-2"></i>Quay lại
            </button>
            <div class="d-flex gap-2 flex-wrap">
                <div class="dropdown">
                    <button class="btn px-3 py-2 fw-medium dropdown-toggle" id="btn-export-excel-exam"
                        style="border:1.5px solid #16a34a;color:#16a34a;border-radius:10px;background:#fff;font-size:14px;">
                        <i class="fa-solid fa-file-excel me-2"></i>Xuất Excel
                    </button>
                    <ul class="dropdown-menu" id="export-dropdown-menu">
                        <li><a class="dropdown-item" href="#" id="export-csv-btn"><i class="fa-solid fa-file-csv me-2 text-success"></i>Xuất CSV</a></li>
                        <li><a class="dropdown-item" href="#" id="export-print-btn"><i class="fa-solid fa-print me-2 text-primary"></i>In trang</a></li>
                    </ul>
                </div>
                <button class="btn px-3 py-2 fw-medium btn-edit-exam-detail" data-id="${ex.id}"
                    style="border:1.5px solid #f59e0b;color:#f59e0b;border-radius:10px;background:#fff;font-size:14px;">
                    <i class="fa-regular fa-pen-to-square me-2"></i>Sửa
                </button>
                <button class="btn px-3 py-2 fw-medium btn-delete-exam-detail" data-id="${ex.id}" data-name="${ex.className} - ${ex.examType}"
                    style="border:1.5px solid #e53e3e;color:#e53e3e;border-radius:10px;background:#fff;font-size:14px;">
                    <i class="fa-regular fa-trash-can me-2"></i>Xóa
                </button>
            </div>
        </div>

        <!-- Exam Info Card -->
        <div class="card stat-card-box p-4 mb-4" style="border-radius:16px;">
            <div class="d-flex align-items-center gap-4">
                <div style="width:56px;height:56px;border-radius:14px;background:linear-gradient(135deg,#8b5cf6,#d946ef);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <i class="fa-solid fa-file-signature text-white fs-4"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-1" style="color:#1e293b;font-size:22px;">${ex.className || 'Không tên'} - ${ex.examType || 'N/A'}</h3>
                    <div class="d-flex flex-wrap gap-4 mt-2">
                        <div>
                            <span class="text-muted" style="font-size:12px;font-weight:600;letter-spacing:0.4px;display:block;">Ngày kiểm tra</span>
                            <span class="fw-semibold" style="color:#1e293b;font-size:15px;">${dateStr}</span>
                        </div>
                        <div>
                            <span class="text-muted" style="font-size:12px;font-weight:600;letter-spacing:0.4px;display:block;">Tên giáo viên</span>
                            <span class="fw-semibold" style="color:#1e293b;font-size:15px;">${ex.teacherName || 'N/A'}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Score Table -->
        <div class="mb-2">
            <h5 class="fw-bold mb-1" style="color:#1e293b;">Kết quả kiểm tra</h5>
            <p class="text-muted mb-3" style="font-size:14px;color:#8b5cf6!important;">Danh sách điểm số của học sinh</p>
        </div>
        <div class="card stat-card-box p-0" style="border-radius:16px;overflow:hidden;">
            <div style="overflow-x:auto;">
                <table class="table table-hover mb-0" id="exam-score-table">
                    <thead style="background:#faf5ff;">
                        <tr>
                            <th class="px-4 py-3 fw-semibold text-muted" style="font-size:13px;width:50px;">#</th>
                            <th class="px-3 py-3 fw-semibold text-muted" style="font-size:13px;">Học sinh</th>
                            <th class="px-3 py-3 fw-semibold text-muted text-center" style="font-size:13px;">Speaking</th>
                            <th class="px-3 py-3 fw-semibold text-muted text-center" style="font-size:13px;">Listening</th>
                            <th class="px-3 py-3 fw-semibold text-muted text-center" style="font-size:13px;">Reading & Writing</th>
                            <th class="px-3 py-3 fw-semibold text-muted" style="font-size:13px;">Nhận xét</th>
                            <th class="px-3 py-3 fw-semibold text-muted text-center" style="font-size:13px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="exam-score-tbody">
                        <tr><td colspan="7" class="text-center py-4 text-muted">Đang tải dữ liệu...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>`;

    // Bootstrap dropdown init
    const exportBtn = document.getElementById('btn-export-excel-exam');
    if (exportBtn && window.bootstrap) {
        new bootstrap.Dropdown(exportBtn);
    }

    // Nút Quay lại
    document.getElementById('btn-back-to-exams')?.addEventListener('click', () => {
        // Tái sử dụng hàm loadDashboardContent để fetch html và chạy hàm init một cách chuẩn xác
        loadDashboardContent('exam', initExamPage);
    });

    // Fetch học sinh trong lớp và kết quả điểm
    let students = [];
    let existingScores = {};
    try {
        const [resStudents, resExamDetail] = await Promise.all([
            fetch(`/api/students/class/${ex.classId}`, { headers }),
            fetch(`/api/exams/${ex.id}/results`, { headers }) // Đổi endpoint
        ]);

        if (resStudents.ok) {
            const data = await resStudents.json();
            students = Array.isArray(data) ? data : (data.result || data.data || []);
        }

        if (resExamDetail.ok) {
            const detail = await resExamDetail.json();
            const scores = Array.isArray(detail) ? detail : (detail.results || detail.result || []);
            scores.forEach(s => {
                existingScores[s.studentId] = s;
            });
        }
    } catch (err) {
        console.error('Lỗi tải dữ liệu chi tiết exam:', err);
    }

    // Render bảng điểm
    const tbody = document.getElementById('exam-score-tbody');
    if (!tbody) return;

    if (students.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">Không có học sinh trong lớp này.</td></tr>';
    } else {
        tbody.innerHTML = students.map((st, idx) => {
            const sc = existingScores[st.id] || {};
            // Gắn resultId vào btn nếu đã có điểm
            const resultIdData = sc.id ? `data-result-id="${sc.id}"` : '';
            return `
            <tr>
                <td class="px-4 py-3 text-muted fw-medium">${idx + 1}</td>
                <td class="px-3 py-3 fw-semibold" style="color:#1e293b;">${st.name || st.fullName || 'N/A'}</td>
                <td class="px-3 py-3 text-center">
                    <input type="number" class="form-control form-control-sm text-center score-input" data-student-id="${st.id}" data-field="speaking"
                        value="${sc.speakingScore ?? ''}" min="0" max="10" placeholder="0-10"
                        style="width:80px;margin:auto;border-radius:8px;border-color:rgba(139,92,246,0.3);">
                </td>
                <td class="px-3 py-3 text-center">
                    <input type="number" class="form-control form-control-sm text-center score-input" data-student-id="${st.id}" data-field="listening"
                        value="${sc.listeningScore ?? ''}" min="0" max="10" placeholder="0-10"
                        style="width:80px;margin:auto;border-radius:8px;border-color:rgba(139,92,246,0.3);">
                </td>
                <td class="px-3 py-3 text-center">
                    <input type="number" class="form-control form-control-sm text-center score-input" data-student-id="${st.id}" data-field="readingWriting"
                        value="${sc.readingWritingScore ?? ''}" min="0" max="10" placeholder="0-10"
                        style="width:100px;margin:auto;border-radius:8px;border-color:rgba(139,92,246,0.3);">
                </td>
                <td class="px-3 py-3">
                    <input type="text" class="form-control form-control-sm score-input" data-student-id="${st.id}" data-field="comment"
                        value="${sc.comment || ''}" placeholder="Nhận xét ngắn"
                        style="border-radius:8px;border-color:rgba(139,92,246,0.3);min-width:150px;">
                </td>
                <td class="px-3 py-3 text-center">
                    <button class="btn btn-sm fw-semibold btn-save-score" data-student-id="${st.id}" ${resultIdData}
                        style="background:linear-gradient(135deg,#8b5cf6,#d946ef);color:#fff;border:none;border-radius:8px;padding:6px 18px;">
                        Lưu
                    </button>
                </td>
            </tr>`;
        }).join('');

        // Gắn sự kiện nút Lưu từng dòng
        tbody.querySelectorAll('.btn-save-score').forEach(btn => {
            btn.addEventListener('click', async () => {
                const studentId = btn.getAttribute('data-student-id');
                const resultId = btn.getAttribute('data-result-id');
                const row = btn.closest('tr');
                const speaking = row.querySelector('[data-field="speaking"]')?.value || '';
                const listening = row.querySelector('[data-field="listening"]')?.value || '';
                const readingWriting = row.querySelector('[data-field="readingWriting"]')?.value || '';
                const comment = row.querySelector('[data-field="comment"]')?.value || '';

                const payload = {
                    studentId: parseInt(studentId),
                    examId: ex.id,
                    speakingScore: speaking.toString(),
                    listeningScore: listening.toString(),
                    readingWritingScore: readingWriting.toString(),
                    comment
                };

                try {
                    btn.textContent = '...';
                    btn.disabled = true;
                    let res;
                    if (resultId) {
                        res = await fetch(`/api/exams/results/${resultId}`, {
                            method: 'PUT',
                            headers,
                            body: JSON.stringify(payload)
                        });
                    } else {
                        res = await fetch('/api/exams/results', {
                            method: 'POST',
                            headers,
                            body: JSON.stringify(payload)
                        });
                    }

                    if (res.ok || res.status === 201) {
                        const savedData = await res.json();
                        if (!resultId && savedData && savedData.id) {
                            btn.setAttribute('data-result-id', savedData.id);
                        }
                        btn.textContent = '✓';
                        btn.style.background = 'linear-gradient(135deg,#16a34a,#22c55e)';
                        setTimeout(() => {
                            btn.textContent = 'Lưu';
                            btn.style.background = 'linear-gradient(135deg,#8b5cf6,#d946ef)';
                            btn.disabled = false;
                        }, 1500);
                    } else {
                        alert('Không thể lưu điểm. Vui lòng thử lại!');
                        btn.textContent = 'Lưu';
                        btn.disabled = false;
                    }
                } catch (err) {
                    console.error('Lỗi lưu điểm:', err);
                    alert('Lỗi kết nối tới Server!');
                    btn.textContent = 'Lưu';
                    btn.disabled = false;
                }
            });
        });
    }

    // Xuất CSV
    document.getElementById('export-csv-btn')?.addEventListener('click', (e) => {
        e.preventDefault();
        const rows = [['#', 'Học sinh', 'Speaking', 'Listening', 'Reading & Writing', 'Nhận xét']];
        tbody.querySelectorAll('tr').forEach((tr, idx) => {
            const inputs = tr.querySelectorAll('input');
            if (inputs.length === 0) return;
            const name = tr.querySelector('td:nth-child(2)')?.textContent?.trim() || '';
            const speaking = inputs[0]?.value || '';
            const listening = inputs[1]?.value || '';
            const rw = inputs[2]?.value || '';
            const comment = inputs[3]?.value || '';
            rows.push([idx + 1, name, speaking, listening, rw, comment]);
        });
        const csvContent = '\uFEFF' + rows.map(r => r.map(c => `"${String(c).replace(/"/g, '""')}"`).join(',')).join('\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `KetQua_${ex.className}_${ex.examType}_${ex.examDate || ''}.csv`;
        a.click();
        URL.revokeObjectURL(url);
    });

    // In trang
    document.getElementById('export-print-btn')?.addEventListener('click', (e) => {
        e.preventDefault();
        window.print();
    });

    // Nút Sửa trong trang chi tiết
    document.querySelector('.btn-edit-exam-detail')?.addEventListener('click', async () => {
        // Cần render lại trang exam để có modal sửa
        loadDashboardContent('exam', () => {
            // Mở modal sửa với exam hiện tại sau khi trang được render xong
            setTimeout(() => openEditExamModal(ex), 300);
        });
    });

    // Nút Xóa trong trang chi tiết
    document.querySelector('.btn-delete-exam-detail')?.addEventListener('click', async () => {
        if (!confirm(`Bạn có chắc chắn muốn xóa bài kiểm tra "${ex.className} - ${ex.examType}"?`)) return;
        try {
            const res = await fetch(`/api/exams/${ex.id}`, { method: 'DELETE', headers });
            if (res.ok || res.status === 204) {
                // Quay lại trang danh sách bài kiểm tra
                loadDashboardContent('exam', initExamPage);
            } else {
                alert('Không thể xóa bài kiểm tra. Vui lòng thử lại!');
            }
        } catch (err) {
            console.error('Lỗi xóa bài kiểm tra:', err);
            alert('Lỗi kết nối tới Server!');
        }
    });
}

// ================================================
// USER PAGE LOGIC
// ================================================
let allUsers = [];
let _userHeaders = null;
let userCurrentPage = 1;

const ROLE_LABELS = {
    'OWNER': 'Chủ trung tâm',
    'BRANCH_MANAGER': 'Quản lý chi nhánh',
    'TEACHER': 'Giáo viên',
    'PARENT': 'Phụ huynh'
};
const ROLE_CSS = {
    'OWNER': 'role-admin',
    'BRANCH_MANAGER': 'role-manager',
    'TEACHER': 'role-teacher',
    'PARENT': 'role-parent'
};

async function initUserPage() {
    const token = localStorage.getItem('accessToken');
    if (!token) return;

    _userHeaders = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
    };

    // Load dữ liệu bổ sung cho form
    try {
        const [resBranch, resTeacher, resClass] = await Promise.all([
            fetch('/api/branches', { headers: _userHeaders }),
            fetch('/api/teachers', { headers: _userHeaders }),
            fetch('/api/classes', { headers: _userHeaders })
        ]);

        if (resBranch.ok) {
            const data = await resBranch.json();
            const branches = Array.isArray(data) ? data : (data.result || []);
            ['newUserBranchId', 'editUserBranchId'].forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.innerHTML = '<option value="" disabled selected>Chọn chi nhánh</option>';
                    branches.forEach(b => {
                        const opt = document.createElement('option');
                        opt.value = b.id;
                        opt.textContent = b.name;
                        el.appendChild(opt);
                    });
                }
            });
        }

        if (resTeacher.ok) {
            const data = await resTeacher.json();
            const teachers = Array.isArray(data) ? data : (data.result || []);
            const el = document.getElementById('newUserTeacherId');
            if (el) {
                el.innerHTML = '<option value="">Tạo giáo viên mới</option>';
                teachers.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.id;
                    opt.textContent = t.name || t.fullName || `GV-${t.id}`;
                    el.appendChild(opt);
                });
            }
        }

        if (resClass.ok) {
            const data = await resClass.json();
            const classes = Array.isArray(data) ? data : (data.result || []);
            const el = document.getElementById('newUserClassList');
            if (el) {
                el.innerHTML = '';
                classes.forEach(c => {
                    const idHtml = `user_class_${c.id}`;
                    el.innerHTML += `
                        <div class="form-check mb-2">
                            <input class="form-check-input user-class-checkbox" type="checkbox" value="${c.id}" id="${idHtml}">
                            <label class="form-check-label" for="${idHtml}" style="font-size: 14px; color: #4a5568;">
                                ${c.name}
                            </label>
                        </div>
                    `;
                });
                if (classes.length === 0) el.innerHTML = '<p class="text-muted mb-0" style="font-size: 13px;">Không có lớp học nào.</p>';
            }
        }
    } catch (err) {
        console.error('Lỗi load data cho user form:', err);
    }

    // 1. Nút mở modal Tạo mới
    const btnOpen = document.getElementById('btn-open-create-user');
    if (btnOpen) {
        btnOpen.addEventListener('click', () => {
            const modalEl = document.getElementById('createUserModal');
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();
        });
    }

    // 2. Submit tạo mới
    const btnCreate = document.getElementById('btnSubmitCreateUser');
    if (btnCreate) {
        const freshBtn = btnCreate.cloneNode(true);
        btnCreate.parentNode.replaceChild(freshBtn, btnCreate);
        freshBtn.addEventListener('click', async () => {
            const username = document.getElementById('newUserUsername').value.trim();
            const password = document.getElementById('newUserPassword').value.trim();
            const fullName = document.getElementById('newUserFullName').value.trim();
            const email = document.getElementById('newUserEmail').value.trim();
            const phone = document.getElementById('newUserPhone').value.trim();
            const role = document.getElementById('newUserRole').value;
            const branchId = document.getElementById('newUserBranchId').value;
            const teacherId = document.getElementById('newUserTeacherId').value;
            const isActive = document.getElementById('newUserIsActive').value === 'true';

            // Thu thập danh sách lớp học được check
            const classIds = [];
            document.querySelectorAll('.user-class-checkbox:checked').forEach(cb => {
                classIds.push(parseInt(cb.value));
            });

            if (!username || !password || !role || !branchId) {
                alert('Vui lòng nhập tên đăng nhập, mật khẩu, chọn vai trò và chi nhánh!');
                return;
            }

            const payload = {
                username, password, fullName, email, phone, role, isActive,
                branchId: parseInt(branchId),
                teacherId: teacherId ? parseInt(teacherId) : null,
                classIds: classIds.length > 0 ? classIds : null
            };
            try {
                freshBtn.textContent = 'Đang xử lý...';
                freshBtn.disabled = true;
                const res = await fetch('/api/Users', {
                    method: 'POST',
                    headers: _userHeaders,
                    body: JSON.stringify(payload)
                });
                if (res.ok || res.status === 201) {
                    alert('Tạo người dùng thành công!');
                    const modalEl = document.getElementById('createUserModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    document.getElementById('createUserForm').reset();
                    await fetchAndRenderUsers();
                } else {
                    const errText = await res.text();
                    console.error('API error:', errText);
                    alert('Có lỗi xảy ra, không thể tạo người dùng!');
                }
            } catch (err) {
                console.error('Lỗi tạo người dùng:', err);
                alert('Lỗi kết nối tới Server!');
            } finally {
                freshBtn.textContent = 'Tạo mới';
                freshBtn.disabled = false;
            }
        });
    }

    // 3. Gắn events bộ lọc
    if (!document.getElementById('user-filter-search')?._userFilterBound) {
        ['user-filter-search', 'user-filter-role', 'user-filter-status',
            'user-filter-sort', 'user-filter-page-size'].forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el._userFilterBound = true;
                    el.addEventListener('input', () => { userCurrentPage = 1; applyUserFilters(); });
                    el.addEventListener('change', () => { userCurrentPage = 1; applyUserFilters(); });
                }
            });

        const btnReset = document.getElementById('user-btn-reset-filter');
        if (btnReset) {
            btnReset.addEventListener('click', () => {
                document.getElementById('user-filter-search').value = '';
                document.getElementById('user-filter-role').value = '';
                document.getElementById('user-filter-status').value = '';
                document.getElementById('user-filter-sort').value = 'newest';
                document.getElementById('user-filter-page-size').value = '12';
                userCurrentPage = 1;
                applyUserFilters();
            });
        }
    }

    // 4. Đóng dropdown khi click ra ngoài
    document.addEventListener('click', (e) => {
        if (!e.target.closest('.user-action-menu')) {
            document.querySelectorAll('.user-action-dropdown.show').forEach(d => d.classList.remove('show'));
        }
    });

    // 5. Fetch và render
    await fetchAndRenderUsers();
}

async function fetchAndRenderUsers() {
    const tbody = document.getElementById('user-table-body');
    if (!tbody) return;
    tbody.innerHTML = `<tr><td colspan="8" class="text-center py-5 text-muted">Đang tải dữ liệu...</td></tr>`;

    try {
        const res = await fetch('/api/Users', { headers: _userHeaders });
        if (!res.ok) throw new Error('Không thể lấy danh sách người dùng');
        const data = await res.json();
        allUsers = Array.isArray(data) ? data : (data.result ? data.result : []);
        userCurrentPage = 1;
        applyUserFilters();
    } catch (err) {
        console.error('Lỗi fetch users:', err);
        if (tbody) tbody.innerHTML = `<tr><td colspan="8" class="text-center py-5 text-danger">Không thể tải danh sách người dùng.</td></tr>`;
    }
}

function applyUserFilters() {
    const search = (document.getElementById('user-filter-search')?.value || '').toLowerCase().trim();
    const role = document.getElementById('user-filter-role')?.value || '';
    const status = document.getElementById('user-filter-status')?.value;
    const sort = document.getElementById('user-filter-sort')?.value || 'newest';
    const pageSize = parseInt(document.getElementById('user-filter-page-size')?.value || '12');

    // 1. Lọc
    let filtered = allUsers.filter(u => {
        const matchSearch = !search ||
            (u.username || '').toLowerCase().includes(search) ||
            (u.email || '').toLowerCase().includes(search) ||
            (u.fullName || '').toLowerCase().includes(search);
        const matchRole = !role || (u.role || '') === role;
        const matchStatus = status === '' || status === undefined || status === null
            ? true
            : String(u.isActive) === status;
        return matchSearch && matchRole && matchStatus;
    });

    // 2. Sắp xếp
    filtered.sort((a, b) => {
        if (sort === 'newest') return new Date(b.createdAt || 0) - new Date(a.createdAt || 0);
        if (sort === 'oldest') return new Date(a.createdAt || 0) - new Date(b.createdAt || 0);
        const nameA = (a.username || '').toLowerCase();
        const nameB = (b.username || '').toLowerCase();
        return sort === 'az' ? nameA.localeCompare(nameB) : nameB.localeCompare(nameA);
    });

    // 3. Phân trang
    const totalItems = filtered.length;
    const totalPages = pageSize >= 9999 ? 1 : Math.ceil(totalItems / pageSize);
    if (userCurrentPage > totalPages) userCurrentPage = Math.max(1, totalPages);
    const startIndex = (userCurrentPage - 1) * pageSize;
    const pageItems = pageSize >= 9999 ? filtered : filtered.slice(startIndex, startIndex + pageSize);

    // 4. Cập nhật count
    const countText = document.getElementById('user-count-text');
    if (countText) countText.textContent = `Hiển thị ${pageItems.length} / ${totalItems} người dùng`;

    // 5. Render bảng
    const tbody = document.getElementById('user-table-body');
    if (!tbody) return;

    if (pageItems.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="text-center py-5 text-muted">Không tìm thấy người dùng nào phù hợp.</td></tr>`;
    } else {
        tbody.innerHTML = pageItems.map(u => {
            const dateStr = u.createdAt
                ? new Date(u.createdAt).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' })
                : 'N/A';
            const roleLabel = ROLE_LABELS[u.role] || u.role || 'N/A';
            const roleCss = ROLE_CSS[u.role] || 'role-teacher';
            const statusLabel = u.isActive ? 'Hoạt động' : 'Vô hiệu hóa';
            const statusCss = u.isActive ? 'status-active' : 'status-inactive';
            const toggleAction = u.isActive ? 'deactivate' : 'activate';
            const toggleLabel = u.isActive ? 'Vô hiệu hóa' : 'Kích hoạt';

            return `
            <tr>
                <td class="px-4 fw-medium" style="color: #2c3140;">${u.username || '—'}</td>
                <td class="px-3" style="color: ${u.fullName ? '#2c3140' : '#a0aec0'};">${u.fullName || '—'}</td>
                <td class="px-3" style="color: var(--primary-color);">${u.email || '—'}</td>
                <td class="px-3 text-muted">${u.phone || '—'}</td>
                <td class="px-3"><span class="user-role-badge ${roleCss}">${roleLabel}</span></td>
                <td class="px-3"><span class="user-status-badge ${statusCss}">${statusLabel}</span></td>
                <td class="px-3 text-muted" style="font-size: 13px;">${dateStr}</td>
                <td class="px-3">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-edit-user btn-edit-user-row" data-id="${u.id}">
                            <i class="fa-solid fa-pen-to-square me-1"></i>Sửa
                        </button>
                        <div class="user-action-menu">
                            <button class="btn btn-sm btn-user-more" data-id="${u.id}"
                                style="border: none; background: none; color: #8492a6; font-size: 18px; padding: 2px 6px; line-height:1;">⋮</button>
                            <div class="user-action-dropdown" id="user-dropdown-${u.id}">
                                <button class="user-action-dropdown-item btn-toggle-user" data-id="${u.id}" data-action="${toggleAction}">${toggleLabel}</button>
                                <button class="user-action-dropdown-item btn-reset-pwd" data-id="${u.id}" data-username="${u.username}">
                                    <i class="fa-solid fa-key me-2"></i>Đặt lại mật khẩu
                                </button>
                                <hr style="margin: 4px 0; border-color: #f0f0f5;">
                                <button class="user-action-dropdown-item danger btn-delete-user-row" data-id="${u.id}" data-name="${u.username}">
                                    <i class="fa-solid fa-trash me-2"></i>Xóa
                                </button>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>`;
        }).join('');

        // Gắn nút ⋮ dropdown toggle
        tbody.querySelectorAll('.btn-user-more').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const id = btn.getAttribute('data-id');
                const dropdown = document.getElementById(`user-dropdown-${id}`);
                document.querySelectorAll('.user-action-dropdown.show').forEach(d => {
                    if (d !== dropdown) d.classList.remove('show');
                });
                dropdown.classList.toggle('show');
            });
        });

        // Nút Sửa
        tbody.querySelectorAll('.btn-edit-user-row').forEach(btn => {
            btn.addEventListener('click', () => {
                const u = allUsers.find(x => String(x.id) === btn.getAttribute('data-id'));
                if (u) openEditUserModal(u);
            });
        });

        // Nút Kích hoạt / Vô hiệu hóa
        tbody.querySelectorAll('.btn-toggle-user').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.getAttribute('data-id');
                const action = btn.getAttribute('data-action');
                try {
                    const res = await fetch(`/api/Users/${id}/${action}`, { method: 'POST', headers: _userHeaders });
                    if (res.ok) await fetchAndRenderUsers();
                    else alert('Không thể thực hiện thao tác này!');
                } catch (err) {
                    alert('Lỗi kết nối tới Server!');
                }
            });
        });

        // Nút Đặt lại mật khẩu
        tbody.querySelectorAll('.btn-reset-pwd').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('resetPasswordUserId').value = btn.getAttribute('data-id');
                document.getElementById('resetPasswordUsername').textContent = btn.getAttribute('data-username');
                document.getElementById('newPasswordInput').value = '';
                const modalEl = document.getElementById('resetPasswordModal');
                const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modal.show();

                const btnSubmit = document.getElementById('btnSubmitResetPassword');
                const newBtn = btnSubmit.cloneNode(true);
                btnSubmit.parentNode.replaceChild(newBtn, btnSubmit);
                newBtn.addEventListener('click', async () => {
                    const userId = document.getElementById('resetPasswordUserId').value;
                    const newPwd = document.getElementById('newPasswordInput').value.trim();
                    if (!newPwd) { alert('Vui lòng nhập mật khẩu mới!'); return; }
                    try {
                        newBtn.textContent = 'Đang xử lý...';
                        newBtn.disabled = true;
                        const res = await fetch(`/api/Users/${userId}/reset-password`, {
                            method: 'POST',
                            headers: _userHeaders,
                            body: JSON.stringify({ newPassword: newPwd })
                        });
                        if (res.ok) {
                            alert('Đặt lại mật khẩu thành công!');
                            modal.hide();
                        } else {
                            alert('Có lỗi xảy ra!');
                        }
                    } catch (err) {
                        alert('Lỗi kết nối tới Server!');
                    } finally {
                        newBtn.textContent = 'Xác nhận';
                        newBtn.disabled = false;
                    }
                });
            });
        });

        // Nút Xóa
        tbody.querySelectorAll('.btn-delete-user-row').forEach(btn => {
            btn.addEventListener('click', () => {
                const userId = btn.getAttribute('data-id');
                const username = btn.getAttribute('data-name');
                const msgEl = document.getElementById('deleteUserMessage');
                if (msgEl) msgEl.innerHTML = `Bạn có chắc chắn muốn xóa người dùng <strong>"${username}"</strong>?<br>Hành động này không thể hoàn tác.`;
                const deleteModalEl = document.getElementById('deleteUserModal');
                const deleteModal = bootstrap.Modal.getInstance(deleteModalEl) || new bootstrap.Modal(deleteModalEl);
                deleteModal.show();

                const btnConfirm = document.getElementById('btnConfirmDeleteUser');
                const newConfirm = btnConfirm.cloneNode(true);
                btnConfirm.parentNode.replaceChild(newConfirm, btnConfirm);
                newConfirm.addEventListener('click', async () => {
                    try {
                        newConfirm.textContent = 'Đang xóa...';
                        newConfirm.disabled = true;
                        const res = await fetch(`/api/Users/${userId}`, { method: 'DELETE', headers: _userHeaders });
                        if (res.ok || res.status === 204) {
                            deleteModal.hide();
                            await fetchAndRenderUsers();
                        } else {
                            alert('Không thể xóa người dùng!');
                        }
                    } catch (err) {
                        alert('Lỗi kết nối tới Server!');
                    } finally {
                        newConfirm.textContent = 'Xóa';
                        newConfirm.disabled = false;
                    }
                });
            });
        });
    }

    // 6. Pagination
    renderUserPagination(totalPages);
}

function renderUserPagination(totalPages) {
    const paginationEl = document.getElementById('user-pagination-controls');
    if (!paginationEl) return;
    if (totalPages <= 1) { paginationEl.innerHTML = ''; return; }

    const btnStyle = (isActive) =>
        `style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid ${isActive ? 'var(--primary-color)' : '#E0E5F2'};background:${isActive ? 'var(--primary-color)' : 'white'};color:${isActive ? 'white' : '#4a5568'};font-weight:500;font-size:14px;cursor:pointer;transition:all 0.2s ease;"`;

    let html = `<button onclick="changeUserPage(${userCurrentPage - 1})" ${userCurrentPage === 1 ? 'disabled' : ''}
        style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid #E0E5F2;background:white;color:#4a5568;font-weight:500;font-size:14px;cursor:pointer;">‹</button>`;
    for (let i = 1; i <= totalPages; i++) {
        html += `<button onclick="changeUserPage(${i})" ${btnStyle(i === userCurrentPage)}>${i}</button>`;
    }
    html += `<button onclick="changeUserPage(${userCurrentPage + 1})" ${userCurrentPage === totalPages ? 'disabled' : ''}
        style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid #E0E5F2;background:white;color:#4a5568;font-weight:500;font-size:14px;cursor:pointer;">›</button>`;
    paginationEl.innerHTML = html;
}

function changeUserPage(page) {
    const pageSize = parseInt(document.getElementById('user-filter-page-size')?.value || '12');
    const totalPages = Math.ceil(allUsers.length / pageSize);
    if (page < 1 || page > totalPages) return;
    userCurrentPage = page;
    applyUserFilters();
}

function openEditUserModal(u) {
    document.getElementById('editUserId').value = u.id;
    document.getElementById('editUserUsername').value = u.username || '';
    document.getElementById('editUserFullName').value = u.fullName || '';
    document.getElementById('editUserEmail').value = u.email || '';
    document.getElementById('editUserPhone').value = u.phone || '';

    const roleSelect = document.getElementById('editUserRole');
    if (roleSelect) [...roleSelect.options].forEach(opt => { opt.selected = opt.value === (u.role || ''); });

    const branchSelect = document.getElementById('editUserBranchId');
    if (branchSelect) [...branchSelect.options].forEach(opt => { opt.selected = String(opt.value) === String(u.branchId || ''); });

    const activeSelect = document.getElementById('editUserIsActive');
    if (activeSelect) activeSelect.value = String(u.isActive === true);

    const editModalEl = document.getElementById('editUserModal');
    const editModal = bootstrap.Modal.getInstance(editModalEl) || new bootstrap.Modal(editModalEl);
    editModal.show();

    const btnSubmit = document.getElementById('btnSubmitEditUser');
    const newBtn = btnSubmit.cloneNode(true);
    btnSubmit.parentNode.replaceChild(newBtn, btnSubmit);

    newBtn.addEventListener('click', async () => {
        const userId = document.getElementById('editUserId').value;
        const username = document.getElementById('editUserUsername').value.trim();
        const fullName = document.getElementById('editUserFullName').value.trim();
        const email = document.getElementById('editUserEmail').value.trim();
        const phone = document.getElementById('editUserPhone').value.trim();
        const role = document.getElementById('editUserRole').value;
        const branchId = document.getElementById('editUserBranchId').value;
        const isActive = document.getElementById('editUserIsActive').value === 'true';

        if (!username || !role) {
            alert('Vui lòng nhập tên đăng nhập và chọn vai trò!');
            return;
        }

        const payload = {
            username, fullName, email, phone, role, isActive,
            branchId: branchId ? parseInt(branchId) : null
        };
        try {
            newBtn.textContent = 'Đang lưu...';
            newBtn.disabled = true;
            const res = await fetch(`/api/Users/${userId}`, {
                method: 'PUT',
                headers: _userHeaders,
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                editModal.hide();
                await fetchAndRenderUsers();
            } else {
                const errText = await res.text();
                console.error('API error:', errText);
                alert('Có lỗi xảy ra, không thể cập nhật người dùng!');
            }
        } catch (err) {
            console.error('Lỗi sửa người dùng:', err);
            alert('Lỗi kết nối tới Server!');
        } finally {
            newBtn.textContent = 'Lưu thay đổi';
            newBtn.disabled = false;
        }
    });
}

// ================================================
// PARENT PAGE LOGIC — Gán phụ huynh cho học sinh
// ================================================
let _parentHeaders = null;
let _parentAllStudents = []; // students of selected class
let _parentAllParents = [];  // all users with role PARENT

async function initParentPage() {
    const token = localStorage.getItem('accessToken');
    if (!token) return;

    _parentHeaders = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
    };

    // 1. Load danh sách lớp học
    try {
        const res = await fetch('/api/classes', { headers: _parentHeaders });
        if (res.ok) {
            const data = await res.json();
            const classes = Array.isArray(data) ? data : (data.result || []);
            const sel = document.getElementById('parent-select-class');
            if (sel) {
                sel.innerHTML = '<option value="" disabled selected>-- Chọn lớp học --</option>';
                classes.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.id;
                    opt.textContent = c.name;
                    sel.appendChild(opt);
                });
            }
        }
    } catch (err) { console.error('Lỗi load classes (parent page):', err); }

    // 2. Load danh sách phụ huynh (role = PARENT)
    try {
        const res = await fetch('/api/Users', { headers: _parentHeaders });
        if (res.ok) {
            const data = await res.json();
            const allUsers = Array.isArray(data) ? data : (data.result || []);
            _parentAllParents = allUsers.filter(u => u.role === 'PARENT');
            const sel = document.getElementById('parent-select-parent');
            if (sel) {
                sel.innerHTML = '<option value="">-- Chọn phụ huynh --</option>';
                _parentAllParents.forEach(u => {
                    const opt = document.createElement('option');
                    opt.value = u.id;
                    opt.textContent = `${u.fullName || u.username} ${u.phone ? '— ' + u.phone : ''}`;
                    sel.appendChild(opt);
                });
            }
        }
    } catch (err) { console.error('Lỗi load parents:', err); }

    // 3. Load chi nhánh cho modal Tạo mới PH
    try {
        const res = await fetch('/api/branches', { headers: _parentHeaders });
        if (res.ok) {
            const data = await res.json();
            const branches = Array.isArray(data) ? data : (data.result || []);
            const sel = document.getElementById('newParentBranchId');
            if (sel) {
                sel.innerHTML = '<option value="" disabled selected>Chọn chi nhánh</option>';
                branches.forEach(b => {
                    const opt = document.createElement('option');
                    opt.value = b.id;
                    opt.textContent = b.name;
                    sel.appendChild(opt);
                });
            }
        }
    } catch (err) { console.error('Lỗi load branches (parent modal):', err); }

    // 4. Event: Chọn lớp → load học sinh
    const classSelect = document.getElementById('parent-select-class');
    if (classSelect) {
        classSelect.addEventListener('change', async () => {
            const classId = classSelect.value;
            if (!classId) return;
            await loadStudentsByClass(classId);
        });
    }

    // 5. Event: Tìm kiếm học sinh
    const searchInput = document.getElementById('parent-search-student');
    if (searchInput) {
        searchInput.addEventListener('input', () => {
            renderParentStudentList(_parentAllStudents, searchInput.value);
        });
    }

    // 6. Event: Chọn phụ huynh → hiện info card + load HS đang được gán
    const parentSelect = document.getElementById('parent-select-parent');
    if (parentSelect) {
        parentSelect.addEventListener('change', async () => {
            const parentId = parentSelect.value;
            const infoCard = document.getElementById('parent-info-card');
            const assignedSection = document.getElementById('parent-current-assigned');

            if (!parentId) {
                if (infoCard) infoCard.style.display = 'none';
                if (assignedSection) assignedSection.style.display = 'none';
                return;
            }

            const parent = _parentAllParents.find(u => String(u.id) === String(parentId));
            if (parent && infoCard) {
                document.getElementById('parent-info-name').textContent = parent.fullName || parent.username || '—';
                document.getElementById('parent-info-email').textContent = parent.email || '—';
                document.getElementById('parent-info-phone').textContent = parent.phone ? '📞 ' + parent.phone : '';
                infoCard.style.display = 'block';
                infoCard.style.background = 'rgba(123,75,239,0.05)';
                infoCard.style.border = '1px solid rgba(123,75,239,0.2)';
                infoCard.style.borderRadius = '10px';
                infoCard.style.padding = '12px';
            }

            // Load HS đang được gán cho PH này
            await loadAssignedStudents(parentId);
        });
    }

    // 7. Event: Nút Lưu gán
    const btnAssign = document.getElementById('parent-btn-assign');
    if (btnAssign) {
        btnAssign.addEventListener('click', async () => {
            const parentId = document.getElementById('parent-select-parent').value;
            if (!parentId) { alert('Vui lòng chọn phụ huynh!'); return; }

            const checked = document.querySelectorAll('.parent-student-checkbox:checked');
            if (checked.length === 0) { alert('Vui lòng chọn ít nhất một học sinh!'); return; }

            const studentIds = [...checked].map(cb => parseInt(cb.value));

            try {
                btnAssign.textContent = 'Đang lưu...';
                btnAssign.disabled = true;
                const res = await fetch(`/api/Users/${parentId}/students`, {
                    method: 'POST',
                    headers: _parentHeaders,
                    body: JSON.stringify(studentIds)
                });
                if (res.ok) {
                    alert('Gán phụ huynh thành công!');
                    await loadAssignedStudents(parentId);
                    // Bỏ chọn tất cả
                    document.querySelectorAll('.parent-student-checkbox').forEach(cb => cb.checked = false);
                    updateParentSelectedCount();
                } else {
                    const errText = await res.text();
                    console.error('API error:', errText);
                    alert('Có lỗi xảy ra, không thể gán phụ huynh!');
                }
            } catch (err) {
                console.error('Lỗi gán phụ huynh:', err);
                alert('Lỗi kết nối tới Server!');
            } finally {
                btnAssign.innerHTML = '<i class="fa-solid fa-link me-2"></i>Lưu gán phụ huynh';
                btnAssign.disabled = false;
            }
        });
    }

    // 8. Event: Nút Tạo phụ huynh mới
    const btnOpenCreate = document.getElementById('parent-btn-create-parent');
    if (btnOpenCreate) {
        btnOpenCreate.addEventListener('click', () => {
            const modalEl = document.getElementById('createParentModal');
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();
        });
    }

    // 9. Submit tạo PH mới
    const btnCreate = document.getElementById('btnSubmitCreateParent');
    if (btnCreate) {
        const freshBtn = btnCreate.cloneNode(true);
        btnCreate.parentNode.replaceChild(freshBtn, btnCreate);
        freshBtn.addEventListener('click', async () => {
            const username = document.getElementById('newParentUsername').value.trim();
            const password = document.getElementById('newParentPassword').value.trim();
            const fullName = document.getElementById('newParentFullName').value.trim();
            const email = document.getElementById('newParentEmail').value.trim();
            const phone = document.getElementById('newParentPhone').value.trim();
            const branchId = document.getElementById('newParentBranchId').value;

            if (!username || !password || !branchId) {
                alert('Vui lòng nhập tên đăng nhập, mật khẩu và chọn chi nhánh!');
                return;
            }

            const payload = {
                username, password, fullName, email, phone,
                role: 'PARENT',
                isActive: true,
                branchId: parseInt(branchId)
            };

            try {
                freshBtn.textContent = 'Đang xử lý...';
                freshBtn.disabled = true;
                const res = await fetch('/api/Users', {
                    method: 'POST',
                    headers: _parentHeaders,
                    body: JSON.stringify(payload)
                });
                if (res.ok || res.status === 201) {
                    alert('Tạo phụ huynh mới thành công!');
                    const modalEl = document.getElementById('createParentModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    document.getElementById('createParentForm').reset();
                    // Reload danh sách PH
                    const resU = await fetch('/api/Users', { headers: _parentHeaders });
                    if (resU.ok) {
                        const d = await resU.json();
                        const all = Array.isArray(d) ? d : (d.result || []);
                        _parentAllParents = all.filter(u => u.role === 'PARENT');
                        const sel = document.getElementById('parent-select-parent');
                        if (sel) {
                            sel.innerHTML = '<option value="">-- Chọn phụ huynh --</option>';
                            _parentAllParents.forEach(u => {
                                const opt = document.createElement('option');
                                opt.value = u.id;
                                opt.textContent = `${u.fullName || u.username} ${u.phone ? '— ' + u.phone : ''}`;
                                sel.appendChild(opt);
                            });
                        }
                    }
                } else {
                    const errText = await res.text();
                    console.error('API error:', errText);
                    alert('Có lỗi xảy ra, không thể tạo phụ huynh!');
                }
            } catch (err) {
                console.error('Lỗi tạo PH:', err);
                alert('Lỗi kết nối tới Server!');
            } finally {
                freshBtn.innerHTML = '<i class="fa-solid fa-check me-1"></i>Tạo mới';
                freshBtn.disabled = false;
            }
        });
    }
}

async function loadStudentsByClass(classId) {
    const container = document.getElementById('parent-student-list');
    if (!container) return;
    container.innerHTML = `<div class="text-center py-4 text-muted" style="font-size: 14px;">Đang tải...</div>`;

    try {
        const res = await fetch(`/api/students/class/${classId}`, { headers: _parentHeaders });
        let students = [];
        if (res.ok) {
            const data = await res.json();
            students = Array.isArray(data) ? data : (data.result || []);
        }
        _parentAllStudents = students;
        renderParentStudentList(students, '');
    } catch (err) {
        console.error('Lỗi load students:', err);
        container.innerHTML = `<div class="text-center py-4 text-danger" style="font-size: 14px;">Không thể tải danh sách học sinh.</div>`;
    }
}

function renderParentStudentList(students, search) {
    const container = document.getElementById('parent-student-list');
    if (!container) return;

    const keyword = (search || '').toLowerCase().trim();
    const filtered = keyword
        ? students.filter(s => (s.name || s.fullName || '').toLowerCase().includes(keyword))
        : students;

    if (filtered.length === 0) {
        container.innerHTML = `<div class="text-center py-5 text-muted" style="font-size: 14px;">
            <i class="fa-solid fa-user-slash mb-2" style="font-size: 24px; opacity: 0.3; display: block;"></i>
            ${students.length === 0 ? 'Lớp học này chưa có học sinh nào.' : 'Không tìm thấy học sinh phù hợp.'}
        </div>`;
        return;
    }

    container.innerHTML = filtered.map(s => {
        const dob = s.dob || s.dateOfBirth;
        const dobStr = dob ? new Date(dob).toLocaleDateString('vi-VN') : null;
        const idHtml = `psc_${s.id}`;
        return `
        <label for="${idHtml}" class="parent-student-item d-flex align-items-center p-3 mb-2 rounded-3"
            style="cursor: pointer; border: 1.5px solid #E0E5F2; transition: all 0.15s ease; user-select: none;"
            onmouseover="this.style.borderColor='rgba(123,75,239,0.4)'"
            onmouseout="if(!document.getElementById('${idHtml}').checked) this.style.borderColor='#E0E5F2'">
            <input type="checkbox" class="parent-student-checkbox me-3 d-none" id="${idHtml}" value="${s.id}"
                onchange="parentStudentChecked(this)">
            <div class="parent-checkbox-visual me-3 d-flex align-items-center justify-content-center"
                style="width: 22px; height: 22px; border-radius: 6px; border: 2px solid #E0E5F2;
                       background: white; transition: all 0.15s ease; flex-shrink: 0;">
            </div>
            <div class="me-3 d-flex align-items-center justify-content-center"
                style="width: 38px; height: 38px; border-radius: 10px; background: rgba(123,75,239,0.1);
                       color: #7B4BEF; font-size: 15px; font-weight: 700; flex-shrink: 0;">
                ${(s.name || s.fullName || '?').charAt(0).toUpperCase()}
            </div>
            <div class="flex-grow-1">
                <div class="fw-semibold" style="font-size: 14px; color: #1a202c;">${s.name || s.fullName || '—'}</div>
                ${dobStr ? `<div class="text-muted" style="font-size: 12px;">Sinh ngày: ${dobStr}</div>` : ''}
            </div>
        </label>`;
    }).join('');

    updateParentSelectedCount();
}

function parentStudentChecked(cb) {
    const label = cb.closest('label');
    const visual = label ? label.querySelector('.parent-checkbox-visual') : null;
    if (cb.checked) {
        if (label) {
            label.style.borderColor = '#7B4BEF';
            label.style.background = 'rgba(123,75,239,0.05)';
        }
        if (visual) {
            visual.style.background = '#7B4BEF';
            visual.style.borderColor = '#7B4BEF';
            visual.innerHTML = '<i class="fa-solid fa-check" style="color:white; font-size: 12px;"></i>';
        }
    } else {
        if (label) {
            label.style.borderColor = '#E0E5F2';
            label.style.background = 'white';
        }
        if (visual) {
            visual.style.background = 'white';
            visual.style.borderColor = '#E0E5F2';
            visual.innerHTML = '';
        }
    }
    updateParentSelectedCount();
}

function updateParentSelectedCount() {
    const count = document.querySelectorAll('.parent-student-checkbox:checked').length;
    const info = document.getElementById('parent-assign-info');
    const countEl = document.getElementById('parent-selected-count');
    if (info) info.style.display = count > 0 ? 'block' : 'none';
    if (countEl) countEl.textContent = count;
}

async function loadAssignedStudents(parentId) {
    const section = document.getElementById('parent-current-assigned');
    const listEl = document.getElementById('parent-current-assigned-list');
    if (!section || !listEl) return;

    try {
        const res = await fetch(`/api/Users/${parentId}/students`, { headers: _parentHeaders });
        if (res.ok) {
            const data = await res.json();
            const students = Array.isArray(data) ? data : (data.result || []);
            if (students.length === 0) {
                section.style.display = 'none';
                return;
            }
            section.style.display = 'block';
            listEl.innerHTML = students.map(s => `
                <div class="d-flex align-items-center p-2 mb-1 rounded-2"
                    style="background: rgba(123,75,239,0.05); border: 1px solid rgba(123,75,239,0.1);">
                    <i class="fa-solid fa-circle-check me-2" style="color: #7B4BEF; font-size: 13px;"></i>
                    <span style="font-size: 13px; color: #4a5568;">${s.name || s.fullName || s.studentName || '—'}</span>
                </div>
            `).join('');
        } else {
            section.style.display = 'none';
        }
    } catch (err) {
        console.error('Lỗi load assigned students:', err);
        section.style.display = 'none';
    }
}

// ================================================
// STUDENT PAGE LOGIC
// ================================================
let allStudents = [];
let _studentHeaders = null;
let studentCurrentPage = 1;
let _studentAllClasses = [];

async function initStudentPage() {
    const token = localStorage.getItem('accessToken');
    if (!token) return;

    _studentHeaders = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
    };

    // 1. Load danh sách lớp học vào filter + modal
    try {
        const res = await fetch('/api/classes', { headers: _studentHeaders });
        if (res.ok) {
            const data = await res.json();
            _studentAllClasses = Array.isArray(data) ? data : (data.result || []);

            // Filter dropdown Chọn lớp
            const filterClassEl = document.getElementById('student-filter-class');
            if (filterClassEl) {
                filterClassEl.innerHTML = '<option value="">-- Tất cả lớp --</option>';
                _studentAllClasses.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.id;
                    opt.textContent = c.name;
                    filterClassEl.appendChild(opt);
                });
            }

            // Modal Tạo mới + Sửa
            ['newStudentClassId', 'editStudentClassId'].forEach(elId => {
                const el = document.getElementById(elId);
                if (!el) return;
                const defaultTxt = elId.startsWith('new') ? 'Chọn lớp học' : 'Chọn lớp học';
                el.innerHTML = `<option value="" disabled selected>${defaultTxt}</option>`;
                _studentAllClasses.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.id;
                    opt.textContent = c.name;
                    el.appendChild(opt);
                });
            });

            // Filter Chi nhánh (lấy unique từ danh sách lớp)
            const branchSel = document.getElementById('student-filter-branch');
            if (branchSel) {
                const uniqueBranches = [...new Map(
                    _studentAllClasses
                        .filter(c => c.branchName || c.branch?.name)
                        .map(c => {
                            const id = c.branchId || c.branch?.id || '';
                            const name = c.branchName || c.branch?.name || '';
                            return [id, { id, name }];
                        })
                ).values()];
                branchSel.innerHTML = '<option value="">Tất cả lớp</option>';
                uniqueBranches.forEach(b => {
                    const opt = document.createElement('option');
                    opt.value = b.id;
                    opt.textContent = b.name;
                    branchSel.appendChild(opt);
                });
            }
        }
    } catch (err) { console.error('Lỗi load classes (student page):', err); }

    // 2. Mở modal Tạo mới
    const btnOpen = document.getElementById('btn-open-create-student');
    if (btnOpen) {
        btnOpen.addEventListener('click', () => {
            const modalEl = document.getElementById('createStudentModal');
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();
        });
    }

    // 3. Submit Tạo mới
    const btnCreate = document.getElementById('btnSubmitCreateStudent');
    if (btnCreate) {
        const freshBtn = btnCreate.cloneNode(true);
        btnCreate.parentNode.replaceChild(freshBtn, btnCreate);
        freshBtn.addEventListener('click', async () => {
            const name = document.getElementById('newStudentName').value.trim();
            const dob = document.getElementById('newStudentDob').value;
            const classId = document.getElementById('newStudentClassId').value;
            const parentName = document.getElementById('newStudentParentName').value.trim();
            const parentPhone = document.getElementById('newStudentParentPhone').value.trim();
            const parentEmail = document.getElementById('newStudentParentEmail').value.trim();

            if (!name || !classId) {
                alert('Vui lòng nhập tên học sinh và chọn lớp học!');
                return;
            }

            const payload = {
                name,
                dateOfBirth: dob || null,
                classId: parseInt(classId),
                parentName: parentName || null,
                parentPhone: parentPhone || null,
                parentEmail: parentEmail || null
            };

            try {
                freshBtn.textContent = 'Đang xử lý...';
                freshBtn.disabled = true;
                const res = await fetch('/api/students', {
                    method: 'POST',
                    headers: _studentHeaders,
                    body: JSON.stringify(payload)
                });
                if (res.ok || res.status === 201) {
                    alert('Thêm học sinh thành công!');
                    const modalEl = document.getElementById('createStudentModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    document.getElementById('createStudentForm').reset();
                    await fetchAndRenderStudents();
                } else {
                    const errText = await res.text();
                    console.error('API error:', errText);
                    alert('Có lỗi xảy ra, không thể thêm học sinh!');
                }
            } catch (err) {
                console.error('Lỗi tạo HS:', err);
                alert('Lỗi kết nối tới Server!');
            } finally {
                freshBtn.innerHTML = '<i class="fa-solid fa-plus me-1"></i>Tạo mới';
                freshBtn.disabled = false;
            }
        });
    }

    // 4. Gắn events bộ lọc
    if (!document.getElementById('student-filter-search')?._studentFilterBound) {
        ['student-filter-search', 'student-filter-class', 'student-filter-branch',
            'student-filter-sort', 'student-filter-page-size'].forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el._studentFilterBound = true;
                    el.addEventListener('input', () => { studentCurrentPage = 1; applyStudentFilters(); });
                    el.addEventListener('change', () => { studentCurrentPage = 1; applyStudentFilters(); });
                }
            });

        const btnReset = document.getElementById('student-btn-reset-filter');
        if (btnReset) {
            btnReset.addEventListener('click', () => {
                document.getElementById('student-filter-search').value = '';
                document.getElementById('student-filter-class').value = '';
                document.getElementById('student-filter-branch').value = '';
                document.getElementById('student-filter-sort').value = 'az';
                document.getElementById('student-filter-page-size').value = '12';
                studentCurrentPage = 1;
                applyStudentFilters();
            });
        }
    }

    // 5. Fetch và render
    await fetchAndRenderStudents();
}

async function fetchAndRenderStudents() {
    const container = document.getElementById('student-list-container');
    if (!container) return;
    container.innerHTML = `<div class="col-12 text-center py-5 text-muted">Đang tải dữ liệu...</div>`;

    try {
        const res = await fetch('/api/students', { headers: _studentHeaders });
        if (!res.ok) throw new Error('Không thể lấy danh sách học sinh');
        const data = await res.json();
        allStudents = Array.isArray(data) ? data : (data.result || []);
        studentCurrentPage = 1;
        applyStudentFilters();
    } catch (err) {
        console.error('Lỗi fetch students:', err);
        if (container) container.innerHTML = `<div class="col-12 text-center py-5 text-danger">Không thể tải danh sách học sinh.</div>`;
    }
}

function applyStudentFilters() {
    const search = (document.getElementById('student-filter-search')?.value || '').toLowerCase().trim();
    const classId = document.getElementById('student-filter-class')?.value || '';
    const branchId = document.getElementById('student-filter-branch')?.value || '';
    const sort = document.getElementById('student-filter-sort')?.value || 'az';
    const pageSize = parseInt(document.getElementById('student-filter-page-size')?.value || '12');

    // 1. Lọc
    let filtered = allStudents.filter(s => {
        const matchSearch = !search ||
            (s.name || '').toLowerCase().includes(search) ||
            (s.className || '').toLowerCase().includes(search) ||
            (s.parentName || '').toLowerCase().includes(search) ||
            (s.parentPhone || '').toLowerCase().includes(search);

        const matchClass = !classId || String(s.classId) === String(classId);

        // Lọc chi nhánh: tìm lớp của học sinh rồi check branchId
        let matchBranch = true;
        if (branchId) {
            const cls = _studentAllClasses.find(c => String(c.id) === String(s.classId));
            const cBranchId = cls ? String(cls.branchId || cls.branch?.id || '') : '';
            matchBranch = cBranchId === String(branchId);
        }

        return matchSearch && matchClass && matchBranch;
    });

    // 2. Sắp xếp
    filtered.sort((a, b) => {
        if (sort === 'az') return (a.name || '').localeCompare(b.name || '');
        if (sort === 'za') return (b.name || '').localeCompare(a.name || '');
        if (sort === 'newest') return new Date(b.createdAt || 0) - new Date(a.createdAt || 0);
        if (sort === 'oldest') return new Date(a.createdAt || 0) - new Date(b.createdAt || 0);
        return 0;
    });

    // 3. Phân trang
    const totalItems = filtered.length;
    const totalPages = pageSize >= 9999 ? 1 : Math.ceil(totalItems / pageSize);
    if (studentCurrentPage > totalPages) studentCurrentPage = Math.max(1, totalPages);
    const startIndex = (studentCurrentPage - 1) * pageSize;
    const pageItems = pageSize >= 9999 ? filtered : filtered.slice(startIndex, startIndex + pageSize);

    // 4. Count text
    const countText = document.getElementById('student-count-text');
    if (countText) countText.textContent = `Hiển thị ${pageItems.length} / ${totalItems} học sinh`;

    // 5. Render cards
    const container = document.getElementById('student-list-container');
    if (!container) return;

    if (pageItems.length === 0) {
        container.innerHTML = `<div class="col-12 text-center py-5 text-muted">
            <i class="fa-solid fa-user-slash mb-2" style="font-size:32px; opacity:0.3; display:block;"></i>
            Không tìm thấy học sinh nào phù hợp.
        </div>`;
    } else {
        container.innerHTML = pageItems.map(s => {
            const dob = s.dateOfBirth;
            const dobStr = dob ? new Date(dob + 'T00:00:00').toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }) : null;
            return `
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card lesson-card-modern h-100 d-flex flex-column">
                    <div class="lesson-card-header">
                        <div class="lesson-icon-modern" style="background: linear-gradient(135deg, #0ea5e9, #38bdf8);">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>
                        <div class="lesson-header-text">
                            <h5 class="fw-bold mb-1 class-card-title text-truncate" title="${s.name || '-'}">${s.name || '-'}</h5>
                            <span class="badge lesson-badge-modern" style="background: rgba(14, 165, 233, 0.1); color: #0ea5e9;">Lớp ${s.className || '-'}</span>
                        </div>
                    </div>
                    <div class="lesson-card-body flex-grow-1">
                        ${dobStr ? `
                        <div class="lesson-info-row">
                            <div class="icon-bg-light icon-blue">
                                <i class="fa-regular fa-calendar"></i>
                            </div>
                            <div class="lesson-info-text">
                                <span class="info-label">Ngày sinh</span>
                                <span class="info-value fw-semibold text-dark">${dobStr}</span>
                            </div>
                        </div>` : ''}
                        ${s.parentName ? `
                        <div class="lesson-info-row mt-3">
                            <div class="icon-bg-light icon-orange">
                                <i class="fa-solid fa-user-tie"></i>
                            </div>
                            <div class="lesson-info-text">
                                <span class="info-label">Phụ huynh</span>
                                <span class="info-value fw-semibold text-dark text-truncate" title="${s.parentName}">${s.parentName}</span>
                            </div>
                        </div>` : ''}
                        ${s.parentPhone ? `
                        <div class="lesson-info-row mt-3">
                            <div class="icon-bg-light" style="background: #f1f5f9; color: #64748b;">
                                <i class="fa-solid fa-phone"></i>
                            </div>
                            <div class="lesson-info-text">
                                <span class="info-label">SĐT Phụ huynh</span>
                                <span class="info-value fw-semibold text-dark">${s.parentPhone}</span>
                            </div>
                        </div>` : ''}
                    </div>
                    <div class="lesson-card-footer d-flex justify-content-between gap-2">
                        <button class="btn flex-grow-1 btn-edit-modern btn-edit-student-card" data-id="${s.id}">
                            <i class="fa-regular fa-pen-to-square me-1"></i> Sửa
                        </button>
                        <button class="btn flex-grow-1 btn-delete-modern btn-delete-student-card" data-id="${s.id}" data-name="${s.name}">
                            <i class="fa-regular fa-trash-can me-1"></i> Xóa
                        </button>
                    </div>
                </div>
            </div>`;
        }).join('');

        // Gắn sự kiện nút Sửa
        container.querySelectorAll('.btn-edit-student-card').forEach(btn => {
            btn.addEventListener('click', () => {
                const s = allStudents.find(x => String(x.id) === btn.getAttribute('data-id'));
                if (s) openEditStudentModal(s);
            });
        });

        // Gắn sự kiện nút Xóa
        container.querySelectorAll('.btn-delete-student-card').forEach(btn => {
            btn.addEventListener('click', () => {
                const studentId = btn.getAttribute('data-id');
                const studentName = btn.getAttribute('data-name');
                const msgEl = document.getElementById('deleteStudentMessage');
                if (msgEl) msgEl.innerHTML = `Bạn có chắc chắn muốn xóa học sinh <strong>"${studentName}"</strong>?<br>Hành động này không thể hoàn tác.`;

                const deleteModalEl = document.getElementById('deleteStudentModal');
                const deleteModal = bootstrap.Modal.getInstance(deleteModalEl) || new bootstrap.Modal(deleteModalEl);
                deleteModal.show();

                const btnConfirm = document.getElementById('btnConfirmDeleteStudent');
                const newConfirm = btnConfirm.cloneNode(true);
                btnConfirm.parentNode.replaceChild(newConfirm, btnConfirm);
                newConfirm.addEventListener('click', async () => {
                    try {
                        newConfirm.textContent = 'Đang xóa...';
                        newConfirm.disabled = true;
                        const res = await fetch(`/api/students/${studentId}`, { method: 'DELETE', headers: _studentHeaders });
                        if (res.ok || res.status === 204) {
                            deleteModal.hide();
                            await fetchAndRenderStudents();
                        } else {
                            alert('Không thể xóa học sinh!');
                        }
                    } catch (err) {
                        alert('Lỗi kết nối tới Server!');
                    } finally {
                        newConfirm.textContent = 'Xóa';
                        newConfirm.disabled = false;
                    }
                });
            });
        });
    }

    // 6. Pagination
    renderStudentPagination(totalPages);
}

function openEditStudentModal(s) {
    document.getElementById('editStudentId').value = s.id;
    document.getElementById('editStudentName').value = s.name || '';
    document.getElementById('editStudentDob').value = s.dateOfBirth || '';
    document.getElementById('editStudentParentName').value = s.parentName || '';
    document.getElementById('editStudentParentPhone').value = s.parentPhone || '';
    document.getElementById('editStudentParentEmail').value = s.parentEmail || '';

    const classSelect = document.getElementById('editStudentClassId');
    if (classSelect) {
        [...classSelect.options].forEach(opt => { opt.selected = String(opt.value) === String(s.classId || ''); });
    }

    const editModalEl = document.getElementById('editStudentModal');
    const editModal = bootstrap.Modal.getInstance(editModalEl) || new bootstrap.Modal(editModalEl);
    editModal.show();

    const btnSubmit = document.getElementById('btnSubmitEditStudent');
    const newBtn = btnSubmit.cloneNode(true);
    btnSubmit.parentNode.replaceChild(newBtn, btnSubmit);

    newBtn.addEventListener('click', async () => {
        const studentId = document.getElementById('editStudentId').value;
        const name = document.getElementById('editStudentName').value.trim();
        const dob = document.getElementById('editStudentDob').value;
        const classId = document.getElementById('editStudentClassId').value;
        const parentName = document.getElementById('editStudentParentName').value.trim();
        const parentPhone = document.getElementById('editStudentParentPhone').value.trim();
        const parentEmail = document.getElementById('editStudentParentEmail').value.trim();

        if (!name || !classId) {
            alert('Vui lòng nhập tên học sinh và chọn lớp học!');
            return;
        }

        const payload = {
            name,
            dateOfBirth: dob || null,
            classId: parseInt(classId),
            parentName: parentName || null,
            parentPhone: parentPhone || null,
            parentEmail: parentEmail || null
        };

        try {
            newBtn.textContent = 'Đang lưu...';
            newBtn.disabled = true;
            const res = await fetch(`/api/students/${studentId}`, {
                method: 'PUT',
                headers: _studentHeaders,
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                editModal.hide();
                await fetchAndRenderStudents();
            } else {
                const errText = await res.text();
                console.error('API error:', errText);
                alert('Có lỗi xảy ra, không thể cập nhật học sinh!');
            }
        } catch (err) {
            console.error('Lỗi sửa HS:', err);
            alert('Lỗi kết nối tới Server!');
        } finally {
            newBtn.innerHTML = '<i class="fa-solid fa-check me-1"></i>Lưu thay đổi';
            newBtn.disabled = false;
        }
    });
}

function renderStudentPagination(totalPages) {
    const paginationEl = document.getElementById('student-pagination-controls');
    if (!paginationEl) return;
    if (totalPages <= 1) { paginationEl.innerHTML = ''; return; }

    const btnStyle = (isActive) =>
        `style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid ${isActive ? 'var(--primary-color)' : '#E0E5F2'};background:${isActive ? 'var(--primary-color)' : 'white'};color:${isActive ? 'white' : '#4a5568'};font-weight:500;font-size:14px;cursor:pointer;transition:all 0.2s ease;"`;

    let html = `<button onclick="changeStudentPage(${studentCurrentPage - 1})" ${studentCurrentPage === 1 ? 'disabled' : ''}
        style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid #E0E5F2;background:white;color:#4a5568;font-weight:500;font-size:14px;cursor:pointer;">‹</button>`;
    for (let i = 1; i <= totalPages; i++) {
        html += `<button onclick="changeStudentPage(${i})" ${btnStyle(i === studentCurrentPage)}>${i}</button>`;
    }
    html += `<button onclick="changeStudentPage(${studentCurrentPage + 1})" ${studentCurrentPage === totalPages ? 'disabled' : ''}
        style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid #E0E5F2;background:white;color:#4a5568;font-weight:500;font-size:14px;cursor:pointer;">›</button>`;
    paginationEl.innerHTML = html;
}

function changeStudentPage(page) {
    const pageSize = parseInt(document.getElementById('student-filter-page-size')?.value || '12');
    const totalPages = Math.ceil(allStudents.length / pageSize);
    if (page < 1 || page > totalPages) return;
    studentCurrentPage = page;
    applyStudentFilters();
}

// ================================================
// BRANCH PAGE LOGIC
// ================================================
let allBranches = [];
let _branchHeaders = null;
let branchCurrentPage = 1;

async function initBranchPage() {
    const token = localStorage.getItem('accessToken');
    if (!token) return;

    _branchHeaders = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
    };

    // 1. Mở modal Tạo mới
    const btnOpen = document.getElementById('btn-open-create-branch');
    if (btnOpen) {
        btnOpen.addEventListener('click', () => {
            document.getElementById('createBranchForm').reset();
            const modalEl = document.getElementById('createBranchModal');
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();
        });
    }

    // 2. Submit Tạo mới
    const btnCreate = document.getElementById('btnSubmitCreateBranch');
    if (btnCreate) {
        const freshBtn = btnCreate.cloneNode(true);
        btnCreate.parentNode.replaceChild(freshBtn, btnCreate);
        freshBtn.addEventListener('click', async () => {
            const name = document.getElementById('newBranchName').value.trim();
            const address = document.getElementById('newBranchAddress').value.trim();
            const phone = document.getElementById('newBranchPhone').value.trim();

            if (!name) { alert('Vui lòng nhập tên chi nhánh!'); return; }

            const payload = { name, address: address || null, phone: phone || null };

            try {
                freshBtn.textContent = 'Đang xử lý...';
                freshBtn.disabled = true;
                const res = await fetch('/api/branches', {
                    method: 'POST',
                    headers: _branchHeaders,
                    body: JSON.stringify(payload)
                });
                if (res.ok || res.status === 201) {
                    alert('Tạo chi nhánh mới thành công!');
                    const modal = bootstrap.Modal.getInstance(document.getElementById('createBranchModal'));
                    if (modal) modal.hide();
                    document.getElementById('createBranchForm').reset();
                    await fetchAndRenderBranches();
                } else {
                    const errText = await res.text();
                    console.error('API error:', errText);
                    alert('Có lỗi xảy ra, không thể tạo chi nhánh!');
                }
            } catch (err) {
                console.error('Lỗi tạo chi nhánh:', err);
                alert('Lỗi kết nối tới Server!');
            } finally {
                freshBtn.innerHTML = '<i class="fa-solid fa-plus me-1"></i>Tạo mới';
                freshBtn.disabled = false;
            }
        });
    }

    // 3. Gắn events bộ lọc
    if (!document.getElementById('branch-filter-search')?._branchFilterBound) {
        ['branch-filter-search', 'branch-filter-sort', 'branch-filter-page-size'].forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el._branchFilterBound = true;
                el.addEventListener('input', () => { branchCurrentPage = 1; applyBranchFilters(); });
                el.addEventListener('change', () => { branchCurrentPage = 1; applyBranchFilters(); });
            }
        });

        const btnReset = document.getElementById('branch-btn-reset-filter');
        if (btnReset) {
            btnReset.addEventListener('click', () => {
                document.getElementById('branch-filter-search').value = '';
                document.getElementById('branch-filter-sort').value = 'az';
                document.getElementById('branch-filter-page-size').value = '12';
                branchCurrentPage = 1;
                applyBranchFilters();
            });
        }
    }

    // 4. Fetch và render
    await fetchAndRenderBranches();
}

async function fetchAndRenderBranches() {
    const container = document.getElementById('branch-list-container');
    if (!container) return;
    container.innerHTML = `<div class="col-12 text-center py-5 text-muted">Đang tải dữ liệu...</div>`;

    try {
        const res = await fetch('/api/branches', { headers: _branchHeaders });
        if (!res.ok) throw new Error('Không thể lấy danh sách chi nhánh');
        const data = await res.json();
        allBranches = Array.isArray(data) ? data : (data.result || []);
        branchCurrentPage = 1;
        applyBranchFilters();
    } catch (err) {
        console.error('Lỗi fetch branches:', err);
        if (container) container.innerHTML = `<div class="col-12 text-center py-5 text-danger">Không thể tải danh sách chi nhánh.</div>`;
    }
}

function applyBranchFilters() {
    const search = (document.getElementById('branch-filter-search')?.value || '').toLowerCase().trim();
    const sort = document.getElementById('branch-filter-sort')?.value || 'az';
    const pageSize = parseInt(document.getElementById('branch-filter-page-size')?.value || '12');

    // 1. Lọc
    let filtered = allBranches.filter(b => {
        return !search ||
            (b.name || '').toLowerCase().includes(search) ||
            (b.address || '').toLowerCase().includes(search) ||
            (b.phone || '').toLowerCase().includes(search);
    });

    // 2. Sắp xếp
    filtered.sort((a, b) => {
        if (sort === 'az') return (a.name || '').localeCompare(b.name || '');
        if (sort === 'za') return (b.name || '').localeCompare(a.name || '');
        if (sort === 'newest') return new Date(b.createdAt || 0) - new Date(a.createdAt || 0);
        if (sort === 'oldest') return new Date(a.createdAt || 0) - new Date(b.createdAt || 0);
        return 0;
    });

    // 3. Phân trang
    const totalItems = filtered.length;
    const totalPages = pageSize >= 9999 ? 1 : Math.ceil(totalItems / pageSize);
    if (branchCurrentPage > totalPages) branchCurrentPage = Math.max(1, totalPages);
    const startIndex = (branchCurrentPage - 1) * pageSize;
    const pageItems = pageSize >= 9999 ? filtered : filtered.slice(startIndex, startIndex + pageSize);

    // 4. Count
    const countText = document.getElementById('branch-count-text');
    if (countText) countText.textContent = `Hiển thị ${pageItems.length} / ${totalItems} chi nhánh`;

    // 5. Render cards
    const container = document.getElementById('branch-list-container');
    if (!container) return;

    if (pageItems.length === 0) {
        container.innerHTML = `<div class="col-12 text-center py-5 text-muted">
            <i class="fa-solid fa-building mb-2" style="font-size:36px; opacity:0.25; display:block;"></i>
            Không tìm thấy chi nhánh nào phù hợp.
        </div>`;
    } else {
        container.innerHTML = pageItems.map(b => {
            const createdStr = b.createdAt
                ? new Date(b.createdAt).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' })
                : null;
            return `
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card lesson-card-modern h-100 d-flex flex-column">
                    <div class="lesson-card-header">
                        <div class="lesson-icon-modern" style="background: linear-gradient(135deg, #ec4899, #f472b6);">
                            <i class="fa-regular fa-building"></i>
                        </div>
                        <div class="lesson-header-text">
                            <h5 class="fw-bold mb-1 class-card-title text-truncate" title="${b.name || '-'}">${b.name || '-'}</h5>
                            <span class="badge lesson-badge-modern" style="background: rgba(236, 72, 153, 0.1); color: #ec4899;">Chi nhánh</span>
                        </div>
                    </div>
                    <div class="lesson-card-body flex-grow-1">
                        ${b.address ? `
                        <div class="lesson-info-row">
                            <div class="icon-bg-light icon-blue">
                                <i class="fa-solid fa-location-dot"></i>
                            </div>
                            <div class="lesson-info-text">
                                <span class="info-label">Địa chỉ</span>
                                <span class="info-value fw-semibold text-dark text-truncate" title="${b.address}">${b.address}</span>
                            </div>
                        </div>` : ''}
                        ${b.phone ? `
                        <div class="lesson-info-row mt-3">
                            <div class="icon-bg-light" style="background: #f1f5f9; color: #64748b;">
                                <i class="fa-solid fa-phone"></i>
                            </div>
                            <div class="lesson-info-text">
                                <span class="info-label">Số điện thoại</span>
                                <span class="info-value fw-semibold text-dark">${b.phone}</span>
                            </div>
                        </div>` : ''}
                        ${b.ownerName ? `
                        <div class="lesson-info-row mt-3">
                            <div class="icon-bg-light icon-orange">
                                <i class="fa-solid fa-user-tie"></i>
                            </div>
                            <div class="lesson-info-text">
                                <span class="info-label">Chủ sở hữu</span>
                                <span class="info-value fw-semibold text-dark">${b.ownerName}</span>
                            </div>
                        </div>` : ''}
                        ${createdStr ? `
                        <div class="lesson-info-row mt-3">
                            <div class="icon-bg-light" style="background: #f1f5f9; color: #64748b;">
                                <i class="fa-regular fa-calendar-plus"></i>
                            </div>
                            <div class="lesson-info-text">
                                <span class="info-label">Ngày tạo</span>
                                <span class="info-value fw-semibold text-dark">${createdStr}</span>
                            </div>
                        </div>` : ''}
                    </div>
                    <div class="lesson-card-footer d-flex justify-content-between gap-2">
                        <button class="btn flex-grow-1 btn-edit-modern btn-edit-branch-card" data-id="${b.id}">
                            <i class="fa-regular fa-pen-to-square me-1"></i> Sửa
                        </button>
                        <button class="btn flex-grow-1 btn-delete-modern btn-delete-branch-card" data-id="${b.id}" data-name="${b.name}">
                            <i class="fa-regular fa-trash-can me-1"></i> Xóa
                        </button>
                    </div>
                </div>
            </div>`;
        }).join('');

        // Gắn sự kiện Sửa
        container.querySelectorAll('.btn-edit-branch-card').forEach(btn => {
            btn.addEventListener('click', () => {
                const b = allBranches.find(x => String(x.id) === btn.getAttribute('data-id'));
                if (b) openEditBranchModal(b);
            });
        });

        // Gắn sự kiện Xóa
        container.querySelectorAll('.btn-delete-branch-card').forEach(btn => {
            btn.addEventListener('click', () => {
                const branchId = btn.getAttribute('data-id');
                const branchName = btn.getAttribute('data-name');
                const msgEl = document.getElementById('deleteBranchMessage');
                if (msgEl) msgEl.innerHTML = `Bạn có chắc chắn muốn xóa chi nhánh <strong>"${branchName}"</strong>?<br>Hành động này không thể hoàn tác.`;

                const deleteModalEl = document.getElementById('deleteBranchModal');
                const deleteModal = bootstrap.Modal.getInstance(deleteModalEl) || new bootstrap.Modal(deleteModalEl);
                deleteModal.show();

                const btnConfirm = document.getElementById('btnConfirmDeleteBranch');
                const newConfirm = btnConfirm.cloneNode(true);
                btnConfirm.parentNode.replaceChild(newConfirm, btnConfirm);
                newConfirm.addEventListener('click', async () => {
                    try {
                        newConfirm.textContent = 'Đang xóa...';
                        newConfirm.disabled = true;
                        const res = await fetch(`/api/branches/${branchId}`, { method: 'DELETE', headers: _branchHeaders });
                        if (res.ok || res.status === 204) {
                            deleteModal.hide();
                            await fetchAndRenderBranches();
                        } else {
                            alert('Không thể xóa chi nhánh! Có thể chi nhánh đang được sử dụng.');
                        }
                    } catch (err) {
                        alert('Lỗi kết nối tới Server!');
                    } finally {
                        newConfirm.textContent = 'Xóa';
                        newConfirm.disabled = false;
                    }
                });
            });
        });
    }

    // 6. Pagination
    renderBranchPagination(totalPages);
}

function openEditBranchModal(b) {
    document.getElementById('editBranchId').value = b.id;
    document.getElementById('editBranchName').value = b.name || '';
    document.getElementById('editBranchAddress').value = b.address || '';
    document.getElementById('editBranchPhone').value = b.phone || '';

    const editModalEl = document.getElementById('editBranchModal');
    const editModal = bootstrap.Modal.getInstance(editModalEl) || new bootstrap.Modal(editModalEl);
    editModal.show();

    const btnSubmit = document.getElementById('btnSubmitEditBranch');
    const newBtn = btnSubmit.cloneNode(true);
    btnSubmit.parentNode.replaceChild(newBtn, btnSubmit);

    newBtn.addEventListener('click', async () => {
        const branchId = document.getElementById('editBranchId').value;
        const name = document.getElementById('editBranchName').value.trim();
        const address = document.getElementById('editBranchAddress').value.trim();
        const phone = document.getElementById('editBranchPhone').value.trim();

        if (!name) { alert('Vui lòng nhập tên chi nhánh!'); return; }

        const payload = { name, address: address || null, phone: phone || null };

        try {
            newBtn.textContent = 'Đang lưu...';
            newBtn.disabled = true;
            const res = await fetch(`/api/branches/${branchId}`, {
                method: 'PUT',
                headers: _branchHeaders,
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                editModal.hide();
                await fetchAndRenderBranches();
            } else {
                const errText = await res.text();
                console.error('API error:', errText);
                alert('Có lỗi xảy ra, không thể cập nhật chi nhánh!');
            }
        } catch (err) {
            console.error('Lỗi sửa chi nhánh:', err);
            alert('Lỗi kết nối tới Server!');
        } finally {
            newBtn.innerHTML = '<i class="fa-solid fa-check me-1"></i>Lưu thay đổi';
            newBtn.disabled = false;
        }
    });
}

function renderBranchPagination(totalPages) {
    const paginationEl = document.getElementById('branch-pagination-controls');
    if (!paginationEl) return;
    if (totalPages <= 1) { paginationEl.innerHTML = ''; return; }

    const btnStyle = (isActive) =>
        `style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid ${isActive ? 'var(--primary-color)' : '#E0E5F2'};background:${isActive ? 'var(--primary-color)' : 'white'};color:${isActive ? 'white' : '#4a5568'};font-weight:500;font-size:14px;cursor:pointer;transition:all 0.2s ease;"`;

    let html = `<button onclick="changeBranchPage(${branchCurrentPage - 1})" ${branchCurrentPage === 1 ? 'disabled' : ''}
        style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid #E0E5F2;background:white;color:#4a5568;font-weight:500;font-size:14px;cursor:pointer;">‹</button>`;
    for (let i = 1; i <= totalPages; i++) {
        html += `<button onclick="changeBranchPage(${i})" ${btnStyle(i === branchCurrentPage)}>${i}</button>`;
    }
    html += `<button onclick="changeBranchPage(${branchCurrentPage + 1})" ${branchCurrentPage === totalPages ? 'disabled' : ''}
        style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid #E0E5F2;background:white;color:#4a5568;font-weight:500;font-size:14px;cursor:pointer;">›</button>`;
    paginationEl.innerHTML = html;
}

function changeBranchPage(page) {
    const pageSize = parseInt(document.getElementById('branch-filter-page-size')?.value || '12');
    const totalPages = Math.ceil(allBranches.length / pageSize);
    if (page < 1 || page > totalPages) return;
    branchCurrentPage = page;
    applyBranchFilters();
}

// ================================================
// TEACHER PAGE LOGIC
// ================================================
let allTeachers = [];
let _teacherHeaders = null;
let teacherCurrentPage = 1;
let _teacherBranches = [];

async function initTeacherPage() {
    const token = localStorage.getItem('accessToken');
    if (!token) return;

    _teacherHeaders = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
    };

    // 1. Load chi nhánh vào filter + modal
    try {
        const res = await fetch('/api/branches', { headers: _teacherHeaders });
        if (res.ok) {
            const data = await res.json();
            _teacherBranches = Array.isArray(data) ? data : (data.result || []);

            // Filter dropdown
            const filterBranch = document.getElementById('teacher-filter-branch');
            if (filterBranch) {
                filterBranch.innerHTML = '<option value="">Xem tất cả</option>';
                _teacherBranches.forEach(b => {
                    const opt = document.createElement('option');
                    opt.value = b.id;
                    opt.textContent = b.name;
                    filterBranch.appendChild(opt);
                });
            }

            // Modal Tạo mới + Sửa
            ['newTeacherBranchId', 'editTeacherBranchId'].forEach(elId => {
                const el = document.getElementById(elId);
                if (!el) return;
                el.innerHTML = '<option value="" disabled selected>Chọn chi nhánh</option>';
                _teacherBranches.forEach(b => {
                    const opt = document.createElement('option');
                    opt.value = b.id;
                    opt.textContent = b.name;
                    el.appendChild(opt);
                });
            });
        }
    } catch (err) { console.error('Lỗi load branches (teacher):', err); }

    // 2. Mở modal Tạo mới
    const btnOpen = document.getElementById('btn-open-create-teacher');
    if (btnOpen) {
        btnOpen.addEventListener('click', () => {
            document.getElementById('createTeacherForm').reset();
            const modalEl = document.getElementById('createTeacherModal');
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();
        });
    }

    // 3. Submit Tạo mới
    const btnCreate = document.getElementById('btnSubmitCreateTeacher');
    if (btnCreate) {
        const freshBtn = btnCreate.cloneNode(true);
        btnCreate.parentNode.replaceChild(freshBtn, btnCreate);
        freshBtn.addEventListener('click', async () => {
            const name = document.getElementById('newTeacherName').value.trim();
            const email = document.getElementById('newTeacherEmail').value.trim();
            const phone = document.getElementById('newTeacherPhone').value.trim();
            const branchId = document.getElementById('newTeacherBranchId').value;

            if (!name || !branchId) {
                alert('Vui lòng nhập tên giáo viên và chọn chi nhánh!');
                return;
            }

            const payload = { name, email: email || null, phone: phone || null, branchId: parseInt(branchId) };

            try {
                freshBtn.textContent = 'Đang xử lý...';
                freshBtn.disabled = true;
                const res = await fetch('/api/teachers', {
                    method: 'POST',
                    headers: _teacherHeaders,
                    body: JSON.stringify(payload)
                });
                if (res.ok || res.status === 201) {
                    alert('Thêm giáo viên thành công!');
                    const modal = bootstrap.Modal.getInstance(document.getElementById('createTeacherModal'));
                    if (modal) modal.hide();
                    document.getElementById('createTeacherForm').reset();
                    await fetchAndRenderTeachers();
                } else {
                    const errText = await res.text();
                    console.error('API error:', errText);
                    alert('Có lỗi xảy ra, không thể thêm giáo viên!');
                }
            } catch (err) {
                console.error('Lỗi tạo GV:', err);
                alert('Lỗi kết nối tới Server!');
            } finally {
                freshBtn.innerHTML = '<i class="fa-solid fa-plus me-1"></i>Tạo mới';
                freshBtn.disabled = false;
            }
        });
    }

    // 4. Events bộ lọc
    if (!document.getElementById('teacher-filter-search')?._teacherFilterBound) {
        ['teacher-filter-search', 'teacher-filter-branch', 'teacher-filter-sort', 'teacher-filter-page-size'].forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el._teacherFilterBound = true;
                el.addEventListener('input', () => { teacherCurrentPage = 1; applyTeacherFilters(); });
                el.addEventListener('change', () => { teacherCurrentPage = 1; applyTeacherFilters(); });
            }
        });

        const btnReset = document.getElementById('teacher-btn-reset-filter');
        if (btnReset) {
            btnReset.addEventListener('click', () => {
                document.getElementById('teacher-filter-search').value = '';
                document.getElementById('teacher-filter-branch').value = '';
                document.getElementById('teacher-filter-sort').value = 'az';
                document.getElementById('teacher-filter-page-size').value = '12';
                teacherCurrentPage = 1;
                applyTeacherFilters();
            });
        }
    }

    // 5. Fetch và render
    await fetchAndRenderTeachers();
}

async function fetchAndRenderTeachers() {
    const container = document.getElementById('teacher-list-container');
    if (!container) return;
    container.innerHTML = `<div class="col-12 text-center py-5 text-muted">Đang tải dữ liệu...</div>`;

    try {
        const res = await fetch('/api/teachers', { headers: _teacherHeaders });
        if (!res.ok) throw new Error('API error');
        const data = await res.json();
        allTeachers = Array.isArray(data) ? data : (data.result || []);
        teacherCurrentPage = 1;
        applyTeacherFilters();
    } catch (err) {
        console.error('Lỗi fetch teachers:', err);
        if (container) container.innerHTML = `<div class="col-12 text-center py-5 text-danger">Không thể tải danh sách giáo viên.</div>`;
    }
}

function applyTeacherFilters() {
    const search = (document.getElementById('teacher-filter-search')?.value || '').toLowerCase().trim();
    const branchId = document.getElementById('teacher-filter-branch')?.value || '';
    const sort = document.getElementById('teacher-filter-sort')?.value || 'az';
    const pageSize = parseInt(document.getElementById('teacher-filter-page-size')?.value || '12');

    // Lọc
    let filtered = allTeachers.filter(t => {
        const matchSearch = !search ||
            (t.name || '').toLowerCase().includes(search) ||
            (t.email || '').toLowerCase().includes(search) ||
            (t.phone || '').toLowerCase().includes(search) ||
            (t.branchName || '').toLowerCase().includes(search);
        const matchBranch = !branchId || String(t.branchId) === String(branchId);
        return matchSearch && matchBranch;
    });

    // Sắp xếp
    filtered.sort((a, b) => {
        if (sort === 'az') return (a.name || '').localeCompare(b.name || '');
        if (sort === 'za') return (b.name || '').localeCompare(a.name || '');
        return 0;
    });

    // Phân trang
    const totalItems = filtered.length;
    const totalPages = pageSize >= 9999 ? 1 : Math.ceil(totalItems / pageSize);
    if (teacherCurrentPage > totalPages) teacherCurrentPage = Math.max(1, totalPages);
    const startIndex = (teacherCurrentPage - 1) * pageSize;
    const pageItems = pageSize >= 9999 ? filtered : filtered.slice(startIndex, startIndex + pageSize);

    // Count
    const countText = document.getElementById('teacher-count-text');
    if (countText) countText.textContent = `Hiển thị ${pageItems.length} / ${totalItems} giáo viên`;

    // Render
    const container = document.getElementById('teacher-list-container');
    if (!container) return;

    if (pageItems.length === 0) {
        container.innerHTML = `<div class="col-12 text-center py-5 text-muted">
            <i class="fa-solid fa-chalkboard-user mb-2" style="font-size:36px; opacity:0.25; display:block;"></i>
            Không tìm thấy giáo viên nào phù hợp.
        </div>`;
    } else {
        container.innerHTML = pageItems.map(t => `
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card lesson-card-modern h-100 d-flex flex-column">
                    <div class="lesson-card-header">
                        <div class="lesson-icon-modern" style="background: linear-gradient(135deg, #f59e0b, #fbbf24);">
                            <i class="fa-solid fa-chalkboard-user"></i>
                        </div>
                        <div class="lesson-header-text">
                            <h5 class="fw-bold mb-1 class-card-title text-truncate" title="${t.name || '-'}">${t.name || '-'}</h5>
                            ${t.branchName ? `<span class="badge lesson-badge-modern" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">${t.branchName}</span>` : '<span class="badge lesson-badge-modern" style="background: #f1f5f9; color: #64748b;">Chưa phân bổ</span>'}
                        </div>
                    </div>
                    <div class="lesson-card-body flex-grow-1">
                        ${t.email ? `
                        <div class="lesson-info-row">
                            <div class="icon-bg-light icon-blue">
                                <i class="fa-regular fa-envelope"></i>
                            </div>
                            <div class="lesson-info-text">
                                <span class="info-label">Email</span>
                                <span class="info-value fw-semibold text-dark text-truncate" title="${t.email}">${t.email}</span>
                            </div>
                        </div>` : ''}
                        ${t.phone ? `
                        <div class="lesson-info-row mt-3">
                            <div class="icon-bg-light" style="background: #f1f5f9; color: #64748b;">
                                <i class="fa-solid fa-phone"></i>
                            </div>
                            <div class="lesson-info-text">
                                <span class="info-label">Số điện thoại</span>
                                <span class="info-value fw-semibold text-dark">${t.phone}</span>
                            </div>
                        </div>` : ''}
                    </div>
                    <div class="lesson-card-footer d-flex justify-content-between gap-2">
                        <button class="btn flex-grow-1 btn-edit-modern btn-edit-teacher-card" data-id="${t.id}">
                            <i class="fa-regular fa-pen-to-square me-1"></i> Sửa
                        </button>
                        <button class="btn flex-grow-1 btn-delete-modern btn-delete-teacher-card" data-id="${t.id}" data-name="${t.name}">
                            <i class="fa-regular fa-trash-can me-1"></i> Xóa
                        </button>
                    </div>
                </div>
            </div>`).join('');

        // Sửa
        container.querySelectorAll('.btn-edit-teacher-card').forEach(btn => {
            btn.addEventListener('click', () => {
                const t = allTeachers.find(x => String(x.id) === btn.getAttribute('data-id'));
                if (t) openEditTeacherModal(t);
            });
        });

        // Xóa
        container.querySelectorAll('.btn-delete-teacher-card').forEach(btn => {
            btn.addEventListener('click', () => {
                const teacherId = btn.getAttribute('data-id');
                const teacherName = btn.getAttribute('data-name');
                const msgEl = document.getElementById('deleteTeacherMessage');
                if (msgEl) msgEl.innerHTML = `Bạn có chắc chắn muốn xóa giáo viên <strong>"${teacherName}"</strong>?<br>Hành động này không thể hoàn tác.`;

                const deleteModalEl = document.getElementById('deleteTeacherModal');
                const deleteModal = bootstrap.Modal.getInstance(deleteModalEl) || new bootstrap.Modal(deleteModalEl);
                deleteModal.show();

                const btnConfirm = document.getElementById('btnConfirmDeleteTeacher');
                const newConfirm = btnConfirm.cloneNode(true);
                btnConfirm.parentNode.replaceChild(newConfirm, btnConfirm);
                newConfirm.addEventListener('click', async () => {
                    try {
                        newConfirm.textContent = 'Đang xóa...';
                        newConfirm.disabled = true;
                        const res = await fetch(`/api/teachers/${teacherId}`, { method: 'DELETE', headers: _teacherHeaders });
                        if (res.ok || res.status === 204) {
                            deleteModal.hide();
                            await fetchAndRenderTeachers();
                        } else {
                            alert('Không thể xóa giáo viên! Có thể đang được liên kết với lớp học.');
                        }
                    } catch (err) {
                        alert('Lỗi kết nối tới Server!');
                    } finally {
                        newConfirm.textContent = 'Xóa';
                        newConfirm.disabled = false;
                    }
                });
            });
        });
    }

    renderTeacherPagination(totalPages);
}

function openEditTeacherModal(t) {
    document.getElementById('editTeacherId').value = t.id;
    document.getElementById('editTeacherName').value = t.name || '';
    document.getElementById('editTeacherEmail').value = t.email || '';
    document.getElementById('editTeacherPhone').value = t.phone || '';

    const branchSel = document.getElementById('editTeacherBranchId');
    if (branchSel) {
        [...branchSel.options].forEach(opt => { opt.selected = String(opt.value) === String(t.branchId || ''); });
    }

    const editModalEl = document.getElementById('editTeacherModal');
    const editModal = bootstrap.Modal.getInstance(editModalEl) || new bootstrap.Modal(editModalEl);
    editModal.show();

    const btnSubmit = document.getElementById('btnSubmitEditTeacher');
    const newBtn = btnSubmit.cloneNode(true);
    btnSubmit.parentNode.replaceChild(newBtn, btnSubmit);

    newBtn.addEventListener('click', async () => {
        const teacherId = document.getElementById('editTeacherId').value;
        const name = document.getElementById('editTeacherName').value.trim();
        const email = document.getElementById('editTeacherEmail').value.trim();
        const phone = document.getElementById('editTeacherPhone').value.trim();
        const branchId = document.getElementById('editTeacherBranchId').value;

        if (!name || !branchId) {
            alert('Vui lòng nhập tên giáo viên và chọn chi nhánh!');
            return;
        }

        const payload = { name, email: email || null, phone: phone || null, branchId: parseInt(branchId) };

        try {
            newBtn.textContent = 'Đang lưu...';
            newBtn.disabled = true;
            const res = await fetch(`/api/teachers/${teacherId}`, {
                method: 'PUT',
                headers: _teacherHeaders,
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                editModal.hide();
                await fetchAndRenderTeachers();
            } else {
                const errText = await res.text();
                console.error('API error:', errText);
                alert('Có lỗi xảy ra, không thể cập nhật giáo viên!');
            }
        } catch (err) {
            console.error('Lỗi sửa GV:', err);
            alert('Lỗi kết nối tới Server!');
        } finally {
            newBtn.innerHTML = '<i class="fa-solid fa-check me-1"></i>Lưu thay đổi';
            newBtn.disabled = false;
        }
    });
}

function renderTeacherPagination(totalPages) {
    const paginationEl = document.getElementById('teacher-pagination-controls');
    if (!paginationEl) return;
    if (totalPages <= 1) { paginationEl.innerHTML = ''; return; }

    const btnStyle = (isActive) =>
        `style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid ${isActive ? 'var(--primary-color)' : '#E0E5F2'};background:${isActive ? 'var(--primary-color)' : 'white'};color:${isActive ? 'white' : '#4a5568'};font-weight:500;font-size:14px;cursor:pointer;transition:all 0.2s ease;"`;

    let html = `<button onclick="changeTeacherPage(${teacherCurrentPage - 1})" ${teacherCurrentPage === 1 ? 'disabled' : ''}
        style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid #E0E5F2;background:white;color:#4a5568;font-weight:500;font-size:14px;cursor:pointer;">‹</button>`;
    for (let i = 1; i <= totalPages; i++) {
        html += `<button onclick="changeTeacherPage(${i})" ${btnStyle(i === teacherCurrentPage)}>${i}</button>`;
    }
    html += `<button onclick="changeTeacherPage(${teacherCurrentPage + 1})" ${teacherCurrentPage === totalPages ? 'disabled' : ''}
        style="min-width:34px;height:34px;border-radius:8px;border:1.5px solid #E0E5F2;background:white;color:#4a5568;font-weight:500;font-size:14px;cursor:pointer;">›</button>`;
    paginationEl.innerHTML = html;
}

function changeTeacherPage(page) {
    const pageSize = parseInt(document.getElementById('teacher-filter-page-size')?.value || '12');
    const totalPages = Math.ceil(allTeachers.length / pageSize);
    if (page < 1 || page > totalPages) return;
    teacherCurrentPage = page;
    applyTeacherFilters();
}

// ================================================
// PROFILE PAGE LOGIC
// ================================================
let currentProfileData = null;

async function initProfilePage() {
    const token = localStorage.getItem('accessToken');
    const savedUsername = localStorage.getItem('username') || '';
    const savedRole = localStorage.getItem('userRole') || '';

    if (!token || !savedUsername) {
        alert('Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.');
        window.location.href = '/index.html';
        return;
    }

    const headers = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
    };

    // 1. Gắn thông tin cơ bản lên UI (Tên, Role)
    document.getElementById('profile-display-name').textContent = savedUsername || '—';
    const roleMap = {
        'OWNER': 'Chủ trung tâm',
        'BRANCH_MANAGER': 'Quản lý chi nhánh',
        'TEACHER': 'Giáo viên',
        'PARENT': 'Phụ huynh',
        'ADMIN': 'Quản trị viên'
    };
    document.getElementById('profile-display-role').textContent = roleMap[savedRole.toUpperCase()] || savedRole || '—';
    document.getElementById('profile-username').value = savedUsername;

    // 2. Fetch dữ liệu user từ backend bằng cách lấy danh sách và tìm theo username
    let currentUserId = null;
    try {
        const res = await fetch('/api/Users', { headers });
        if (res.ok) {
            const users = await res.json();
            currentProfileData = users.find(u => u.username === savedUsername);
            if (currentProfileData) {
                currentUserId = currentProfileData.id;
                document.getElementById('profile-fullname').value = currentProfileData.fullName || '';
                document.getElementById('profile-email').value = currentProfileData.email || '';
                document.getElementById('profile-phone').value = currentProfileData.phone || '';
                if (currentProfileData.fullName) {
                    document.getElementById('profile-display-name').textContent = currentProfileData.fullName;
                }
            } else {
                console.error('Không tìm thấy user hiện tại trong danh sách.');
            }
        }
    } catch (error) {
        console.error('Lỗi khi tải thông tin user:', error);
    }

    // 3. Xử lý nút Quay lại
    const btnBack = document.getElementById('profile-btn-back');
    if (btnBack) {
        btnBack.addEventListener('click', () => {
            document.querySelector('.dashboard-wrap .sidebar .nav-item[data-page="dashboard-home"]')?.click();
        });
    }

    // 4. Xử lý Lưu thay đổi
    const btnSave = document.getElementById('profile-btn-save');
    if (btnSave) {
        btnSave.addEventListener('click', async () => {
            if (!currentProfileData || !currentUserId) return;

            const fullName = document.getElementById('profile-fullname').value.trim();
            const email = document.getElementById('profile-email').value.trim();
            const phone = document.getElementById('profile-phone').value.trim();

            const payload = {
                username: currentProfileData.username,
                fullName: fullName,
                email: email,
                phone: phone,
                role: currentProfileData.role,
                isActive: currentProfileData.isActive,
                branchId: currentProfileData.branchId,
                teacherId: currentProfileData.teacherId,
                classIds: currentProfileData.classes ? currentProfileData.classes.map(c => c.id) : []
            };

            try {
                btnSave.textContent = 'Đang lưu...';
                btnSave.disabled = true;
                const res = await fetch(`/api/Users/${currentUserId}`, {
                    method: 'PUT',
                    headers: headers,
                    body: JSON.stringify(payload)
                });

                if (res.ok) {
                    alert('Cập nhật thông tin thành công!');
                    const updatedUser = await res.json();
                    currentProfileData = updatedUser;
                    if (updatedUser.fullName) {
                        document.getElementById('profile-display-name').textContent = updatedUser.fullName;
                    }
                } else {
                    alert('Lỗi cập nhật thông tin!');
                }
            } catch (err) {
                console.error('Lỗi lưu profile:', err);
                alert('Lỗi kết nối tới Server!');
            } finally {
                btnSave.textContent = 'Lưu thay đổi';
                btnSave.disabled = false;
            }
        });
    }

    // 5. Xử lý Đổi mật khẩu
    const btnChangePwdForm = document.getElementById('profile-btn-change-pwd');
    if (btnChangePwdForm) {
        btnChangePwdForm.addEventListener('click', () => {
            loadDashboardContent('change-password', initChangePasswordPage);
        });
    }
}

async function initChangePasswordPage() {
    const token = localStorage.getItem('accessToken');
    const savedUsername = localStorage.getItem('username') || '';

    if (!token || !savedUsername) {
        alert('Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.');
        window.location.href = '/index.html';
        return;
    }

    const headers = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
    };

    const goBackToProfile = () => loadDashboardContent('profile', initProfilePage);

    document.getElementById('change-password-btn-back')?.addEventListener('click', goBackToProfile);
    document.getElementById('change-password-btn-cancel')?.addEventListener('click', goBackToProfile);

    const btnSubmit = document.getElementById('change-password-btn-submit');
    if (!btnSubmit) return;

    btnSubmit.addEventListener('click', async () => {
        const currentPassword = document.getElementById('change-current-password').value.trim();
        const newPassword = document.getElementById('change-new-password').value;
        const confirmPassword = document.getElementById('change-confirm-password').value;

        if (!currentPassword) {
            alert('Vui lòng nhập mật khẩu hiện tại!');
            return;
        }
        if (newPassword.length < 6) {
            alert('Mật khẩu mới phải có ít nhất 6 ký tự!');
            return;
        }
        if (newPassword !== confirmPassword) {
            alert('Mật khẩu xác nhận không khớp!');
            return;
        }

        try {
            btnSubmit.textContent = 'Đang xử lý...';
            btnSubmit.disabled = true;

            let currentUserId = localStorage.getItem('userId');
            if (!currentUserId) {
                const usersRes = await fetch('/api/Users', { headers });
                if (usersRes.ok) {
                    const users = await usersRes.json();
                    const currentUser = users.find(u => u.username === savedUsername);
                    currentUserId = currentUser?.id;
                }
            }

            if (!currentUserId) {
                alert('Không tìm thấy tài khoản hiện tại!');
                return;
            }

            const res = await fetch(`/api/Users/${currentUserId}/reset-password`, {
                method: 'POST',
                headers: headers,
                body: JSON.stringify({ newPassword: newPassword })
            });

            if (res.ok) {
                alert('Đổi mật khẩu thành công!');
                goBackToProfile();
            } else {
                alert('Đổi mật khẩu thất bại!');
            }
        } catch (err) {
            console.error('Lỗi đổi mật khẩu:', err);
            alert('Lỗi kết nối tới Server!');
        } finally {
            btnSubmit.textContent = 'Đổi mật khẩu';
            btnSubmit.disabled = false;
        }
    });
}



// ======================= ENROLLMENT REQUEST LOGIC =======================
async function initEnrollmentRequestPage() {
    const token = localStorage.getItem('accessToken');
    if (!token) return;

    const headers = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
    };

    // ── Fetch stat counts (all statuses) for summary cards ──
    const fetchStatCounts = async () => {
        const statuses = ['PENDING', 'APPROVED', 'REJECTED'];
        const counts = { PENDING: 0, APPROVED: 0, REJECTED: 0, ALL: 0 };
        try {
            await Promise.all(statuses.map(async (s) => {
                const r = await fetch(`/api/admin/enrollment-requests?status=${s}`, { headers });
                if (r.ok) {
                    const d = await r.json();
                    const arr = Array.isArray(d) ? d : (d.result ? d.result : []);
                    counts[s] = arr.length;
                    counts.ALL += arr.length;
                }
            }));
        } catch (_) {}
        const setPending  = document.getElementById('statEnrollPending');
        const setApproved = document.getElementById('statEnrollApproved');
        const setRejected = document.getElementById('statEnrollRejected');
        const setTotal    = document.getElementById('statEnrollTotal');
        if (setPending)  setPending.textContent  = counts.PENDING;
        if (setApproved) setApproved.textContent = counts.APPROVED;
        if (setRejected) setRejected.textContent = counts.REJECTED;
        if (setTotal)    setTotal.textContent    = counts.ALL;
    };

    const fetchAndRenderEnrollments = async () => {
        const status = document.getElementById('enrollmentStatusFilter')?.value || 'PENDING';
        const tbody = document.getElementById('enrollmentTableBody');
        if (!tbody) return;

        tbody.innerHTML = `<tr><td colspan="8">
            <div class="enroll-loading-state">
                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                Đang tải dữ liệu...
            </div>
        </td></tr>`;

        try {
            const res = await fetch(`/api/admin/enrollment-requests?status=${status}`, { headers });
            if (res.ok) {
                const data = await res.json();
                const enrollments = Array.isArray(data) ? data : (data.result ? data.result : []);

                if (enrollments.length === 0) {
                    const emptyLabel = status === 'PENDING' ? 'Không có đơn nào đang chờ duyệt'
                        : status === 'APPROVED' ? 'Chưa có đơn nào được duyệt'
                        : status === 'REJECTED' ? 'Chưa có đơn nào bị từ chối'
                        : 'Không có đơn đăng ký nào';
                    tbody.innerHTML = `<tr><td colspan="8">
                        <div class="enroll-empty-state">
                            <div class="enroll-empty-icon"><i class="fa-solid fa-inbox"></i></div>
                            <div class="enroll-empty-text">${emptyLabel}</div>
                            <div class="enroll-empty-sub">Dữ liệu sẽ xuất hiện khi có đơn mới</div>
                        </div>
                    </td></tr>`;
                    return;
                }

                tbody.innerHTML = '';
                enrollments.forEach(enroll => {
                    const dob = enroll.dateOfBirth
                        ? new Date(enroll.dateOfBirth).toLocaleDateString('vi-VN') : '—';
                    const createdAt = enroll.createdAt
                        ? new Date(enroll.createdAt).toLocaleDateString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }) : '—';

                    let statusBadge = '';
                    if (enroll.status === 'PENDING')
                        statusBadge = '<span class="enroll-badge enroll-badge-pending"><i class="fa-regular fa-clock"></i>Chờ duyệt</span>';
                    else if (enroll.status === 'APPROVED')
                        statusBadge = '<span class="enroll-badge enroll-badge-approved"><i class="fa-solid fa-circle-check"></i>Đã duyệt</span>';
                    else if (enroll.status === 'REJECTED')
                        statusBadge = '<span class="enroll-badge enroll-badge-rejected"><i class="fa-solid fa-circle-xmark"></i>Từ chối</span>';
                    else
                        statusBadge = `<span class="enroll-badge enroll-badge-default">${enroll.status}</span>`;

                    let actionHtml = '';
                    if (enroll.status === 'PENDING') {
                        actionHtml = `
                            <button class="enroll-btn-approve btn-approve-enroll" data-id="${enroll.id}" title="Duyệt đơn này">
                                <i class="fa-solid fa-check"></i> Duyệt
                            </button>
                            <button class="enroll-btn-reject btn-reject-enroll" data-id="${enroll.id}" title="Từ chối đơn này">
                                <i class="fa-solid fa-xmark"></i> Từ chối
                            </button>
                        `;
                    }

                    const row = `
                        <tr>
                            <td>
                                <span class="enroll-id-chip"><i class="fa-solid fa-hashtag" style="font-size:10px;"></i>${enroll.id}</span>
                            </td>
                            <td>
                                <div class="enroll-student-name">${enroll.studentName || '—'}</div>
                                <div class="enroll-student-dob"><i class="fa-regular fa-calendar me-1"></i>${dob}</div>
                            </td>
                            <td>
                                <span class="enroll-class-pill">
                                    <i class="fa-solid fa-book-open" style="font-size:11px;"></i>
                                    ${enroll.className || 'N/A'}
                                </span>
                            </td>
                            <td>
                                <span class="enroll-branch-text">
                                    <i class="fa-regular fa-building me-1" style="color:#94a3b8;"></i>${enroll.branchName || 'N/A'}
                                </span>
                            </td>
                            <td>
                                <div class="enroll-parent-name"><i class="fa-solid fa-user me-1" style="color:#94a3b8;font-size:12px;"></i>${enroll.parentName || 'N/A'}</div>
                                <div class="enroll-parent-phone"><i class="fa-solid fa-phone" style="color:#94a3b8;"></i>${enroll.parentPhone || '—'}</div>
                            </td>
                            <td>${statusBadge}</td>
                            <td><span class="enroll-date-text">${createdAt}</span></td>
                            <td>
                                <div class="d-flex justify-content-end gap-2 flex-wrap">
                                    ${actionHtml}
                                </div>
                            </td>
                        </tr>
                    `;
                    tbody.insertAdjacentHTML('beforeend', row);
                });

                // Approve handler
                document.querySelectorAll('.btn-approve-enroll').forEach(btn => {
                    btn.addEventListener('click', async (e) => {
                        const id = e.currentTarget.getAttribute('data-id');
                        if (confirm(`Bạn có chắc chắn muốn DUYỆT đơn đăng ký #${id}?\nHệ thống sẽ tự động tạo học sinh mới.`)) {
                            const btnEl = e.currentTarget;
                            const origHTML = btnEl.innerHTML;
                            try {
                                btnEl.disabled = true;
                                btnEl.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Đang xử lý...';
                                const r = await fetch(`/api/admin/enrollment-requests/${id}/approve`, { method: 'POST', headers });
                                if (r.ok) {
                                    fetchAndRenderEnrollments();
                                    fetchStatCounts();
                                } else {
                                    const msg = await r.text();
                                    alert('Lỗi duyệt: ' + msg);
                                    btnEl.disabled = false;
                                    btnEl.innerHTML = origHTML;
                                }
                            } catch (err) {
                                alert('Lỗi kết nối server.');
                                btnEl.disabled = false;
                                btnEl.innerHTML = origHTML;
                            }
                        }
                    });
                });

                // Reject handler
                document.querySelectorAll('.btn-reject-enroll').forEach(btn => {
                    btn.addEventListener('click', async (e) => {
                        const id = e.currentTarget.getAttribute('data-id');
                        if (confirm(`Bạn có chắc chắn muốn TỪ CHỐI đơn đăng ký #${id}?`)) {
                            const btnEl = e.currentTarget;
                            const origHTML = btnEl.innerHTML;
                            try {
                                btnEl.disabled = true;
                                btnEl.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Đang xử lý...';
                                const r = await fetch(`/api/admin/enrollment-requests/${id}/reject`, { method: 'POST', headers });
                                if (r.ok) {
                                    fetchAndRenderEnrollments();
                                    fetchStatCounts();
                                } else {
                                    const msg = await r.text();
                                    alert('Lỗi từ chối: ' + msg);
                                    btnEl.disabled = false;
                                    btnEl.innerHTML = origHTML;
                                }
                            } catch (err) {
                                alert('Lỗi kết nối server.');
                                btnEl.disabled = false;
                                btnEl.innerHTML = origHTML;
                            }
                        }
                    });
                });

            } else {
                tbody.innerHTML = `<tr><td colspan="8">
                    <div class="enroll-empty-state">
                        <div class="enroll-empty-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
                        <div class="enroll-empty-text">Không thể tải dữ liệu từ Server</div>
                        <div class="enroll-empty-sub">Vui lòng thử lại sau</div>
                    </div>
                </td></tr>`;
            }
        } catch (err) {
            console.error('Lỗi fetch enrollment requests:', err);
            tbody.innerHTML = `<tr><td colspan="8">
                <div class="enroll-empty-state">
                    <div class="enroll-empty-icon"><i class="fa-solid fa-wifi" style="color:#fca5a5;"></i></div>
                    <div class="enroll-empty-text">Lỗi kết nối tới Server</div>
                    <div class="enroll-empty-sub">Kiểm tra kết nối mạng và thử lại</div>
                </div>
            </td></tr>`;
        }
    };

    // ── Tab filter UI ──
    const tabs = document.querySelectorAll('#enrollStatusTabs .enroll-tab');
    const hiddenSelect = document.getElementById('enrollmentStatusFilter');
    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            tabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            if (hiddenSelect) {
                hiddenSelect.value = tab.dataset.value;
                hiddenSelect.dispatchEvent(new Event('change'));
            }
        });
    });

    document.getElementById('btnRefreshEnrollments')?.addEventListener('click', () => {
        fetchAndRenderEnrollments();
        fetchStatCounts();
    });
    hiddenSelect?.addEventListener('change', fetchAndRenderEnrollments);

    // Initial load
    fetchStatCounts();
    fetchAndRenderEnrollments();
}



// ======================= PARENT ENROLLMENT PAGE =======================
async function initParentEnrollmentPage() {
    const token = localStorage.getItem('accessToken');
    const username = localStorage.getItem('username');
    if (!token || !username) return;

    const headers = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
    };

    const tbody = document.getElementById('parentEnrollmentTableBody');
    if (!tbody) return;

    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">Đang tải dữ liệu...</td></tr>';

    try {
        const res = await fetch(`/api/parent/enrollment-requests?username=${username}`, { headers });
        if (res.ok) {
            const enrollments = await res.json();
            
            if (enrollments.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">Bạn chưa đăng ký khóa học nào.</td></tr>';
                return;
            }

            tbody.innerHTML = '';
            enrollments.forEach(enroll => {
                const createdAt = enroll.createdAt ? new Date(enroll.createdAt).toLocaleString('vi-VN') : 'N/A';
                
                let statusBadge = '';
                if (enroll.status === 'PENDING') statusBadge = '<span class="badge bg-warning text-dark">Đang chờ duyệt</span>';
                else if (enroll.status === 'APPROVED') statusBadge = '<span class="badge bg-success">Đã duyệt (Thành công)</span>';
                else if (enroll.status === 'REJECTED') statusBadge = '<span class="badge bg-danger">Đã bị từ chối</span>';
                else statusBadge = `<span class="badge bg-secondary">${enroll.status}</span>`;

                const priceFmt = enroll.classPrice ? new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(enroll.classPrice) : 'Liên hệ trung tâm';
                const row = `
                    <tr>
                        <td class="ps-4"><strong>#${enroll.id}</strong></td>
                        <td><span class="fw-medium">${enroll.studentName}</span></td>
                        <td><span class="text-primary">${enroll.className || 'N/A'}</span></td>
                        <td>${enroll.branchName || 'N/A'}</td>
                        <td class="text-danger fw-bold">${priceFmt}</td>
                        <td>${statusBadge}</td>
                        <td class="text-muted small">${createdAt}</td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', row);
            });
        } else {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-danger">Không thể tải dữ liệu từ Server.</td></tr>';
        }
    } catch (err) {
        console.error("Lỗi fetch parent enrollment:", err);
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-danger">Lỗi kết nối.</td></tr>';
    }
}

// =============================================
//   TRANG LỢI NHUẬN (Revenue Report)
// =============================================
let _revenueChartPie = null;
let _revenueChartBar = null;

async function initRevenuePage() {
    const token = localStorage.getItem('accessToken');
    if (!token) {
        window.location.href = '/index.html';
        return;
    }
    const headers = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
    };

    const loadingEl    = document.getElementById('revenue-loading');
    const emptyEl      = document.getElementById('revenue-empty');
    const accordionEl  = document.getElementById('revenue-accordion');

    // Gắn sự kiện nút Làm mới
    const btnRefresh = document.getElementById('btnRefreshRevenue');
    if (btnRefresh) btnRefresh.addEventListener('click', initRevenuePage);

    await fetchAndRenderRevenue(headers, loadingEl, emptyEl, accordionEl);
}

async function fetchAndRenderRevenue(headers, loadingEl, emptyEl, accordionEl) {
    if (loadingEl) loadingEl.style.display = 'block';
    if (emptyEl)   emptyEl.style.display   = 'none';
    if (accordionEl) accordionEl.innerHTML  = '';

    try {
        const res = await fetch('/api/reports/revenue', { headers });
        if (!res.ok) throw new Error('API error');
        const data = await res.json();

        const totalRevenue  = data.totalRevenue || 0;
        const branchRevenues = data.branchRevenues || [];
        const fmt = (v) => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(v || 0);

        // --- Overview cards ---
        const statTotal = document.getElementById('stat-total-revenue');
        if (statTotal) statTotal.textContent = fmt(totalRevenue);

        const statBranch = document.getElementById('stat-branch-count');
        if (statBranch) statBranch.textContent = branchRevenues.length;

        let totalStudents = 0;
        branchRevenues.forEach(b => (b.classRevenues || []).forEach(c => { totalStudents += (c.studentCount || 0); }));
        const statStudents = document.getElementById('stat-total-students');
        if (statStudents) statStudents.textContent = totalStudents;

        if (loadingEl) loadingEl.style.display = 'none';

        if (branchRevenues.length === 0) {
            if (emptyEl) emptyEl.style.display = 'block';
            return;
        }

        // --- Render charts ---
        const COLORS = ['#6366f1','#10b981','#f59e0b','#ef4444','#3b82f6','#ec4899','#8b5cf6','#14b8a6'];
        const branchLabels  = branchRevenues.map(b => b.branchName);
        const branchValues  = branchRevenues.map(b => Number(b.totalRevenue || 0));

        // Pie chart
        const pieCtx = document.getElementById('revenueByBranchChart');
        if (pieCtx) {
            if (_revenueChartPie) _revenueChartPie.destroy();
            _revenueChartPie = new Chart(pieCtx, {
                type: 'doughnut',
                data: {
                    labels: branchLabels,
                    datasets: [{ data: branchValues, backgroundColor: COLORS, borderWidth: 2, borderColor: '#fff' }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { font: { size: 12 }, padding: 12 } },
                        tooltip: { callbacks: { label: (ctx) => ` ${fmt(ctx.raw)}` } }
                    },
                    cutout: '60%'
                }
            });
        }

        // Bar chart
        const barCtx = document.getElementById('revenueBarChart');
        if (barCtx) {
            if (_revenueChartBar) _revenueChartBar.destroy();
            _revenueChartBar = new Chart(barCtx, {
                type: 'bar',
                data: {
                    labels: branchLabels,
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: branchValues,
                        backgroundColor: COLORS.slice(0, branchLabels.length),
                        borderRadius: 8,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false }, tooltip: { callbacks: { label: (ctx) => ` ${fmt(ctx.raw)}` } } },
                    scales: {
                        y: { ticks: { callback: (v) => (v >= 1e6 ? (v/1e6).toFixed(0)+'tr' : v), font: { size: 11 } }, grid: { color: '#f1f5f9' } },
                        x: { ticks: { font: { size: 11 } }, grid: { display: false } }
                    }
                }
            });
        }

        // --- Accordion chi tiết từng chi nhánh ---
        branchRevenues.forEach((branch, idx) => {
            const classes = branch.classRevenues || [];
            const branchTotal = Number(branch.totalRevenue || 0);
            const collapseId = `branch-collapse-${idx}`;

            let classRows = '';
            if (classes.length === 0) {
                classRows = `<tr><td colspan="5" class="text-center text-muted py-3 fst-italic">Chi nhánh chưa có lớp học nào</td></tr>`;
            } else {
                classes.forEach(cls => {
                    const priceText = cls.price ? fmt(cls.price) : '<span class="text-muted fst-italic">Chưa đặt</span>';
                    const revenueText = Number(cls.totalRevenue) > 0
                        ? `<span class="fw-bold text-success">${fmt(cls.totalRevenue)}</span>`
                        : '<span class="text-muted">0 ₫</span>';
                    classRows += `
                        <tr>
                            <td class="ps-3">
                                <span class="fw-semibold">${cls.className || '—'}</span>
                                ${cls.level ? `<span class="badge ms-2" style="background:rgba(99,102,241,.1);color:#6366f1;font-size:0.75rem;">Level ${cls.level}</span>` : ''}
                            </td>
                            <td>${priceText}</td>
                            <td class="text-center">
                                <span class="badge" style="background:rgba(245,158,11,.1);color:#f59e0b;font-weight:600;">${cls.studentCount || 0} HS</span>
                            </td>
                            <td>${revenueText}</td>
                        </tr>`;
                });
            }

            const branchCard = `
                <div class="border rounded-3 overflow-hidden" style="border-color:#e2e8f0!important;">
                    <div class="d-flex align-items-center justify-content-between p-3 bg-light" 
                         style="cursor:pointer;" data-bs-toggle="collapse" data-bs-target="#${collapseId}">
                        <div class="d-flex align-items-center gap-3">
                            <div style="width:36px;height:36px;border-radius:10px;background:${COLORS[idx % COLORS.length]};display:flex;align-items:center;justify-content:center;">
                                <i class="fa-regular fa-building text-white" style="font-size:14px;"></i>
                            </div>
                            <div>
                                <div class="fw-bold" style="color:#1e293b;">${branch.branchName || '—'}</div>
                                <div class="text-muted" style="font-size:0.8rem;">${classes.length} lớp học</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div class="fw-bold" style="font-size:1.1rem;color:${COLORS[idx % COLORS.length]};">${fmt(branchTotal)}</div>
                            <i class="fa-solid fa-chevron-down text-muted" style="font-size:12px;transition:.3s;"></i>
                        </div>
                    </div>
                    <div class="collapse" id="${collapseId}">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3" style="font-size:0.82rem;">Tên Lớp</th>
                                        <th style="font-size:0.82rem;">Học Phí</th>
                                        <th class="text-center" style="font-size:0.82rem;">Số HS</th>
                                        <th style="font-size:0.82rem;">Doanh Thu</th>
                                    </tr>
                                </thead>
                                <tbody>${classRows}</tbody>
                                <tfoot>
                                    <tr class="table-light">
                                        <td colspan="3" class="ps-3 fw-bold">Tổng chi nhánh</td>
                                        <td class="fw-bold text-success">${fmt(branchTotal)}</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>`;
            accordionEl.insertAdjacentHTML('beforeend', branchCard);
        });

    } catch (err) {
        console.error('Lỗi fetch revenue:', err);
        if (loadingEl) loadingEl.style.display = 'none';
        if (accordionEl) accordionEl.innerHTML = `<div class="text-center text-danger py-4"><i class="fa-solid fa-circle-exclamation me-2"></i>Lỗi kết nối tới Server!</div>`;
    }
}


// ═══════════════════════════════════════════════════════════════
// PARENT ENROLLMENT PAGE
// ═══════════════════════════════════════════════════════════════

window.initParentEnrollmentPage = function() {
    const token = localStorage.getItem('accessToken');
    const username = localStorage.getItem('username');
    if (!token || !username) return;

    const headers = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
    };

    // Lưu tất cả dữ liệu để filter client-side
    let allEnrollments = [];

    // ── Cập nhật thẻ thống kê từ data ──
    const updateStats = (data) => {
        const counts = { PENDING: 0, APPROVED: 0, REJECTED: 0 };
        data.forEach(e => { if (counts[e.status] !== undefined) counts[e.status]++; });

        const setPending  = document.getElementById('parentStatPending');
        const setApproved = document.getElementById('parentStatApproved');
        const setRejected = document.getElementById('parentStatRejected');
        const setTotal    = document.getElementById('parentStatTotal');

        if (setPending)  setPending.textContent  = counts.PENDING;
        if (setApproved) setApproved.textContent = counts.APPROVED;
        if (setRejected) setRejected.textContent = counts.REJECTED;
        if (setTotal)    setTotal.textContent    = data.length;
    };

    // ── Render bảng từ danh sách ──
    const renderTable = (enrollments) => {
        const tbody = document.getElementById('parentEnrollmentTableBody');
        if (!tbody) return;

        if (enrollments.length === 0) {
            const status = document.getElementById('parentEnrollmentStatusFilter')?.value || 'ALL';
            const emptyLabel = status === 'PENDING' ? 'Không có đơn nào đang chờ duyệt'
                : status === 'APPROVED' ? 'Chưa có đơn nào được duyệt'
                : status === 'REJECTED' ? 'Chưa có đơn nào bị từ chối'
                : 'Bạn chưa có đơn đăng ký nào';
            tbody.innerHTML = `<tr><td colspan="7">
                <div class="parent-enroll-empty-state">
                    <div class="parent-enroll-empty-icon"><i class="fa-solid fa-inbox"></i></div>
                    <div class="parent-enroll-empty-text">${emptyLabel}</div>
                    <div class="parent-enroll-empty-sub">Dữ liệu sẽ xuất hiện khi có đơn mới</div>
                </div>
            </td></tr>`;
            return;
        }

        tbody.innerHTML = '';
        enrollments.forEach(enroll => {
            const dob = enroll.dateOfBirth
                ? new Date(enroll.dateOfBirth).toLocaleDateString('vi-VN') : '—';
            const createdAt = enroll.createdAt
                ? new Date(enroll.createdAt).toLocaleDateString('vi-VN', {
                    day: '2-digit', month: '2-digit', year: 'numeric',
                    hour: '2-digit', minute: '2-digit'
                }) : '—';

            const fee = enroll.classPrice || 0;
            const feeText = fee > 0
                ? new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(fee)
                : '—';

            let statusBadge = '';
            if (enroll.status === 'PENDING')
                statusBadge = '<span class="parent-enroll-badge parent-enroll-badge-pending"><i class="fa-regular fa-clock"></i>Chờ duyệt</span>';
            else if (enroll.status === 'APPROVED')
                statusBadge = '<span class="parent-enroll-badge parent-enroll-badge-approved"><i class="fa-solid fa-circle-check"></i>Đã duyệt</span>';
            else if (enroll.status === 'REJECTED')
                statusBadge = '<span class="parent-enroll-badge parent-enroll-badge-rejected"><i class="fa-solid fa-circle-xmark"></i>Từ chối</span>';
            else
                statusBadge = `<span class="parent-enroll-badge parent-enroll-badge-default">${enroll.status}</span>`;

            tbody.insertAdjacentHTML('beforeend', `
                <tr>
                    <td><span class="parent-enroll-id-chip"><i class="fa-solid fa-hashtag" style="font-size:10px;"></i>${enroll.id}</span></td>
                    <td>
                        <div class="parent-enroll-student-name">${enroll.studentName || '—'}</div>
                        <div class="parent-enroll-student-dob"><i class="fa-regular fa-calendar me-1"></i>${dob}</div>
                    </td>
                    <td><span class="parent-enroll-class-pill"><i class="fa-solid fa-book-open" style="font-size:11px;"></i>${enroll.className || 'N/A'}</span></td>
                    <td><span class="parent-enroll-branch-text"><i class="fa-regular fa-building me-1" style="color:#94a3b8;"></i>${enroll.branchName || 'N/A'}</span></td>
                    <td><span class="parent-enroll-fee-text">${feeText}</span></td>
                    <td>${statusBadge}</td>
                    <td><span class="parent-enroll-date-text">${createdAt}</span></td>
                </tr>
            `);
        });
    };

    // ── Fetch tất cả dữ liệu 1 lần duy nhất ──
    const fetchAllEnrollments = async () => {
        const tbody = document.getElementById('parentEnrollmentTableBody');
        if (!tbody) return;

        tbody.innerHTML = `<tr><td colspan="7">
            <div class="parent-enroll-loading-state">
                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                Đang tải dữ liệu...
            </div>
        </td></tr>`;

        try {
            const res = await fetch(`/api/parent/enrollment-requests?username=${encodeURIComponent(username)}`, { headers });

            if (res.ok) {
                const data = await res.json();
                allEnrollments = Array.isArray(data) ? data : (data.result ? data.result : []);

                // Cập nhật thẻ thống kê
                updateStats(allEnrollments);

                // Render bảng với filter hiện tại
                const currentStatus = document.getElementById('parentEnrollmentStatusFilter')?.value || 'ALL';
                const filtered = currentStatus === 'ALL'
                    ? allEnrollments
                    : allEnrollments.filter(e => e.status === currentStatus);
                renderTable(filtered);

            } else {
                tbody.innerHTML = `<tr><td colspan="7">
                    <div class="parent-enroll-empty-state">
                        <div class="parent-enroll-empty-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
                        <div class="parent-enroll-empty-text">Không thể tải dữ liệu (${res.status})</div>
                        <div class="parent-enroll-empty-sub">Vui lòng thử lại sau</div>
                    </div>
                </td></tr>`;
            }
        } catch (err) {
            console.error('Error fetching parent enrollments:', err);
            tbody.innerHTML = `<tr><td colspan="7">
                <div class="parent-enroll-empty-state">
                    <div class="parent-enroll-empty-icon"><i class="fa-solid fa-wifi" style="color:#fca5a5;"></i></div>
                    <div class="parent-enroll-empty-text">Lỗi kết nối tới Server</div>
                    <div class="parent-enroll-empty-sub">Kiểm tra kết nối mạng và thử lại</div>
                </div>
            </td></tr>`;
        }
    };

    // ── Tab filter (client-side, không fetch lại) ──
    const tabs = document.querySelectorAll('#parentEnrollStatusTabs .parent-enroll-tab');
    const hiddenSelect = document.getElementById('parentEnrollmentStatusFilter');
    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            tabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            const status = tab.getAttribute('data-status');
            if (hiddenSelect) hiddenSelect.value = status;

            // Filter client-side, không gọi API lại
            const filtered = status === 'ALL'
                ? allEnrollments
                : allEnrollments.filter(e => e.status === status);
            renderTable(filtered);
        });
    });

    // ── Nút làm mới ──
    const refreshBtn = document.querySelector('.parent-enroll-refresh-btn');
    if (refreshBtn) {
        refreshBtn.addEventListener('click', fetchAllEnrollments);
    }

    // ── Load lần đầu ──
    fetchAllEnrollments();
};

